---
import BaseLayout from '../layouts/BaseLayout.astro';
import ForkfolioTheme from '../components/themes/ForkfolioTheme.astro';
import EditorialTheme from '../components/themes/EditorialTheme.astro';
import ProjectModal from '../components/dashboard/ProjectModal.astro';
import CvModal from '../components/dashboard/CvModal.astro';
import { portfolioData } from '../data/portfolio';

const initialTheme = portfolioData.identity?.themeVariant || 'forkfolio';
---

<BaseLayout title="Nguyễn Thanh Quân — DevOps & Infrastructure Engineer" currentPath="/">
  <main class="flex-grow" id="main-content">
    <!-- Theme 1: Forkfolio Modern Mono (Bright, minimalist developer theme) -->
    <div id="theme-forkfolio-wrapper" class={initialTheme === 'forkfolio' ? 'block' : 'hidden'}>
      <ForkfolioTheme />
    </div>

    <!-- Theme 2: DevOps Editorial (3D Book-open timeline, Jenkins pipeline & interactive terminal) -->
    <div id="theme-editorial-wrapper" class={initialTheme === 'editorial' ? 'block' : 'hidden'}>
      <EditorialTheme />
    </div>
  </main>

  <ProjectModal />
  <CvModal />
</BaseLayout>

<script>
  // 1. Reveal sections & editorial headings on scroll
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.add('is-visible');
          io.unobserve(en.target);
        }
      }),
    { threshold: 0.08, rootMargin: '0px 0px -30px 0px' },
  );

  function observeReveals() {
    document.querySelectorAll('.reveal:not(.is-visible), .reveal-wipe:not(.is-visible)').forEach((el) => io.observe(el));
  }
  observeReveals();

  // 2. Timeline progress line & 3D Book-Opening Scroll Effect ("mở sách" in Editorial theme)
  const journeyTimeline = document.getElementById('journey-timeline');
  const journeyProgressBar = document.getElementById('journey-progress-bar');

  function onExperienceScroll() {
    const vh = window.innerHeight || document.documentElement.clientHeight;

    // Center spine green progress fill
    if (journeyTimeline && journeyProgressBar) {
      const rect = journeyTimeline.getBoundingClientRect();
      const start = vh * 0.72;
      const end = vh * 0.25;
      const total = rect.height + (start - end);
      const current = start - rect.top;
      const ratio = Math.max(0, Math.min(1, current / total));
      journeyProgressBar.style.transform = `translateX(-50%) scaleY(${ratio.toFixed(3)})`;
    }

    // Book-opening 3D unfold per row based on scroll position
    const bookRows = document.querySelectorAll<HTMLElement>('.timeline-book-row');
    bookRows.forEach((row) => {
      const r = row.getBoundingClientRect();
      const rowCenter = r.top + r.height * 0.35;
      const enterY = vh * 0.94;
      const flatY = vh * 0.56;
      const raw = (enterY - rowCenter) / (enterY - flatY);
      const p = Math.max(0, Math.min(1, raw));
      const eased = 1 - Math.pow(1 - p, 2.6);

      const leftPage = row.querySelector<HTMLElement>('.book-page-left');
      const rightPage = row.querySelector<HTMLElement>('.book-page-right');
      const dotNode = row.querySelector<HTMLElement>('.timeline-dot-node');

      const maxAngle = 76;
      const angle = (1 - eased) * maxAngle;
      const tiltX = (1 - eased) * 6;
      const scale = 0.92 + eased * 0.08;
      const opacity = 0.12 + eased * 0.88;
      const spineShadow = ((1 - eased) * 0.85).toFixed(3);

      if (leftPage) {
        leftPage.style.transform = `rotateY(${-angle.toFixed(2)}deg) rotateX(${tiltX.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
        leftPage.style.opacity = opacity.toFixed(3);
        leftPage.style.setProperty('--spine-shadow', spineShadow);
      }
      if (rightPage) {
        rightPage.style.transform = `rotateY(${angle.toFixed(2)}deg) rotateX(${tiltX.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
        rightPage.style.opacity = opacity.toFixed(3);
        rightPage.style.setProperty('--spine-shadow', spineShadow);
      }
      if (dotNode) {
        dotNode.classList.toggle('is-active', eased > 0.35);
      }
    });
  }

  window.addEventListener('scroll', onExperienceScroll, { passive: true });
  window.addEventListener('resize', onExperienceScroll, { passive: true });

  // 3. Dynamic Theme Variant Switcher (Forkfolio ⇄ Editorial)
  const ffWrapper = document.getElementById('theme-forkfolio-wrapper');
  const edWrapper = document.getElementById('theme-editorial-wrapper');
  const variantBtn = document.getElementById('theme-variant-toggle');
  const variantLabel = document.getElementById('theme-variant-label');
  const brandName = document.getElementById('hdr-brand-name');
  const brandSub = document.getElementById('hdr-brand-sub');

  let activeThemeVariant: 'forkfolio' | 'editorial' = 'forkfolio';

  function applyThemeVariant(variant: 'forkfolio' | 'editorial', persist = false) {
    activeThemeVariant = variant;
    const isForkfolio = variant === 'forkfolio';

    if (ffWrapper) ffWrapper.classList.toggle('hidden', !isForkfolio);
    if (edWrapper) edWrapper.classList.toggle('hidden', isForkfolio);

    if (variantLabel) {
      variantLabel.textContent = isForkfolio ? 'Forkfolio' : 'Editorial';
    }

    if (brandName && brandSub) {
      if (isForkfolio) {
        brandName.textContent = 'nguyen.thanh.quan';
        brandSub.textContent = 'devops · sre';
      } else {
        brandName.textContent = 'THANH QUÂN';
        brandSub.textContent = 'DEVOPS · SRE';
      }
    }

    document.documentElement.dataset.portfolioTheme = variant;

    if (persist) {
      localStorage.setItem('user-theme-variant', variant);
    }

    if (!isForkfolio) {
      requestAnimationFrame(() => {
        observeReveals();
        onExperienceScroll();
      });
    }
  }

  // Check URL query param first: ?theme=editorial or ?theme=forkfolio
  const urlParams = new URLSearchParams(window.location.search);
  const qTheme = urlParams.get('theme');
  if (qTheme === 'editorial' || qTheme === 'forkfolio') {
    applyThemeVariant(qTheme);
  } else {
    // Check saved user preference or window portfolio data
    const saved = localStorage.getItem('user-theme-variant');
    const storeTheme = (window as any).__PORTFOLIO__?.identity?.themeVariant;
    if (saved === 'editorial' || saved === 'forkfolio') {
      applyThemeVariant(saved);
    } else if (storeTheme === 'editorial' || storeTheme === 'forkfolio') {
      applyThemeVariant(storeTheme);
    } else {
      applyThemeVariant('forkfolio');
    }
  }

  variantBtn?.addEventListener('click', () => {
    const next = activeThemeVariant === 'forkfolio' ? 'editorial' : 'forkfolio';
    applyThemeVariant(next, true);
  });

  // Listen to remote changes or Admin Saves
  window.addEventListener('portfolio:data', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (detail?.identity?.themeVariant) {
      // If admin changed the site theme, respect it
      if (!localStorage.getItem('user-theme-variant')) {
        applyThemeVariant(detail.identity.themeVariant);
      }
    }
    observeReveals();
    requestAnimationFrame(onExperienceScroll);
  });
</script>
