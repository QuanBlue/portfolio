---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiTheme from '../components/themes/AsciiTheme.astro';
import KnightTheme from '../themes/knight/KnightTheme.astro';
import ForkfolioTheme from '../components/themes/ForkfolioTheme.astro';
import EditorialTheme from '../components/themes/EditorialTheme.astro';
import ProjectModal from '../components/dashboard/ProjectModal.astro';
import CvModal from '../components/dashboard/CvModal.astro';
import { portfolioData } from '../data/portfolio';
import { resolveTheme } from '../themes/core';

const resolved = resolveTheme(portfolioData.identity?.themeVariant);
const initialTheme = resolved.theme.id;
---

<BaseLayout title="Nguyễn Thanh Quân — DevOps & Infrastructure Engineer" currentPath="/">
  <main class="flex-grow" id="main-content">
    <!-- Neutral Resolving Surface (Visible only when theme is resolving for first-time visitors) -->
    <div
      id="theme-resolving-surface"
      class="min-h-[70vh] flex flex-col items-center justify-center gap-4 text-zinc-500 font-mono text-xs select-none"
      aria-label="Loading portfolio"
    >
      <div class="flex items-center gap-2.5 px-4 py-2 rounded-lg border border-zinc-800 bg-zinc-900/60">
        <span class="inline-block size-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="tracking-widest uppercase text-[11px] text-zinc-400">Loading Portfolio...</span>
      </div>
    </div>

    <!-- Theme 0: Forkfolio Authentic ASCII Character Art Theme -->
    <div id="theme-ascii-wrapper" data-theme-wrapper="ascii">
      <AsciiTheme />
    </div>

    <!-- Theme 1: Knight (High-Fidelity Minimalist Developer Portfolio matching forkfolio.dev) -->
    <div id="theme-knight-wrapper" data-theme-wrapper="knight">
      <KnightTheme />
    </div>

    <!-- Theme 2: Forkfolio Modern Clean Mono (Bright, minimalist developer theme) -->
    <div id="theme-forkfolio-wrapper" data-theme-wrapper="forkfolio">
      <ForkfolioTheme />
    </div>

    <!-- Theme 3: DevOps Editorial (3D Book-open timeline, Jenkins pipeline & interactive terminal) -->
    <div id="theme-editorial-wrapper" data-theme-wrapper="editorial">
      <EditorialTheme />
    </div>
  </main>

  <ProjectModal />
  <CvModal />
</BaseLayout>

<script>
  // 1. Reveal sections & editorial headings on scroll
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.add('is-visible');
          io.unobserve(en.target);
        }
      }),
    { threshold: 0.08, rootMargin: '0px 0px -30px 0px' },
  );

  function observeReveals() {
    document.querySelectorAll('.reveal:not(.is-visible), .reveal-wipe:not(.is-visible)').forEach((el) => io.observe(el));
  }
  observeReveals();

  // 2. Timeline progress line & 3D Book-Opening Scroll Effect ("mở sách" in Editorial theme)
  const journeyTimeline = document.getElementById('journey-timeline');
  const journeyProgressBar = document.getElementById('journey-progress-bar');

  function onExperienceScroll() {
    // Only execute book calculations when Editorial theme is active
    if (document.documentElement.dataset.portfolioTheme !== 'editorial') return;

    const vh = window.innerHeight || document.documentElement.clientHeight;

    // Center spine green progress fill
    if (journeyTimeline && journeyProgressBar) {
      const rect = journeyTimeline.getBoundingClientRect();
      const start = vh * 0.72;
      const end = vh * 0.25;
      const total = rect.height + (start - end);
      const current = start - rect.top;
      const ratio = Math.max(0, Math.min(1, current / total));
      journeyProgressBar.style.transform = `translateX(-50%) scaleY(${ratio.toFixed(3)})`;
    }

    // Book-opening 3D unfold per row based on scroll position
    const bookRows = document.querySelectorAll<HTMLElement>('.timeline-book-row');
    bookRows.forEach((row) => {
      const r = row.getBoundingClientRect();
      const rowCenter = r.top + r.height * 0.35;
      const enterY = vh * 0.94;
      const flatY = vh * 0.56;
      const raw = (enterY - rowCenter) / (enterY - flatY);
      const p = Math.max(0, Math.min(1, raw));
      const eased = 1 - Math.pow(1 - p, 2.6);

      const leftPage = row.querySelector<HTMLElement>('.book-page-left');
      const rightPage = row.querySelector<HTMLElement>('.book-page-right');
      const dotNode = row.querySelector<HTMLElement>('.timeline-dot-node');

      const maxAngle = 76;
      const angle = (1 - eased) * maxAngle;
      const tiltX = (1 - eased) * 6;
      const scale = 0.92 + eased * 0.08;
      const opacity = 0.12 + eased * 0.88;
      const spineShadow = ((1 - eased) * 0.85).toFixed(3);

      if (leftPage) {
        leftPage.style.transform = `rotateY(${-angle.toFixed(2)}deg) rotateX(${tiltX.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
        leftPage.style.opacity = opacity.toFixed(3);
        leftPage.style.setProperty('--spine-shadow', spineShadow);
      }
      if (rightPage) {
        rightPage.style.transform = `rotateY(${angle.toFixed(2)}deg) rotateX(${tiltX.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
        rightPage.style.opacity = opacity.toFixed(3);
        rightPage.style.setProperty('--spine-shadow', spineShadow);
      }
      if (dotNode) {
        dotNode.classList.toggle('is-active', eased > 0.35);
      }
    });
  }

  window.addEventListener('scroll', onExperienceScroll, { passive: true });
  window.addEventListener('resize', onExperienceScroll, { passive: true });

  // 3. Centralized Dynamic Theme Controller (Admin-Controlled Default + Authorized Preview Only)
  import {
    ADMIN_PREVIEW_GRANT_KEY,
    hasTheme,
    isThemePreviewAuthorized,
    persistLocalTheme,
    resolveClientTheme,
    resolveTheme,
  } from '../themes/core';
  import type { ThemeId } from '../themes/core/types';
  import type { PortfolioData } from '../data/portfolio';
  import { getSession, isOwnerSession, isSupabaseConfigured } from '../lib/supabase';

  const themeWrappers = document.querySelectorAll<HTMLElement>('[data-theme-wrapper]');
  const brandName = document.getElementById('hdr-brand-name');
  const brandSub = document.getElementById('hdr-brand-sub');

  let activeThemeVariant: ThemeId = 'ascii';

  function updateHeaderBranding(variant: ThemeId) {
    if (!brandName || !brandSub) return;
    const liveIdentity = (window as any).__PORTFOLIO__?.identity;
    const handle = String(liveIdentity?.github?.handle || 'quan').replace(/^@/, '');
    const nodeHost = String(liveIdentity?.node || 'infra-node');
    const fullName = String(liveIdentity?.name || 'THANH QUÂN');
    const shortBrand = fullName
      .trim()
      .split(/\s+/)
      .slice(-2)
      .join(' ')
      .toUpperCase();
    const dottedName = fullName
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '.')
      .replace(/^\.+|\.+$/g, '');
    const roleShort = String(liveIdentity?.role || 'devops · sre').toLowerCase();

    if (variant === 'ascii') {
      brandName.textContent = `${handle.split(/[^a-z0-9]/i)[0].toLowerCase() || 'quan'}@${nodeHost}:~$`;
      brandSub.textContent = roleShort;
    } else if (variant === 'knight') {
      brandName.textContent = dottedName || 'nguyen.thanh.quan';
      brandSub.textContent = roleShort;
    } else if (variant === 'forkfolio') {
      brandName.textContent = dottedName || 'nguyen.thanh.quan';
      brandSub.textContent = roleShort;
    } else {
      brandName.textContent = shortBrand || 'THANH QUÂN';
      brandSub.textContent = roleShort.toUpperCase();
    }
  }

  function applyThemeVariant(themeId: string, persist = false) {
    const resolved = resolveTheme(themeId);
    const variant = resolved.theme.id;
    const oldVariant = activeThemeVariant;
    activeThemeVariant = variant;

    // Clear any pending resolving fallback timer
    if ((window as any).__themeFallbackTimer) {
      clearTimeout((window as any).__themeFallbackTimer);
      (window as any).__themeFallbackTimer = null;
    }

    // Toggle theme root wrappers
    themeWrappers.forEach((el) => {
      const match = el.getAttribute('data-theme-wrapper') === variant;
      el.classList.toggle('hidden', !match);
      el.classList.toggle('block', match);
    });

    updateHeaderBranding(variant);

    document.documentElement.dataset.portfolioTheme = variant;
    window.dispatchEvent(new CustomEvent('theme:changed', { detail: { theme: variant, previousTheme: oldVariant } }));

    if (persist) {
      persistLocalTheme(variant);
    }

    if (variant === 'editorial') {
      requestAnimationFrame(() => {
        observeReveals();
        onExperienceScroll();
      });
    }
  }

  // Initial client resolution following strict priority:
  // 1. Explicit ?preview= param ONLY when authorized (Dev or Authenticated Admin)
  // 2. Canonical remote published theme if already available
  // 3. Current synchronous DOM theme (from <head> cached published theme bootstrap)
  // 4. Keep 'resolving' state until LiveData finishes first fetch (prevents cold-cache wrong-theme flash)
  const urlParamsInit = new URLSearchParams(window.location.search);
  const rawPreviewParam = urlParamsInit.get('preview') || urlParamsInit.get('theme');
  const requestedPreviewId = rawPreviewParam && hasTheme(rawPreviewParam) ? rawPreviewParam : null;
  let previewAuthorized: boolean | null = requestedPreviewId ? null : false;

  async function checkPreviewAuthorized(): Promise<boolean> {
    if (previewAuthorized !== null) return previewAuthorized;
    let ownerSession = false;
    if (isSupabaseConfigured) {
      try {
        const session = await getSession();
        ownerSession = isOwnerSession(session);
      } catch {
        ownerSession = false;
      }
    }
    let hasLocalGrant = false;
    try {
      hasLocalGrant = !isSupabaseConfigured && localStorage.getItem(ADMIN_PREVIEW_GRANT_KEY) === 'true';
    } catch {}
    previewAuthorized = isThemePreviewAuthorized({
      isDev: import.meta.env.DEV,
      isSupabaseConfigured,
      isOwnerSession: ownerSession,
      hasLocalAdminGrant: hasLocalGrant,
    });
    return previewAuthorized;
  }

  const remoteTheme = (window as any).__PORTFOLIO__?.appearance?.activeTheme || (window as any).__PORTFOLIO__?.identity?.themeVariant;
  const currentDomTheme = document.documentElement.dataset.portfolioTheme;

  if (requestedPreviewId) {
    checkPreviewAuthorized().then(async (authorized) => {
      if (authorized) {
        document.documentElement.dataset.portfolioPreview = 'true';
        applyThemeVariant(requestedPreviewId, false);
        return;
      }
      delete document.documentElement.dataset.portfolioPreview;
      let latestRemote =
        (window as any).__PORTFOLIO_OVERRIDE__?.appearance?.activeTheme ||
        (window as any).__PORTFOLIO_OVERRIDE__?.identity?.themeVariant ||
        (window as any).__PORTFOLIO__?.appearance?.activeTheme ||
        (window as any).__PORTFOLIO__?.identity?.themeVariant;
      if (!latestRemote && (window as any).__PORTFOLIO_READY__?.then) {
        await Promise.race([
          (window as any).__PORTFOLIO_READY__,
          new Promise((resolve) => setTimeout(resolve, 1500)),
        ]);
        latestRemote =
          (window as any).__PORTFOLIO_OVERRIDE__?.appearance?.activeTheme ||
          (window as any).__PORTFOLIO_OVERRIDE__?.identity?.themeVariant ||
          (window as any).__PORTFOLIO__?.appearance?.activeTheme ||
          (window as any).__PORTFOLIO__?.identity?.themeVariant;
      }
      const resolvedClient = resolveClientTheme({
        allowUrlParam: false,
        isPreviewAuthorized: false,
        allowLocalStorage: true,
        remoteTheme: latestRemote,
      });
      applyThemeVariant(resolvedClient.theme.id, Boolean(latestRemote));
    });
  } else if (remoteTheme) {
    applyThemeVariant(remoteTheme, true);
  } else if (currentDomTheme && currentDomTheme !== 'resolving') {
    applyThemeVariant(currentDomTheme, false);
  } else if ((window as any).__PORTFOLIO_READY__?.then) {
    Promise.race([
      (window as any).__PORTFOLIO_READY__,
      new Promise((resolve) => setTimeout(resolve, 1500)),
    ]).then(() => {
      if (document.documentElement.dataset.portfolioTheme === 'resolving') {
        const latestRemote = (window as any).__PORTFOLIO__?.appearance?.activeTheme || (window as any).__PORTFOLIO__?.identity?.themeVariant;
        const resolvedClient = resolveClientTheme({
          allowUrlParam: false,
          isPreviewAuthorized: false,
          allowLocalStorage: true,
          remoteTheme: latestRemote,
        });
        applyThemeVariant(resolvedClient.theme.id, Boolean(latestRemote));
      }
    });
  }

  // Listen to remote changes or Admin Saves
  window.addEventListener('portfolio:data', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    const override = (window as any).__PORTFOLIO_OVERRIDE__ as Partial<PortfolioData> | null;
    const overrideTheme = override?.appearance?.activeTheme || override?.identity?.themeVariant;
    const incomingTheme = overrideTheme || detail?.appearance?.activeTheme || detail?.identity?.themeVariant;
    const hasActivePreview = Boolean(requestedPreviewId && previewAuthorized !== false);

    if (overrideTheme && !hasActivePreview) {
      // Apply published Supabase / Local Mode admin theme unless an authorized preview is active
      applyThemeVariant(overrideTheme, true);
    } else if (!hasActivePreview && document.documentElement.dataset.portfolioTheme === 'resolving') {
      const resolvedClient = resolveClientTheme({
        allowUrlParam: false,
        isPreviewAuthorized: false,
        allowLocalStorage: true,
        remoteTheme: incomingTheme,
      });
      applyThemeVariant(resolvedClient.theme.id, Boolean(overrideTheme));
    } else if (activeThemeVariant) {
      // Refresh header branding text when identity fields update
      updateHeaderBranding(activeThemeVariant);
    }

    observeReveals();
    requestAnimationFrame(onExperienceScroll);
  });
</script>
