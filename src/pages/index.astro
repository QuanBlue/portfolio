---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import InteractiveTerminal from '../components/terminal/InteractiveTerminal.astro';
import ProjectModal from '../components/dashboard/ProjectModal.astro';
---

<BaseLayout title="Nguyễn Thanh Quân | DevOps Engineer" currentPath="/">
  <main class="flex-grow">
    <Hero />
    <GallerySection />
    <ProjectsSection />
    <ExperienceSection />
    <SkillsSection />
    <InteractiveTerminal />
    <ContactSection />
  </main>

  <ProjectModal />
</BaseLayout>

<script>
  import { openLightbox } from '../lib/lightbox';
  import { renderGalleryGrid } from '../lib/render';
  import type { GalleryItem } from '../data/portfolio';

  const grid = document.getElementById('gallery-grid')!;
  const empty = document.getElementById('gallery-empty')!;
  const all = document.getElementById('gallery-all')!;
  const limit = Number(grid.dataset.limit) || 6;
  let items: GalleryItem[] = [];

  window.addEventListener('portfolio:data', (e) => {
    items = (e as CustomEvent).detail.gallery ?? [];
    grid.innerHTML = renderGalleryGrid(items, limit);
    empty.classList.toggle('hidden', items.length > 0);
    all.classList.toggle('hidden', items.length <= limit);
  });

  grid.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-gallery-index]');
    if (card && items.length) openLightbox(items, Number(card.dataset.galleryIndex));
  });

  // Reveal sections on scroll
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.add('is-visible');
          io.unobserve(en.target);
        }
      }),
    { threshold: 0.08 },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>