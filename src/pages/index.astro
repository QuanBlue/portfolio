---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import EducationSection from '../components/sections/EducationSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import ProjectModal from '../components/dashboard/ProjectModal.astro';
import CvModal from '../components/dashboard/CvModal.astro';
---

<BaseLayout title="Nguyễn Thanh Quân — DevOps & Infrastructure Engineer" currentPath="/">
  <main class="flex-grow">
    <Hero />
    <ExperienceSection />
    <ProjectsSection />
    <EducationSection />
    <SkillsSection />
    <AboutSection />
    <ContactSection />
  </main>

  <ProjectModal />
  <CvModal />
</BaseLayout>

<script>
  // Reveal sections & editorial headings on scroll
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((en) => {
        if (en.isIntersecting) {
          en.target.classList.add('is-visible');
          io.unobserve(en.target);
        }
      }),
    { threshold: 0.1, rootMargin: '0px 0px -30px 0px' },
  );

  function observeReveals() {
    document.querySelectorAll('.reveal:not(.is-visible), .reveal-wipe:not(.is-visible)').forEach((el) => io.observe(el));
  }
  observeReveals();

  // Timeline progress line & 3D Book-Opening Scroll Effect ("mở sách")
  const journeyTimeline = document.getElementById('journey-timeline');
  const journeyProgressBar = document.getElementById('journey-progress-bar');

  function onExperienceScroll() {
    const vh = window.innerHeight || document.documentElement.clientHeight;

    // 1. Center spine green progress fill
    if (journeyTimeline && journeyProgressBar) {
      const rect = journeyTimeline.getBoundingClientRect();
      const start = vh * 0.72;
      const end = vh * 0.25;
      const total = rect.height + (start - end);
      const current = start - rect.top;
      const ratio = Math.max(0, Math.min(1, current / total));
      journeyProgressBar.style.transform = `translateX(-50%) scaleY(${ratio.toFixed(3)})`;
    }

    // 2. Book-opening 3D unfold per row based on scroll position
    const bookRows = document.querySelectorAll<HTMLElement>('.timeline-book-row');
    bookRows.forEach((row) => {
      const r = row.getBoundingClientRect();
      const rowCenter = r.top + r.height * 0.35;
      // Start opening when row enters bottom 94% of viewport, fully flat at 56% of viewport
      const enterY = vh * 0.94;
      const flatY = vh * 0.56;
      const raw = (enterY - rowCenter) / (enterY - flatY);
      const p = Math.max(0, Math.min(1, raw));
      // Smooth cubic ease-out so the page settles gently like a heavy hardcover page
      const eased = 1 - Math.pow(1 - p, 2.6);

      const leftPage = row.querySelector<HTMLElement>('.book-page-left');
      const rightPage = row.querySelector<HTMLElement>('.book-page-right');
      const dotNode = row.querySelector<HTMLElement>('.timeline-dot-node');

      // Max closed angle: 76deg folded inward toward the center spine
      const maxAngle = 76;
      const angle = (1 - eased) * maxAngle;
      const tiltX = (1 - eased) * 6;
      const scale = 0.92 + eased * 0.08;
      const opacity = 0.12 + eased * 0.88;
      const spineShadow = ((1 - eased) * 0.85).toFixed(3);

      if (leftPage) {
        // Left page hinges on right edge (spine); negative rotateY folds outer left edge toward viewer/spine
        leftPage.style.transform = `rotateY(${-angle.toFixed(2)}deg) rotateX(${tiltX.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
        leftPage.style.opacity = opacity.toFixed(3);
        leftPage.style.setProperty('--spine-shadow', spineShadow);
      }
      if (rightPage) {
        // Right page hinges on left edge (spine); positive rotateY folds outer right edge toward viewer/spine
        rightPage.style.transform = `rotateY(${angle.toFixed(2)}deg) rotateX(${tiltX.toFixed(2)}deg) scale(${scale.toFixed(3)})`;
        rightPage.style.opacity = opacity.toFixed(3);
        rightPage.style.setProperty('--spine-shadow', spineShadow);
      }
      if (dotNode) {
        dotNode.classList.toggle('is-active', eased > 0.35);
      }
    });
  }

  window.addEventListener('scroll', onExperienceScroll, { passive: true });
  window.addEventListener('resize', onExperienceScroll, { passive: true });
  window.addEventListener('portfolio:data', () => {
    observeReveals();
    requestAnimationFrame(onExperienceScroll);
  });
  onExperienceScroll();
</script>
