---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin | Quan's DevOps Dashboard" currentPath="/admin">
  <main class="flex-grow px-5 py-12 max-w-6xl w-full mx-auto">
    <div id="admin-header" class="hidden flex-wrap items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-3">
        <a href="/" class="adm-btn inline-flex items-center gap-1.5 text-xs text-[var(--muted-fg)] hover:text-[var(--fg)]" title="Quay lại trang Portfolio">
          ← Back to Portfolio
        </a>
        <h1 class="font-display text-3xl font-bold text-[var(--heading)]">
          Edit content
        </h1>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <!-- Admin Bilingual Content Switcher (EN | VI) -->
        <div id="admin-locale-toggle" class="inline-flex items-center rounded-lg border border-[var(--border)] bg-[var(--card)] p-0.5 font-mono text-[11px] select-none mr-2">
          <button type="button" class="admin-lang-btn px-2.5 py-1 rounded font-semibold text-[var(--muted-fg)] hover:text-[var(--fg)] data-[active=true]:bg-[var(--fg)] data-[active=true]:text-[var(--bg)] cursor-pointer transition" data-admin-lang="en" data-active="true" title="Edit English Content (Default)">
            🇬🇧 EN
          </button>
          <span class="text-zinc-500 px-1 text-[10px]" aria-hidden="true">|</span>
          <button type="button" class="admin-lang-btn px-2.5 py-1 rounded font-semibold text-[var(--muted-fg)] hover:text-[var(--fg)] data-[active=true]:bg-[var(--fg)] data-[active=true]:text-[var(--bg)] cursor-pointer transition" data-admin-lang="vi" data-active="false" title="Biên tập Tiếng Việt">
            🇻🇳 VI
          </button>
        </div>

        <span id="admin-status" class="text-zinc-500 mr-2 font-mono"></span>
        <button id="btn-save" type="button" class="adm-btn bg-emerald-600 text-white border-emerald-600 hover:bg-emerald-700 font-semibold px-4">Save changes</button>
        <button id="btn-export" type="button" class="adm-btn">Export content.json</button>
        <label class="adm-btn cursor-pointer">
          Import JSON
          <input id="input-import" type="file" accept="application/json,.json" class="hidden" />
        </label>
        <button id="btn-reset" type="button" class="adm-btn text-red-600 dark:text-red-400">Reset</button>

        <span class="h-4 w-px bg-[var(--border)] mx-1" aria-hidden="true"></span>

        <!-- Authenticated via Supabase: [ Account / Email ] [ Sign Out ] -->
        <div id="admin-auth-group" class="hidden items-center gap-2">
          <div id="admin-account-badge" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-[var(--border)] bg-[var(--card)] font-mono text-[11px] text-[var(--fg)] shadow-xs" title="Signed-in Account">
            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="admin-account-label">account</span>
          </div>
          <button id="btn-signout" type="button" class="adm-btn hover:text-red-600 dark:hover:text-red-400 hover:border-red-500/40 cursor-pointer" title="Sign out of Admin session">
            Sign out
          </button>
        </div>

        <!-- Local Mode: [ Local Mode ] -->
        <div id="admin-local-badge" class="hidden items-center gap-1.5 px-2.5 py-1 rounded-lg border border-amber-500/30 bg-amber-500/10 text-amber-500 font-mono text-[11px] font-medium" title="Running in Local Mode (Supabase not configured)">
          <span class="size-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span>Local Mode</span>
        </div>
      </div>
    </div>

    <p id="admin-note" class="hidden text-[11px] text-zinc-500 mb-4 leading-relaxed"></p>

    <form id="admin-login" class="card p-6 max-w-sm mx-auto space-y-3 my-10">
      <div class="flex items-center justify-between pb-1">
        <a href="/" class="text-xs text-[var(--muted)] hover:text-[var(--fg)] inline-flex items-center gap-1 font-mono transition">
          ← Back to Portfolio
        </a>
      </div>
      <h2 class="font-display text-xl font-bold text-[var(--heading)]">Sign in</h2>
      <p class="text-xs text-[var(--muted)]">Sign in with GitHub, Google, or email to continue.</p>

      <div class="space-y-2 pt-1">
        <button id="btn-github-login" type="button" class="adm-btn w-full flex items-center justify-center gap-2 py-2.5 font-medium">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
          </svg>
          Continue with GitHub
        </button>

        <button id="btn-google-login" type="button" class="adm-btn w-full flex items-center justify-center gap-2 py-2.5 font-medium">
          <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.24 1.26-.96 2.33-2.04 3.05l3.3 2.56c1.92-1.77 3.04-4.38 3.04-7.46 0-.72-.06-1.41-.19-2.05H12z"/>
            <path fill="#34A853" d="M12 22c2.7 0 4.96-.9 6.62-2.43l-3.3-2.56c-.91.61-2.08.98-3.32.98-2.55 0-4.71-1.72-5.48-4.04H3.11v2.64A9.99 9.99 0 0 0 12 22z"/>
            <path fill="#4A90E2" d="M6.52 13.95A6.01 6.01 0 0 1 6.2 12c0-.68.12-1.34.32-1.95V7.41H3.11A9.99 9.99 0 0 0 2 12c0 1.61.39 3.14 1.11 4.59l3.41-2.64z"/>
            <path fill="#FBBC05" d="M12 6.01c1.47 0 2.79.51 3.83 1.5l2.87-2.87C16.95 2.99 14.7 2 12 2A9.99 9.99 0 0 0 3.11 7.41l3.41 2.64C7.29 7.73 9.45 6.01 12 6.01z"/>
          </svg>
          Continue with Google
        </button>
      </div>

      <div class="flex items-center gap-2 text-[10px] uppercase tracking-wider text-[var(--muted)] py-1">
        <span class="h-px flex-1 bg-[var(--panel-border)]"></span>
        <span>or email</span>
        <span class="h-px flex-1 bg-[var(--panel-border)]"></span>
      </div>
      <div><span class="adm-label">Email</span><input id="login-email" type="email" required autocomplete="username" placeholder="you@example.com" class="adm-input" /></div>
      <div><span class="adm-label">Password <span class="normal-case text-[10px] opacity-75">(optional if using magic link)</span></span><input id="login-password" type="password" autocomplete="current-password" class="adm-input" /></div>
      <p id="login-error" class="text-xs text-red-500 min-h-4"></p>
      <div class="flex flex-col gap-2">
        <button type="submit" class="adm-btn bg-emerald-600 text-white border-emerald-600 hover:bg-emerald-700 w-full py-2 font-medium">Sign in with password</button>
        <button id="btn-magic-link" type="button" class="adm-btn w-full py-2 text-xs">Send magic link to email</button>
      </div>
    </form>

    <div id="admin-app" class="hidden grid grid-cols-1 md:grid-cols-[200px_1fr] gap-5 pb-20">
      <nav id="admin-tabs" class="flex md:flex-col gap-1.5 overflow-x-auto text-xs"></nav>
      <section id="admin-panel" class="dashboard-panel p-5 sm:p-6 min-w-0"></section>
    </div>

    <!-- Floating Unsaved Bar -->
    <div id="unsaved-bar" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 z-40 card px-4 py-2.5 shadow-2xl border-emerald-500/40 flex items-center gap-3 text-xs">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span class="text-[var(--heading)] font-medium">Bạn có thay đổi chưa lưu</span>
      <button id="bar-btn-discard" type="button" class="adm-btn text-red-500 dark:text-red-400">Bỏ thay đổi</button>
      <button id="bar-btn-save" type="button" class="adm-btn bg-emerald-600 text-white border-emerald-600 hover:bg-emerald-700 font-semibold px-3.5">Save changes</button>
    </div>

    <!-- Unsaved Changes Confirmation Modal -->
    <div id="unsaved-modal" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="unsaved-modal-title">
      <div class="card p-6 max-w-md w-full space-y-4 border-emerald-500/30 shadow-2xl">
        <div class="flex items-start gap-3">
          <span class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-500 flex items-center justify-center shrink-0 font-bold text-base">!</span>
          <div>
            <h3 id="unsaved-modal-title" class="font-display text-lg font-bold text-[var(--heading)]">Chưa lưu thay đổi</h3>
            <p class="text-xs text-[var(--text-body)] mt-1 leading-relaxed">
              Bạn vừa chỉnh sửa nội dung hoặc tải ảnh lên nhưng chưa bấm <b>Save</b>. Nếu rời đi ngay bây giờ, thay đổi chưa lưu sẽ không hiển thị trên trang chủ.
            </p>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-end gap-2 pt-2 text-xs">
          <button id="modal-btn-stay" type="button" class="adm-btn py-2 px-3">Chỉnh tiếp</button>
          <button id="modal-btn-discard" type="button" class="adm-btn py-2 px-3 text-red-600 dark:text-red-400">Rời đi (không lưu)</button>
          <button id="modal-btn-save" type="button" class="adm-btn bg-emerald-600 text-white border-emerald-600 hover:bg-emerald-700 py-2 px-4 font-semibold">Save &amp; Rời đi</button>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import {
    loadAdminData,
    saveStored,
    clearStored,
    fileToDataUrl,
    fileToBlob,
    fileToRawDataUrl,
    defaultPortfolioData,
    portfolioData,
  } from '../lib/store';
  import {
    isSupabaseConfigured,
    getSession,
    getSessionRole,
    isOwnerSession,
    getSessionLabel,
    signIn,
    signInWithGitHub,
    signInWithGoogle,
    sendMagicLink,
    onAuthChange,
    signOut,
    publishRemote,
    uploadImage,
  } from '../lib/supabase';
  import { mergePortfolioData } from '../data/portfolio';
  import type { PortfolioData } from '../data/portfolio';
  import { esc } from '../lib/render';
  import { ADMIN_PREVIEW_GRANT_KEY, getAllThemes } from '../themes/core';
  import type { ThemeDefinition } from '../themes/core/types';

  type FieldType = 'text' | 'number' | 'textarea' | 'select' | 'bool' | 'csv' | 'lines' | 'kv' | 'image' | 'media' | 'pdf' | 'themeSelector';
  type SelectOption = string | { value: string; label: string };
  interface Field {
    key: string;
    label: string;
    type: FieldType;
    options?: SelectOption[];
    maxDim?: number;
    wide?: boolean;
    translatable?: boolean;
  }
  interface ListSection {
    kind: 'list';
    id: keyof PortfolioData;
    title: string;
    fields: Field[];
    titleKey: string;
    create: () => Record<string, unknown>;
  }
  interface ObjectSection {
    kind: 'object';
    id: 'identity' | 'activity';
    title: string;
    fields: Field[];
  }
  interface AppearanceSection {
    kind: 'appearance';
    id: 'appearance';
    title: string;
  }

  type AdminSection = ObjectSection | ListSection | AppearanceSection;

  const uid = () => Math.random().toString(36).slice(2, 10);

  const SECTIONS: AdminSection[] = [
    {
      kind: 'appearance',
      id: 'appearance',
      title: 'Appearance (Themes)',
    },
    {
      kind: 'object',
      id: 'identity',
      title: 'Identity',
      fields: [
        { key: 'avatar', label: 'Avatar', type: 'image', maxDim: 480 },
        { key: 'cvUrl', label: 'CV / Resume (PDF)', type: 'pdf', wide: true },
        { key: 'openToWork', label: 'Open to Work (Cho phép xem & tải CV công khai)', type: 'bool', wide: true },
        {
          key: 'themeVariant',
          label: 'Theme hiển thị (Giao diện)',
          type: 'themeSelector',
          wide: true,
        },
        { key: 'name', label: 'Name', type: 'text' },
        { key: 'role', label: 'Role', type: 'text', translatable: true },
        { key: 'node', label: 'Node (header)', type: 'text' },
        { key: 'ip', label: 'IP (header)', type: 'text' },
        { key: 'location', label: 'Location', type: 'text', translatable: true },
        { key: 'email', label: 'Email', type: 'text' },
        { key: 'linkedin.handle', label: 'LinkedIn handle', type: 'text' },
        { key: 'linkedin.url', label: 'LinkedIn URL', type: 'text' },
        { key: 'github.handle', label: 'GitHub handle', type: 'text' },
        { key: 'github.url', label: 'GitHub URL', type: 'text' },
        { key: 'bio', label: 'Bio', type: 'textarea', wide: true, translatable: true },
      ],
    },
    {
      kind: 'list',
      id: 'gallery',
      title: 'Gallery',
      titleKey: 'title',
      fields: [
        { key: 'image', label: 'Image', type: 'image', maxDim: 1600 },
        { key: 'title', label: 'Title', type: 'text', translatable: true },
        { key: 'date', label: 'Date', type: 'text' },
        { key: 'location', label: 'Location', type: 'text' },
        { key: 'tags', label: 'Tags (comma separated)', type: 'csv' },
        { key: 'description', label: 'Description', type: 'textarea', wide: true, translatable: true },
        { key: 'details', label: 'Extra info nodes (one per line, "label: value")', type: 'kv', wide: true },
      ],
      create: () => ({ id: uid(), title: 'New image', description: '', image: '', date: '', location: '', tags: [], details: [] }),
    },
    {
      kind: 'list',
      id: 'projects',
      title: 'Projects',
      titleKey: 'title',
      fields: [
        { key: 'title', label: 'Title', type: 'text', translatable: true },
        { key: 'shortDesc', label: 'Short description', type: 'text', wide: true, translatable: true },
        { key: 'description', label: 'Description', type: 'textarea', wide: true, translatable: true },
        { key: 'media', label: 'Images / GIFs (shown in the project details)', type: 'media', wide: true },
        { key: 'tags', label: 'Tags (comma separated)', type: 'csv' },
        { key: 'link', label: 'Link (https://…)', type: 'text' },
        { key: 'color', label: 'Color', type: 'select', options: ['emerald', 'blue', 'purple', 'orange'] },
        { key: 'status', label: 'Status', type: 'select', options: ['ONLINE', 'MAINTENANCE'] },
      ],
      create: () => ({ id: uid(), title: 'new-project', shortDesc: '', description: '', tags: [], link: 'https://', color: 'emerald', status: 'ONLINE', media: [] }),
    },
    {
      kind: 'list',
      id: 'experience',
      title: 'Experience',
      titleKey: 'role',
      fields: [
        { key: 'role', label: 'Role', type: 'text', translatable: true },
        { key: 'company', label: 'Company', type: 'text' },
        { key: 'period', label: 'Period', type: 'text', translatable: true },
        { key: 'isCurrent', label: 'Current job', type: 'bool' },
        { key: 'tags', label: 'Tags (comma separated)', type: 'csv', wide: true },
        { key: 'bullets', label: 'Bullets (one per line)', type: 'lines', wide: true, translatable: true },
      ],
      create: () => ({ id: uid(), role: 'Role', company: '', period: '', isCurrent: false, bullets: [], tags: [] }),
    },
    {
      kind: 'list',
      id: 'education',
      title: 'Education',
      titleKey: 'degree',
      fields: [
        { key: 'badge', label: 'Badge (e.g. B.Eng, LAB)', type: 'text' },
        { key: 'period', label: 'Period (e.g. 2019 — 2023)', type: 'text', translatable: true },
        { key: 'degree', label: 'Degree / Title', type: 'text', wide: true, translatable: true },
        { key: 'school', label: 'School / Subtitle', type: 'text', wide: true, translatable: true },
        { key: 'description', label: 'Description', type: 'textarea', wide: true, translatable: true },
      ],
      create: () => ({ id: uid(), badge: 'B.Eng', period: '2019 — 2023', degree: 'Degree', school: 'University', description: '' }),
    },
    {
      kind: 'list',
      id: 'skills',
      title: 'Skills',
      titleKey: 'name',
      fields: [
        { key: 'name', label: 'Name', type: 'text' },
        { key: 'category', label: 'Category (e.g. Cloud & Infrastructure)', type: 'text', translatable: true },
        { key: 'tag', label: 'Tag, e.g. [k8s-core]', type: 'text' },
        { key: 'status', label: 'Status', type: 'select', options: ['ACTIVE', 'SYNCING'] },
      ],
      create: () => ({ id: uid(), tag: '[tag]', category: 'General', name: 'New skill', status: 'ACTIVE', delay: '0s' }),
    },
    {
      kind: 'list',
      id: 'certifications',
      title: 'Certifications',
      titleKey: 'name',
      fields: [
        { key: 'name', label: 'Certification Name', type: 'text', wide: true, translatable: true },
        { key: 'issuer', label: 'Issuing Organization', type: 'text', wide: true },
        { key: 'issueDate', label: 'Issue Date (e.g. 2024)', type: 'text' },
        { key: 'expiryDate', label: 'Expiry Date (optional)', type: 'text' },
        { key: 'credentialId', label: 'Credential ID (optional)', type: 'text' },
        { key: 'credentialUrl', label: 'Verification URL (optional)', type: 'text', wide: true },
        { key: 'badge', label: 'Badge / Code (e.g. CKA, AWS-SAA)', type: 'text' },
        { key: 'description', label: 'Description (optional)', type: 'textarea', wide: true, translatable: true },
        { key: 'color', label: 'Theme Color', type: 'select', options: ['yellow', 'blue'] },
      ],
      create: () => ({
        id: uid(),
        name: 'New Certificate',
        issuer: 'Issuing Organization',
        issueDate: '',
        credentialUrl: '',
        badge: '',
        color: 'blue',
        delay: '0s',
      }),
    },
    {
      kind: 'object',
      id: 'activity',
      title: 'Activity (Integration)',
      fields: [
        { key: 'enabled', label: 'Enable GitHub Activity & Contribution Heatmap (uses verified snapshot or custom daily JSON below)', type: 'bool', wide: true },
        { key: 'username', label: 'GitHub Account Lock (leave blank to match Identity → GitHub)', type: 'text' },
        { key: 'fetchedAt', label: 'Last Retrieved Timestamp (ISO UTC, optional)', type: 'text' },
        { key: 'days', label: 'Verified Daily Contributions JSON ([{ "date": "YYYY-MM-DD", "contributionCount": 3 }, ...]) — Leave empty to use synced build snapshot; all totals & streaks auto-calculate from these days', type: 'json', wide: true },
      ],
    },
  ];

  let data: PortfolioData = structuredClone(portfolioData);
  let active = new URLSearchParams(window.location.search).get('tab') || 'appearance';
  const tabs = document.getElementById('admin-tabs')!;
  const panel = document.getElementById('admin-panel')!;
  const status = document.getElementById('admin-status')!;

  // ---- path helpers ----
  const getPath = (obj: any, path: string) => path.split('.').reduce((o, k) => (o == null ? o : o[k]), obj);
  const setPath = (obj: any, path: string, value: unknown) => {
    const keys = path.split('.');
    const last = keys.pop()!;
    const target = keys.reduce((o, k) => (o[k] ??= {}), obj);
    target[last] = value;
  };

  // ---- persistence & dirty state ----
  let saveTimer: number | undefined;
  let signedIn = false;
  let isDirty = false;
  let pendingHref: string | null = null;

  const setStatus = (msg: string, tone: 'muted' | 'warn' | 'ok' = 'muted') => {
    status.textContent = msg;
    status.className =
      tone === 'warn'
        ? 'text-amber-500 dark:text-amber-400 mr-2 font-mono'
        : tone === 'ok'
          ? 'text-emerald-600 dark:text-emerald-400 mr-2 font-mono'
          : 'text-zinc-500 mr-2 font-mono';
  };

  const syncDirtyUi = () => {
    const bar = document.getElementById('unsaved-bar');
    if (bar) bar.classList.toggle('hidden', !(signedIn && isDirty));
  };

  const markDirty = (draftMsg?: string) => {
    isDirty = true;
    syncDirtyUi();
    setStatus(draftMsg ?? 'Unsaved changes · Click Save', 'warn');
  };

  const queueSave = () => {
    markDirty('Unsaved changes…');
    clearTimeout(saveTimer);
    saveTimer = window.setTimeout(async () => {
      try {
        await saveStored(data);
        const kb = Math.round(new Blob([JSON.stringify(data)]).size / 1024);
        if (isDirty) {
          setStatus(`Unsaved (${kb} KB) · Click Save`, 'warn');
        }
      } catch {
        setStatus('Local draft failed (storage full?)', 'warn');
      }
    }, 350);
  };

  let adminLocale: 'en' | 'vi' = 'en';

  // ---- rendering ----
  const fieldHtml = (f: Field, base: string, value: any, item?: any): string => {
    const isTranslatable = Boolean(f.translatable && adminLocale === 'vi');
    const fieldKey = isTranslatable ? `${f.key}_vi` : f.key;
    const path = `${base}${fieldKey}`;
    const attrs = `data-path="${esc(path)}" data-type="${f.type}"`;

    let displayValue = value;
    let fallbackVal: any = '';
    if (item) {
      if (isTranslatable) {
        displayValue = item[fieldKey] ?? '';
        fallbackVal = item[f.key] ?? '';
      } else {
        displayValue = item[f.key] ?? value;
      }
    }
    const fallbackText = Array.isArray(fallbackVal) ? fallbackVal.join(', ') : String(fallbackVal ?? '');
    const phAttr = isTranslatable && fallbackText ? `placeholder="Fallback (EN): ${esc(fallbackText)}"` : '';

    let control = '';
    switch (f.type) {
      case 'text':
        control = `<input class="adm-input" ${attrs} ${phAttr} value="${esc(displayValue ?? '')}" />`;
        break;
      case 'number':
        control = `<input type="number" class="adm-input" ${attrs} value="${esc(displayValue ?? '')}" />`;
        break;
      case 'textarea':
        control = `<textarea class="adm-input" rows="4" ${attrs} ${phAttr}>${esc(displayValue ?? '')}</textarea>`;
        break;
      case 'select':
        control = `<select class="adm-input" ${attrs}>${f.options!
          .map((o) => {
            const val = typeof o === 'string' ? o : o.value;
            const text = typeof o === 'string' ? o : o.label;
            return `<option value="${esc(val)}" ${val === displayValue ? 'selected' : ''}>${esc(text)}</option>`;
          })
          .join('')}</select>`;
        break;
      case 'bool':
        control = `<label class="flex items-center gap-2 text-xs"><input type="checkbox" ${attrs} ${displayValue ? 'checked' : ''} /> yes</label>`;
        break;
      case 'csv':
        control = `<input class="adm-input" ${attrs} ${phAttr} value="${esc((displayValue ?? []).join(', '))}" />`;
        break;
      case 'lines':
        control = `<textarea class="adm-input" rows="4" ${attrs} ${phAttr}>${esc((displayValue ?? []).join('\n'))}</textarea>`;
        break;
      case 'json':
        control = `<textarea class="adm-input font-mono text-xs" rows="6" ${attrs} placeholder='[{"date":"2026-11-10","contributionCount":3}]'>${esc(Array.isArray(value) ? JSON.stringify(value, null, 2) : '')}</textarea>`;
        break;
      case 'kv':
        control = `<textarea class="adm-input" rows="4" ${attrs} placeholder="Camera: Sony A7\nLens: 35mm">${esc(
          (displayValue ?? []).map((d: any) => `${d.label}: ${d.value}`).join('\n'),
        )}</textarea>`;
        break;
      case 'media': {
        const items = (value ?? []) as { src: string; caption?: string }[];
        control = `<div class="space-y-2">
          ${items
            .map(
              (m, mi) => `<div class="flex items-center gap-3 p-2 rounded-xl border border-zinc-300 dark:border-zinc-700">
            <img src="${esc(m.src)}" class="w-20 h-14 object-cover rounded-lg shrink-0" alt="" />
            <input class="adm-input" placeholder="Caption (optional)" value="${esc(m.caption ?? '')}" data-media-caption="${esc(path)}:${mi}" />
            <span class="flex gap-1 text-xs shrink-0">
              <button type="button" class="adm-btn" data-media-move="${esc(path)}:${mi}:-1" aria-label="Move left">↑</button>
              <button type="button" class="adm-btn" data-media-move="${esc(path)}:${mi}:1" aria-label="Move right">↓</button>
              <button type="button" class="adm-btn text-red-600 dark:text-red-400" data-media-remove="${esc(path)}:${mi}">✕</button>
            </span>
          </div>`,
            )
            .join('')}
          <label class="adm-btn cursor-pointer inline-block text-xs">+ Add images / GIFs
            <input type="file" accept="image/*" multiple class="hidden" data-media-upload="${esc(path)}" />
          </label>
          <p class="text-[10px] text-zinc-500">GIFs keep their animation (max ${isSupabaseConfigured ? '10' : '2.5'} MB). Other images are resized to 1600px.</p>
        </div>`;
        break;
      }
      case 'image':
        control = `<div class="flex items-center gap-3">
          <div class="w-20 h-20 rounded border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-900 overflow-hidden flex items-center justify-center text-[10px] text-zinc-500">
            ${value ? `<img src="${esc(value)}" class="w-full h-full object-cover" alt="" />` : 'no image'}
          </div>
          <div class="flex flex-col gap-1 text-xs">
            <label class="adm-btn cursor-pointer text-center">Upload
              <input type="file" accept="image/*" class="hidden" data-upload="${esc(path)}" data-maxdim="${f.maxDim ?? 1600}" />
            </label>
            ${value ? `<button type="button" class="adm-btn text-red-600 dark:text-red-400" data-clear="${esc(path)}">Remove</button>` : ''}
          </div></div>`;
        break;
      case 'pdf': {
        const hasPdf = Boolean(value && String(value).trim());
        const isDataUrl = hasPdf && String(value).startsWith('data:');
        control = `<div class="rounded-xl border border-[var(--border)] bg-[var(--muted-bg)]/40 p-3.5 space-y-2.5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 text-xs">
              <span class="grid size-8 place-items-center rounded-lg border border-[var(--signal)]/40 bg-emerald-500/10 text-[var(--signal)] font-mono font-bold">PDF</span>
              <div>
                <div class="font-semibold text-[var(--fg)]">${hasPdf ? 'Custom PDF CV attached' : 'No PDF uploaded (using dynamic Web CV)'}</div>
                <div class="text-[11px] text-[var(--muted-fg)]">${isDataUrl ? 'Stored as embedded PDF' : hasPdf ? esc(String(value)) : 'Upload a .pdf file or paste a direct link below'}</div>
              </div>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <label class="adm-btn bg-emerald-600 text-white border-emerald-600 hover:bg-emerald-700 cursor-pointer font-semibold">
                Upload CV (.pdf)
                <input type="file" accept="application/pdf,.pdf" class="hidden" data-upload-pdf="${esc(path)}" />
              </label>
              ${hasPdf ? `<a href="${esc(String(value))}" target="_blank" rel="noopener noreferrer" class="adm-btn">View PDF ↗</a>` : ''}
              ${hasPdf ? `<button type="button" class="adm-btn text-red-600 dark:text-red-400" data-clear="${esc(path)}">Remove</button>` : ''}
            </div>
          </div>
          <input class="adm-input" placeholder="Or paste PDF link (https://…)" ${attrs} value="${esc(isDataUrl ? '' : (value ?? ''))}" />
        </div>`;
        break;
      }
      case 'themeSelector': {
        const allThemes = getAllThemes();
        const currentId = value || 'ascii';
        control = `<div class="space-y-3">
          <input type="hidden" ${attrs} id="input-theme-selector" value="${esc(currentId)}" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="theme-selector-grid">
            ${allThemes
              .map((t) => {
                const isSelected = t.id === currentId;
                return `<div class="theme-card relative rounded-xl border p-4 transition-all duration-200 flex flex-col justify-between gap-3 ${
                  isSelected
                    ? 'border-emerald-500 bg-emerald-500/5 shadow-sm ring-1 ring-emerald-500'
                    : 'border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-900/50 hover:border-zinc-400 dark:hover:border-zinc-600'
                }" data-theme-card="${esc(t.id)}">
                  <div>
                    <div class="flex items-center justify-between gap-2">
                      <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--heading)]">${esc(t.name)}</span>
                      <span class="theme-card-badge px-2 py-0.5 rounded-full text-[10px] font-mono font-medium ${
                        isSelected ? 'bg-emerald-500/20 text-emerald-500' : 'bg-zinc-500/10 text-zinc-500'
                      }">${isSelected ? '● Active' : 'Available'}</span>
                    </div>
                    <p class="text-xs text-[var(--muted)] mt-1.5 leading-relaxed">${esc(t.description)}</p>
                  </div>
                  <div class="flex items-center gap-2 pt-2 border-t border-zinc-200 dark:border-zinc-800 text-xs">
                    <button type="button" class="adm-btn flex-1 text-center font-medium cursor-pointer ${isSelected ? 'bg-emerald-600 text-white border-emerald-600' : ''}" data-select-theme="${esc(t.id)}">
                      ${isSelected ? 'Đang chọn' : 'Chọn theme này'}
                    </button>
                    <a href="/?preview=${esc(t.id)}" data-preview-theme="${esc(t.id)}" target="_blank" rel="noopener noreferrer" class="adm-btn text-center hover:text-emerald-500" title="Mở tab mới xem trước dữ liệu thật">
                      Preview ↗
                    </a>
                  </div>
                </div>`;
              })
              .join('')}
          </div>
        </div>`;
        break;
      }
    }
    const labelBadge = isTranslatable
      ? ` <span class="text-[10px] font-mono text-emerald-500 font-semibold">(Tiếng Việt 🇻🇳)</span>`
      : '';
    return `<div class="${f.wide || f.type === 'image' || f.type === 'pdf' || f.type === 'themeSelector' ? 'md:col-span-2' : ''}"><span class="adm-label">${esc(f.label)}${labelBadge}</span>${control}</div>`;
  };

  const render = () => {
    tabs.innerHTML = SECTIONS.map((s) => {
      const count = s.kind === 'list' ? ` (${(data[s.id] as unknown[]).length})` : '';
      const on = s.id === active;
      return `<button type="button" data-tab="${s.id}" class="text-left px-3.5 py-2.5 rounded-xl border whitespace-nowrap cursor-pointer font-medium transition ${
        on
          ? 'border-[var(--signal)] text-[var(--signal)] bg-emerald-500/10'
          : 'border-[var(--border)] bg-[var(--card)] text-[var(--muted-fg)] hover:border-[var(--line-strong)] hover:text-[var(--fg)]'
      }">${s.title}${count}</button>`;
    }).join('');

    const section = SECTIONS.find((s) => s.id === active)!;
    if (section.kind === 'appearance') {
      const allThemes = getAllThemes();
      const currentThemeId = (data.appearance?.activeTheme || data.identity?.themeVariant || 'ascii') as string;
      const activeDef = allThemes.find((t) => t.id === currentThemeId) || allThemes[0];

      panel.innerHTML = `
        <div class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-[var(--border)]">
            <div>
              <h2 class="font-display text-xl font-bold text-[var(--heading)]">Appearance &amp; Theme System</h2>
              <p class="text-xs text-[var(--muted-fg)] mt-1">
                Select and publish the default theme for your portfolio. All themes share your portfolio data and content seamlessly.
              </p>
            </div>
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-500 text-xs font-mono shrink-0">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Live Default: <b>${esc(activeDef.name)}</b></span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            ${allThemes
              .map((t) => {
                const isSelected = t.id === currentThemeId;
                return `
                <div class="theme-card relative rounded-2xl border p-5 transition-all duration-200 flex flex-col justify-between gap-4 ${
                  isSelected
                    ? 'border-emerald-500 bg-emerald-500/5 shadow-md ring-1 ring-emerald-500'
                    : 'border-[var(--border)] bg-[var(--card)] hover:border-[var(--line-strong)]'
                }" data-theme-card="${esc(t.id)}">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <div class="flex items-center gap-2">
                        <span class="font-mono text-sm font-bold tracking-wider text-[var(--heading)]">${esc(t.name)}</span>
                        ${t.id === 'knight' ? '<span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-amber-500/10 text-amber-500 border border-amber-500/30">Forkfolio Minimalist</span>' : ''}
                      </div>
                      <span class="theme-card-badge px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium ${
                        isSelected ? 'bg-emerald-500/20 text-emerald-500' : 'bg-zinc-500/10 text-zinc-500'
                      }">${isSelected ? '● Active Default' : 'Available'}</span>
                    </div>
                    <p class="text-xs text-[var(--muted-fg)] leading-relaxed mb-3">${esc(t.description)}</p>
                    <div class="flex flex-wrap gap-1.5">
                      ${(t.id === 'knight'
                        ? ['Martian Mono', 'Glyph Scramble', 'Magnetic Pull', 'Interactive Cursor']
                        : t.id === 'ascii'
                        ? ['ASCII Art', 'CLI Monospace', 'Compact Terminal']
                        : t.id === 'editorial'
                        ? ['3D Book Unfold', 'CI/CD Pipeline', 'Observability']
                        : ['Modern Clean', 'Minimalist', 'Light/Dark']
                      ).map((f) => `<span class="px-2 py-0.5 rounded-md bg-[var(--muted-bg)] text-[10px] font-mono text-[var(--muted-fg)]">${esc(f)}</span>`).join('')}
                    </div>
                  </div>

                  <div class="flex items-center gap-2 pt-3 border-t border-[var(--border)] text-xs">
                    <button type="button" class="adm-btn flex-1 text-center font-medium cursor-pointer ${
                      isSelected
                        ? 'bg-emerald-600 text-white border-emerald-600'
                        : 'hover:border-emerald-500 hover:text-emerald-500'
                    }" data-select-theme="${esc(t.id)}">
                      ${isSelected ? '✓ Đang chọn làm mặc định' : 'Đặt làm Theme mặc định'}
                    </button>
                    <a href="/?preview=${esc(t.id)}" data-preview-theme="${esc(t.id)}" target="_blank" rel="noopener noreferrer" class="adm-btn inline-flex items-center gap-1 text-center hover:text-emerald-500" title="Mở tab mới xem trước giao diện với dữ liệu thật">
                      <span>Preview</span>
                      <span>↗</span>
                    </a>
                  </div>
                </div>
              `;
              })
              .join('')}
          </div>

          <div class="rounded-xl border border-[var(--border)] bg-[var(--muted-bg)]/40 p-4 text-xs text-[var(--muted-fg)] space-y-2">
            <p class="font-semibold text-[var(--heading)] flex items-center gap-1.5">
              <span>💡 Hướng dẫn chuyển đổi giao diện:</span>
            </p>
            <ul class="list-disc list-inside space-y-1 pl-1">
              <li><b>Preview ↗:</b> Mở tab mới xem trước giao diện với dữ liệu thật của bạn mà <i>không</i> làm thay đổi trang đang hiển thị với người dùng khác.</li>
              <li><b>Đặt làm Theme mặc định:</b> Đánh dấu theme này làm mặc định. Nhấn <b>Save changes</b> ở góc trên để lưu lên Supabase/IndexedDB và áp dụng toàn cầu cho khách truy cập.</li>
            </ul>
          </div>
        </div>
      `;
      return;
    }
    if (section.kind === 'object') {
      panel.innerHTML = `<div class="grid grid-cols-1 md:grid-cols-2 gap-4">${section.fields
        .map((f) => fieldHtml(f, `${section.id}.`, getPath(data[section.id], f.key), data[section.id]))
        .join('')}</div>`;
      return;
    }
    const list = data[section.id] as any[];
    panel.innerHTML = `
      <div class="flex justify-between items-center mb-4">
        <h2 class="font-bold text-base text-[var(--heading)]">${section.title}</h2>
        <div class="flex items-center gap-2">
          ${
            section.id === 'gallery'
              ? `<label class="adm-btn bg-emerald-600 text-white border-emerald-600 hover:bg-emerald-700 text-xs cursor-pointer">+ Upload photos
                  <input type="file" accept="image/*" multiple class="hidden" data-gallery-batch="1" />
                </label>`
              : ''
          }
          <button type="button" data-add="${section.id}" class="adm-btn ${section.id === 'gallery' ? '' : 'bg-emerald-600 text-white border-emerald-600 hover:bg-emerald-700'} text-xs">+ Add</button>
        </div>
      </div>
      ${list.length === 0 ? '<p class="text-xs text-[var(--muted-fg)]">Empty. Click “+ Add”.</p>' : ''}
      <div class="space-y-3">
      ${list
        .map(
          (item, i) => `<details class="border border-[var(--border)] bg-[var(--muted-bg)]/40 rounded-xl overflow-hidden" ${list.length <= 3 || i === 0 ? 'open' : ''}>
        <summary class="px-4 py-2.5 cursor-pointer flex items-center justify-between gap-2 text-sm text-[var(--heading)] bg-[var(--muted-bg)]/60">
          <span class="truncate font-semibold">${esc(item[section.titleKey] || '(untitled)')}</span>
          <span class="flex gap-1.5 text-xs shrink-0" data-stop>
            <button type="button" class="adm-btn" data-move="${section.id}:${i}:-1" aria-label="Move up">↑</button>
            <button type="button" class="adm-btn" data-move="${section.id}:${i}:1" aria-label="Move down">↓</button>
            <button type="button" class="adm-btn text-red-600 dark:text-red-400" data-del="${section.id}:${i}">Delete</button>
          </span>
        </summary>
        <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-[var(--border)] bg-[var(--card)]">
          ${section.fields.map((f) => fieldHtml(f, `${section.id}.${i}.`, item[f.key], item)).join('')}
        </div></details>`,
        )
        .join('')}
      </div>`;
  };

  // ---- events ----
  const INVALID_JSON = Symbol('INVALID_JSON');
  const readControl = (el: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement): unknown => {
    const type = el.dataset.type;
    const v = (el as HTMLInputElement).value;
    switch (type) {
      case 'bool':
        return (el as HTMLInputElement).checked;
      case 'number':
        return v === '' ? undefined : Number(v);
      case 'csv':
        return v.split(',').map((s) => s.trim()).filter(Boolean);
      case 'lines':
        return v.split('\n').map((s) => s.trim()).filter(Boolean);
      case 'json': {
        const trimmed = v.trim();
        if (!trimmed) return undefined;
        try {
          const parsed = JSON.parse(trimmed);
          if (!Array.isArray(parsed)) {
            setStatus('Invalid JSON in Activity days (expected an array)', 'warn');
            return INVALID_JSON;
          }
          return parsed;
        } catch {
          setStatus('Invalid JSON syntax in Activity days', 'warn');
          return INVALID_JSON;
        }
      }
      case 'kv':
        return v
          .split('\n')
          .map((l) => l.trim())
          .filter(Boolean)
          .map((l) => {
            const i = l.indexOf(':');
            return i === -1 ? { label: '', value: l } : { label: l.slice(0, i).trim(), value: l.slice(i + 1).trim() };
          });
      default:
        return v;
    }
  };

  const GIF_MAX = isSupabaseConfigured ? 10 * 1024 * 1024 : 2.5 * 1024 * 1024;
  async function processFile(file: File, folder: string, maxDim: number): Promise<string> {
    const remote = isSupabaseConfigured && signedIn;
    if (file.type === 'image/gif') {
      if (file.size > GIF_MAX) throw new Error(`GIF too large (max ${Math.round(GIF_MAX / 1048576 * 10) / 10} MB)`);
      return remote
        ? uploadImage(file, folder, { ext: 'gif', contentType: 'image/gif' })
        : fileToRawDataUrl(file);
    }
    return remote ? uploadImage(await fileToBlob(file, maxDim), folder) : fileToDataUrl(file, maxDim);
  }

  const onEdit = (e: Event) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset?.mediaCaption) {
      const [path, idx] = el.dataset.mediaCaption.split(':');
      const list = getPath(data, path) as { caption?: string }[];
      if (list?.[Number(idx)]) list[Number(idx)].caption = el.value;
      queueSave();
      return;
    }
    if (!el.dataset?.path) return;
    const nextVal = readControl(el);
    if (nextVal === INVALID_JSON) {
      el.setAttribute('aria-invalid', 'true');
      return;
    }
    el.removeAttribute('aria-invalid');
    setPath(data, el.dataset.path, nextVal);
    if (el.dataset.path === 'identity.openToWork') {
      setPath(data, 'careerSettings.openToWork', Boolean(nextVal));
    } else if (el.dataset.path === 'identity.cvUrl') {
      setPath(data, 'careerSettings.cvUrl', String(nextVal ?? ''));
    } else if (el.dataset.path === 'identity.avatar') {
      setPath(data, 'identity.avatarUpdatedAt', new Date().toISOString());
    }
    queueSave();
    // keep tab counts / summary titles fresh without re-rendering inputs
    const summaryTitle = el.closest('details')?.querySelector('summary span.truncate');
    if (summaryTitle && /\.(title|role|name)(_vi)?$/.test(el.dataset.path)) summaryTitle.textContent = el.value || '(untitled)';
  };
  panel.addEventListener('input', onEdit);
  panel.addEventListener('change', async (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset?.galleryBatch && el.files?.length) {
      try {
        let n = 0;
        for (const file of Array.from(el.files)) {
          setStatus(`Uploading photo ${++n}/${el.files.length}…`, 'muted');
          const url = await processFile(file, 'gallery', 1600);
          const baseName = file.name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').trim() || 'Photo';
          data.gallery.unshift({
            id: uid(),
            title: baseName,
            description: '',
            image: url,
            date: new Date().toISOString().slice(0, 10),
            location: '',
            tags: [],
            details: [],
          });
        }
        queueSave();
        render();
      } catch (err) {
        setStatus((err as Error).message || 'Could not upload photo', 'warn');
      }
      return;
    }
    if (el.dataset?.mediaUpload && el.files?.length) {
      const path = el.dataset.mediaUpload;
      try {
        const list = (getPath(data, path) ?? []) as { src: string; caption?: string }[];
        let n = 0;
        for (const file of Array.from(el.files)) {
          setStatus(`Processing ${++n}/${el.files.length}…`);
          list.push({ src: await processFile(file, 'projects', 1600), caption: '' });
        }
        setPath(data, path, list);
        queueSave();
        render();
      } catch (err) {
        setStatus((err as Error).message || 'Could not process/upload that image');
      }
      return;
    }
    if (el.dataset?.uploadPdf && el.files?.[0]) {
      const file = el.files[0];
      const PDF_MAX = isSupabaseConfigured ? 15 * 1024 * 1024 : 3 * 1024 * 1024;
      try {
        if (file.size > PDF_MAX) {
          throw new Error(`PDF too large (max ${Math.round(PDF_MAX / 1048576)} MB)`);
        }
        setStatus('Uploading CV PDF…', 'muted');
        const remote = isSupabaseConfigured && signedIn;
        const url = remote
          ? await uploadImage(file, 'cv', { ext: 'pdf', contentType: 'application/pdf' })
          : await fileToRawDataUrl(file);
        setPath(data, el.dataset.uploadPdf, url);
        if (el.dataset.uploadPdf === 'identity.cvUrl') {
          setPath(data, 'careerSettings.cvUrl', url);
        }
        queueSave();
        render();
      } catch (err) {
        setStatus((err as Error).message || 'Could not upload PDF', 'warn');
      }
      return;
    }
    if (el.dataset?.upload && el.files?.[0]) {
      try {
        setStatus('Processing image…');
        const url = await processFile(
          el.files[0],
          el.dataset.upload.startsWith('identity') ? 'avatar' : 'gallery',
          Number(el.dataset.maxdim) || 1600,
        );
        setPath(data, el.dataset.upload, url);
        if (el.dataset.upload === 'identity.avatar') {
          setPath(data, 'identity.avatarUpdatedAt', new Date().toISOString());
        }
        queueSave();
        render();
      } catch (err) {
        setStatus((err as Error).message || 'Could not process/upload that image');
      }
      return;
    }
    onEdit(e);
  });

  panel.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-stop]')) e.preventDefault(); // don't toggle <details>

    const previewLink = t.closest<HTMLAnchorElement>('[data-preview-theme]');
    if (previewLink) {
      if (!signedIn) {
        e.preventDefault();
        return;
      }
      if (!isSupabaseConfigured) {
        try {
          localStorage.setItem(ADMIN_PREVIEW_GRANT_KEY, 'true');
        } catch {}
      }
      return;
    }

    const themeBtn = t.closest<HTMLElement>('[data-select-theme]');
    if (themeBtn) {
      if (!signedIn) return;
      const chosenTheme = themeBtn.dataset.selectTheme;
      if (chosenTheme) {
        setPath(data, 'identity.themeVariant', chosenTheme);
        setPath(data, 'appearance.activeTheme', chosenTheme);
        queueSave();
        render();
      }
      return;
    }

    const btn = t.closest<HTMLElement>('[data-add],[data-del],[data-move],[data-clear],[data-media-remove],[data-media-move]');
    if (!btn) return;
    if (btn.dataset.mediaRemove || btn.dataset.mediaMove) {
      const [path, idx, d] = (btn.dataset.mediaRemove ?? btn.dataset.mediaMove)!.split(':');
      const list = (getPath(data, path) ?? []) as unknown[];
      const from = Number(idx);
      if (btn.dataset.mediaRemove) list.splice(from, 1);
      else {
        const to = from + Number(d);
        if (to < 0 || to >= list.length) return;
        [list[from], list[to]] = [list[to], list[from]];
      }
    } else if (btn.dataset.add) {
      const s = SECTIONS.find((x) => x.id === btn.dataset.add) as ListSection;
      (data[s.id] as unknown[]).push(s.create());
    } else if (btn.dataset.del) {
      const [id, i] = btn.dataset.del.split(':');
      if (!confirm('Delete this item?')) return;
      (data[id as keyof PortfolioData] as unknown[]).splice(Number(i), 1);
    } else if (btn.dataset.move) {
      const [id, i, d] = btn.dataset.move.split(':');
      const list = data[id as keyof PortfolioData] as unknown[];
      const from = Number(i);
      const to = from + Number(d);
      if (to < 0 || to >= list.length) return;
      [list[from], list[to]] = [list[to], list[from]];
    } else if (btn.dataset.clear) {
      setPath(data, btn.dataset.clear, '');
      if (btn.dataset.clear === 'identity.cvUrl') {
        setPath(data, 'careerSettings.cvUrl', '');
      } else if (btn.dataset.clear === 'identity.avatar') {
        setPath(data, 'identity.avatarUpdatedAt', new Date().toISOString());
      }
    }
    queueSave();
    render();
  });

  tabs.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-tab]');
    if (!b) return;
    active = b.dataset.tab!;
    render();
  });

  // Admin Language Switcher (EN | VI)
  document.querySelectorAll<HTMLElement>('[data-admin-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetLang = btn.dataset.adminLang as 'en' | 'vi';
      if (!targetLang || targetLang === adminLocale) return;
      adminLocale = targetLang;
      document.querySelectorAll<HTMLElement>('[data-admin-lang]').forEach((b) => {
        b.dataset.active = b.dataset.adminLang === adminLocale ? 'true' : 'false';
      });
      const note = document.getElementById('admin-note');
      if (note) {
        note.classList.remove('hidden');
        note.textContent =
          adminLocale === 'vi'
            ? '🇻🇳 Chế độ biên tập Tiếng Việt: Nhập bản dịch tiếng Việt cho các trường nội dung. Nếu bỏ trống trường nào, hệ thống sẽ tự động hiển thị theo tiếng Anh mặc định.'
            : '🇬🇧 Chế độ biên tập Tiếng Anh (Mặc định toàn cầu cho khách truy cập lần đầu).';
      }
      render();
    });
  });

  document.getElementById('btn-export')!.addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'content.json';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  document.getElementById('input-import')!.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    try {
      const parsed = JSON.parse(await file.text());
      if (typeof parsed !== 'object' || !parsed || Array.isArray(parsed)) throw new Error('bad');
      data = mergePortfolioData(defaultPortfolioData, parsed);
      for (const k of ['skills', 'certifications', 'experience', 'education', 'projects', 'gallery'] as const) {
        if (!Array.isArray(data[k])) (data as any)[k] = [];
      }
      queueSave();
      render();
    } catch {
      alert('Invalid JSON file.');
    }
    input.value = '';
  });

  document.getElementById('btn-reset')!.addEventListener('click', async () => {
    const msg = isSupabaseConfigured
      ? 'Discard your unsaved changes and reload the live content?'
      : 'Discard all local edits and go back to the built-in content?';
    if (!confirm(msg)) return;
    await clearStored();
    isDirty = false;
    syncDirtyUi();
    await startEditor();
    setStatus('Changes discarded', 'muted');
  });

  const $ = (id: string) => document.getElementById(id)!;
  const adminHeader = $('admin-header');
  const saveBtn = $('btn-save') as HTMLButtonElement;
  const barSaveBtn = $('bar-btn-save') as HTMLButtonElement;
  const barDiscardBtn = $('bar-btn-discard') as HTMLButtonElement;
  const unsavedModal = $('unsaved-modal');
  const modalStayBtn = $('modal-btn-stay');
  const modalDiscardBtn = $('modal-btn-discard');
  const modalSaveBtn = $('modal-btn-save') as HTMLButtonElement;
  const signoutBtn = $('btn-signout');
  const loginForm = $('admin-login') as HTMLFormElement;
  const app = $('admin-app');
  const note = $('admin-note');

  async function saveAll(): Promise<boolean> {
    try {
      if (!signedIn) {
        throw new Error('Unauthorized: Authenticated Admin session is required.');
      }
      saveBtn.disabled = true;
      barSaveBtn.disabled = true;
      modalSaveBtn.disabled = true;
      setStatus('Saving to live site…', 'muted');
      clearTimeout(saveTimer);
      if (isSupabaseConfigured) {
        const session = await getSession();
        if (!isOwnerSession(session)) {
          signedIn = false;
          await boot();
          throw new Error('Unauthorized: Admin session is missing or lacks permission.');
        }
        await publishRemote(data);
        await clearStored();
      } else {
        await saveStored(data);
      }
      const activeTheme = (data.appearance?.activeTheme || data.identity?.themeVariant) as string;
      if (activeTheme) {
        try {
          localStorage.setItem('portfolio-published-theme', activeTheme);
          localStorage.setItem('user-theme-variant', activeTheme);
        } catch (e) {}
      }
      isDirty = false;
      syncDirtyUi();
      setStatus('Saved ✓ — Live on site', 'ok');
      return true;
    } catch (err) {
      setStatus(`Save failed: ${(err as Error).message}`, 'warn');
      return false;
    } finally {
      saveBtn.disabled = false;
      barSaveBtn.disabled = false;
      modalSaveBtn.disabled = false;
    }
  }

  saveBtn.addEventListener('click', () => saveAll());
  barSaveBtn.addEventListener('click', () => saveAll());

  barDiscardBtn.addEventListener('click', async () => {
    if (!confirm('Bỏ các thay đổi chưa lưu?')) return;
    await clearStored();
    isDirty = false;
    syncDirtyUi();
    await startEditor();
    setStatus('Changes discarded', 'muted');
  });

  // Ctrl+S / Cmd+S shortcut to save
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's' && signedIn) {
      e.preventDefault();
      saveAll();
    }
    if (e.key === 'Escape' && !unsavedModal.classList.contains('hidden')) {
      unsavedModal.classList.add('hidden');
      pendingHref = null;
    }
  });

  // Intercept navigation links when there are unsaved changes
  document.addEventListener('click', (e) => {
    if (!signedIn || !isDirty) return;
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!link) return;
    if (link.target === '_blank' || link.hasAttribute('download')) return;
    const href = link.getAttribute('href');
    if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;
    e.preventDefault();
    pendingHref = link.href;
    unsavedModal.classList.remove('hidden');
  });

  let pendingSignOut = false;

  async function performSignOut() {
    try {
      setStatus('Signing out…', 'muted');
      await signOut();
      signedIn = false;
      isDirty = false;
      pendingSignOut = false;
      syncDirtyUi();
      await boot();
      setStatus('Signed out', 'muted');
    } catch (err) {
      console.error('Sign-out error:', err);
      setStatus(`Sign-out failed: ${(err as Error).message}`, 'warn');
    }
  }

  modalStayBtn.addEventListener('click', () => {
    unsavedModal.classList.add('hidden');
    pendingHref = null;
    pendingSignOut = false;
  });

  modalDiscardBtn.addEventListener('click', async () => {
    const dest = pendingHref;
    const shouldSignOut = pendingSignOut;
    unsavedModal.classList.add('hidden');
    pendingHref = null;
    pendingSignOut = false;
    await clearStored();
    isDirty = false;
    syncDirtyUi();
    if (shouldSignOut) {
      await performSignOut();
    } else if (dest) {
      window.location.href = dest;
    }
  });

  modalSaveBtn.addEventListener('click', async () => {
    const dest = pendingHref;
    const shouldSignOut = pendingSignOut;
    const ok = await saveAll();
    if (ok) {
      unsavedModal.classList.add('hidden');
      pendingHref = null;
      pendingSignOut = false;
      if (shouldSignOut) {
        await performSignOut();
      } else if (dest) {
        window.location.href = dest;
      }
    }
  });

  window.addEventListener('beforeunload', (e) => {
    if (signedIn && isDirty) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  signoutBtn?.addEventListener('click', async () => {
    if (isDirty) {
      pendingSignOut = true;
      unsavedModal.classList.remove('hidden');
      return;
    }
    await performSignOut();
  });

  $('btn-github-login').addEventListener('click', async () => {
    const err = $('login-error');
    err.className = 'text-xs text-red-500 min-h-4';
    err.textContent = '';
    try {
      await signInWithGitHub();
    } catch (ex) {
      err.textContent = (ex as Error).message;
    }
  });

  $('btn-google-login').addEventListener('click', async () => {
    const err = $('login-error');
    err.className = 'text-xs text-red-500 min-h-4';
    err.textContent = '';
    try {
      await signInWithGoogle();
    } catch (ex) {
      err.textContent = (ex as Error).message;
    }
  });

  $('btn-magic-link').addEventListener('click', async () => {
    const err = $('login-error');
    const email = ($('login-email') as HTMLInputElement).value.trim();
    err.className = 'text-xs text-red-500 min-h-4';
    if (!email) {
      err.textContent = 'Enter your email first.';
      return;
    }
    try {
      await sendMagicLink(email);
      err.className = 'text-xs text-emerald-500 min-h-4';
      err.textContent = 'Magic link sent! Check your email inbox.';
    } catch (ex) {
      err.textContent = (ex as Error).message;
    }
  });

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('login-error');
    err.className = 'text-xs text-red-500 min-h-4';
    err.textContent = '';
    const email = ($('login-email') as HTMLInputElement).value.trim();
    const password = ($('login-password') as HTMLInputElement).value;
    if (!password) {
      err.textContent = 'Enter your password, or click "Send magic link to email".';
      return;
    }
    try {
      await signIn(email, password);
      boot();
    } catch (ex) {
      err.textContent = (ex as Error).message;
    }
  });

  async function startEditor() {
    const { data: d, fromDraft } = await loadAdminData();
    data = structuredClone(d);
    if (!Array.isArray(data.gallery)) data.gallery = [];
    if (!Array.isArray(data.education)) data.education = [];
    if (!Array.isArray(data.certifications)) data.certifications = [];
    if (!Array.isArray(data.experience)) data.experience = [];
    if (!Array.isArray(data.skills)) data.skills = [];
    if (!Array.isArray(data.projects)) data.projects = [];
    if (!data.activity) data.activity = { enabled: false };
    render();
    if (fromDraft) {
      markDirty('Loaded unsaved draft · Click Save to apply');
    } else {
      isDirty = false;
      syncDirtyUi();
      setStatus('All changes saved', 'muted');
    }
  }

  async function boot() {
    const session = await getSession();
    if (!isSupabaseConfigured) {
      // In local development or static mode without Supabase, enable offline draft editor
      signedIn = true;
    } else if (session && !isOwnerSession(session)) {
      const err = $('login-error');
      err.className = 'text-xs text-red-500 min-h-4';
      err.textContent = 'Account is not authorized as portfolio owner.';
      await signOut();
      signedIn = false;
    } else {
      signedIn = Boolean(session);
    }

    const hdrLabel = document.getElementById('hdr-admin-label');
    if (hdrLabel) hdrLabel.textContent = (signedIn && session) ? 'Admin' : (signedIn && !isSupabaseConfigured) ? 'Admin' : 'Login';

    const authGroup = document.getElementById('admin-auth-group');
    const localBadge = document.getElementById('admin-local-badge');
    const accountLabel = document.getElementById('admin-account-label');

    if (signedIn && session) {
      if (authGroup) {
        authGroup.classList.remove('hidden');
        authGroup.classList.add('flex');
      }
      if (localBadge) {
        localBadge.classList.add('hidden');
        localBadge.classList.remove('inline-flex');
      }
      if (accountLabel) {
        const email = session.user?.email || '';
        const role = getSessionRole(session);
        const label = getSessionLabel(session);
        accountLabel.textContent = label || email || 'Owner';
        accountLabel.title = email ? `Signed in as ${email}` : '';
      }
      note.innerHTML =
        getSessionRole(session) === 'root'
          ? 'Signed in as <b>Repo Owner (ROOT)</b> via GitHub. Press <b>Save changes</b> (or <code>Ctrl+S</code>) to save your edits live.'
          : 'Press <b>Save changes</b> (or <code>Ctrl+S</code>) to save your edits and uploaded images to your live site.';
    } else if (signedIn && !isSupabaseConfigured) {
      if (authGroup) {
        authGroup.classList.add('hidden');
        authGroup.classList.remove('flex');
      }
      if (localBadge) {
        localBadge.classList.remove('hidden');
        localBadge.classList.add('inline-flex');
      }
      note.innerHTML = 'Running in <b>Local Mode</b> (Supabase not configured). Edits are saved to local IndexedDB drafts. Use <b>Export content.json</b> to commit changes.';
    } else {
      try {
        localStorage.removeItem(ADMIN_PREVIEW_GRANT_KEY);
      } catch {}
      if (authGroup) {
        authGroup.classList.add('hidden');
        authGroup.classList.remove('flex');
      }
      if (localBadge) {
        localBadge.classList.add('hidden');
        localBadge.classList.remove('inline-flex');
      }
    }

    adminHeader.classList.toggle('hidden', !signedIn);
    adminHeader.classList.toggle('flex', signedIn);
    note.classList.toggle('hidden', !signedIn);
    app.classList.toggle('hidden', !signedIn);
    loginForm.classList.toggle('hidden', signedIn);
    syncDirtyUi();

    if (signedIn) await startEditor();
  }

  onAuthChange(() => boot());
  boot();
</script>