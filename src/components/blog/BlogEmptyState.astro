<div class="dashboard-panel max-w-2xl mx-auto my-8 p-8 flex flex-col items-center text-center">
  <div class="w-16 h-16 rounded-full border border-emerald-500/30 bg-emerald-500/10 flex items-center justify-center mb-6">
    <svg class="w-8 h-8 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
    </svg>
  </div>

  <h1 class="text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white mb-2 font-mono tracking-tight">
    Technical Blog
  </h1>

  <p class="text-zinc-600 dark:text-zinc-400 text-sm md:text-base mb-6 font-mono">
    Articles are coming soon.
  </p>

  <!-- Terminal-inspired visual block -->
  <div class="w-full bg-slate-50 dark:bg-black border border-zinc-200 dark:border-zinc-800 rounded-lg p-4 font-mono text-left text-xs text-zinc-600 dark:text-zinc-400 shadow-inner overflow-x-auto mb-6">
    <div class="text-blue-600 dark:text-blue-400 mb-1">ntquan@devops-engineer:~$ ls -la /var/log/blog/articles/</div>
    <div class="text-zinc-500">total 0</div>
    <div class="text-zinc-500">drwxr-xr-x 2 quan sysadmin 4096 Nov 09 15:23 .</div>
    <div class="text-zinc-500">drwxr-xr-x 4 quan sysadmin 4096 Nov 09 15:23 ..</div>
    <div class="text-emerald-600 dark:text-emerald-400 mt-2 font-bold">[INFO] 0 published articles found.</div>
    <div class="text-zinc-500">[PIPELINE] Editorial pipeline initialized and awaiting MDX commits.</div>
    <div class="text-emerald-600 dark:text-emerald-400 mt-1 flex items-center">
      <span>ntquan@devops-engineer:~$</span>
      <span class="blinking-cursor ml-1"></span>
    </div>
  </div>

  <a
    href="/"
    class="px-4 py-2 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 text-xs font-mono border border-zinc-300 dark:border-zinc-700 transition flex items-center gap-2"
