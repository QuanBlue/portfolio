---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const links = [
  { href: '/#gallery', label: 'Gallery' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#skills', label: 'Skills' },
  { href: '/blog', label: 'Blog', active: currentPath.startsWith('/blog') },
];
---

<header class="sticky top-0 z-40 px-3 pt-3">
  <nav
    class="mx-auto max-w-6xl card !rounded-full flex items-center justify-between gap-4 pl-5 pr-2 py-2 shadow-lg shadow-black/5"
    aria-label="Main"
  >
    <a href="/" class="flex items-center gap-2 font-display font-bold text-[var(--heading)]">
      <img src="/logo.svg" alt="" class="w-6 h-6" width="24" height="24" />
      <span id="hdr-brand" class="font-mono text-sm tracking-tight">ntquan<span class="text-emerald-500">_</span>devops</span>
    </a>

    <ul class="hidden md:flex items-center gap-1 text-sm">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class={`px-3 py-1.5 rounded-full transition-colors hover:text-[var(--heading)] hover:bg-black/5 dark:hover:bg-white/5 ${
              l.active ? 'text-[var(--heading)] bg-black/5 dark:bg-white/5' : 'text-[var(--text-body)]'
            }`}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1">
      <a
        href="/admin"
        class={`inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-mono border transition-colors ${
          currentPath.startsWith('/admin')
            ? 'text-emerald-600 dark:text-emerald-400 border-emerald-500/40 bg-emerald-500/10'
            : 'text-[var(--text-body)] border-[var(--panel-border)] hover:text-[var(--heading)] hover:border-emerald-500/50'
        }`}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
        <span id="hdr-admin-label">Login</span>
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="w-9 h-9 flex items-center justify-center rounded-full text-[var(--text-body)] hover:bg-black/5 dark:hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Toggle theme"
      >
        <svg id="theme-toggle-dark-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
        <svg id="theme-toggle-light-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var darkIcon = document.getElementById('theme-toggle-dark-icon');
    var lightIcon = document.getElementById('theme-toggle-light-icon');
    var sync = function () {
      var isDark = document.documentElement.classList.contains('dark');
      if (lightIcon) lightIcon.classList.toggle('hidden', !isDark);
      if (darkIcon) darkIcon.classList.toggle('hidden', isDark);
    };
    sync();
    var btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', function () {
        var nowDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('color-theme', nowDark ? 'dark' : 'light');
        sync();
      });
    }
  })();
</script>
