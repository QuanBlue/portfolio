---
import { portfolioData } from '../../data/portfolio';
import LanguageSwitcher from '../common/LanguageSwitcher.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navSections = [
  { id: 'about', href: '/#about', label: 'About', ffLabel: 'about' },
  { id: 'projects', href: '/#projects', label: 'Projects', ffLabel: 'projects' },
  { id: 'experience', href: '/#experience', label: 'Experience', ffLabel: 'experience' },
  { id: 'skills', href: '/#skills', label: 'Skills', ffLabel: 'skills' },
  { id: 'contact', href: '/#contact', label: 'Contact', ffLabel: 'contact' },
];
---

<header id="site-header" class="nav-enter sticky inset-x-0 top-0 z-50 border-b border-transparent transition-all duration-200">
  <nav class="relative mx-auto flex h-16 max-w-[76rem] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="Main">
    <!-- Brand Logo: Switches based on data-portfolio-theme -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <img
        src="/logo.svg"
        alt="Quan DevOps"
        class="size-8 shrink-0 transition-transform duration-200 group-hover:scale-105"
        width="32"
        height="32"
      />
      <div class="leading-tight">
        <span id="hdr-brand-name" class="font-mono text-xs font-bold tracking-wider text-[var(--fg)] block">
          THANH QUÂN
        </span>
        <span id="hdr-brand-sub" class="text-[10px] font-mono font-medium text-[var(--muted-fg)] block">
          DEVOPS · SRE
        </span>
      </div>
    </a>

    <!-- Center Navigation -->
    <ul id="nav-list" class="relative hidden items-center gap-1 lg:flex font-mono text-xs">
      {navSections.map((item) => (
        <li>
          <a
            href={item.href}
            data-section={item.id}
            class="nav-link ff-br inline-flex h-9 items-center rounded-lg px-2.5 font-medium text-[var(--muted-fg)] hover:text-[var(--fg)] transition"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Sliding Active Tab Indicator (for Editorial theme) -->
    <span id="tab-indicator" class="tab-indicator hidden" aria-hidden="true"></span>

    <!-- Right Controls: Theme Variant Switcher, Blog, Admin, Light/Dark, Contact CTA -->
    <div class="flex items-center gap-1.5 shrink-0">
      <!-- Quick Theme Variant Switcher Pill -->
      <button
        id="theme-variant-toggle"
        type="button"
        class="inline-flex h-8 items-center gap-1 px-2.5 rounded-lg border border-[var(--border)] bg-[var(--card)] font-mono text-[11px] text-[var(--muted-fg)] hover:border-[var(--signal)] hover:text-[var(--fg)] cursor-pointer transition"
        title="Đổi giao diện: ASCII ⇄ Forkfolio ⇄ Editorial"
        aria-label="Toggle portfolio layout style"
      >
        <span class="text-[var(--signal)]">❖</span>
        <span id="theme-variant-label" class="font-semibold">ASCII</span>
      </button>

      <!-- Global Language Switcher (EN | VI) -->
      <LanguageSwitcher variant="standard" />

      <a
        href="/blog"
        class={`inline-flex h-9 items-center justify-center rounded-lg px-2.5 font-mono text-xs font-semibold transition ${
          currentPath.startsWith('/blog')
            ? 'bg-[var(--muted-bg)] text-[var(--fg)]'
            : 'text-[var(--muted-fg)] hover:bg-[var(--muted-bg)] hover:text-[var(--fg)]'
        }`}
      >
        Blog
      </a>

      <a
        href="/admin"
        id="hdr-admin-link"
        title="Admin Dashboard (Quản trị & Đổi theme)"
        class={`inline-flex h-9 items-center gap-1.5 rounded-lg border px-2 sm:px-2.5 font-mono text-xs font-semibold transition ${
          currentPath.startsWith('/admin')
            ? 'border-[var(--signal)] bg-[var(--muted-bg)] text-[var(--signal)]'
            : 'border-[var(--border)] bg-[var(--card)] text-[var(--muted-fg)] hover:bg-[var(--muted-bg)] hover:text-[var(--fg)]'
        }`}
      >
        <svg class="size-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span id="hdr-admin-label">Admin</span>
        <span id="hdr-admin-dot" class="hidden size-1.5 rounded-full bg-emerald-500 shadow-[0_0_6px_#10b981]" aria-hidden="true"></span>
      </a>

      <!-- Dark / Light theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch light / dark theme"
        class="inline-flex size-9 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--card)] text-[var(--fg)] hover:bg-[var(--muted-bg)] active:scale-95 cursor-pointer transition"
        title="Đổi chế độ Sáng / Tối"
      >
        <span id="theme-icon" class="text-xs">🌙</span>
      </button>

      <a
        href="/#contact"
        class="ml-1 hidden sm:inline-flex h-9 items-center gap-1.5 rounded-lg bg-[var(--fg)] px-3.5 font-mono text-xs font-medium text-[var(--bg)] hover:opacity-90 active:scale-[0.98] transition"
      >
        <span>[ contact ]</span>
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    // 1. Dark / Light Mode Sync
    var icon = document.getElementById('theme-icon');
    var syncThemeIcon = function () {
      var isDark = document.documentElement.classList.contains('dark');
      if (icon) icon.textContent = isDark ? '🌙' : '☀️';
    };
    syncThemeIcon();

    var btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', function () {
        var nowDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('color-theme', nowDark ? 'dark' : 'light');
        syncThemeIcon();
      });
    }

    // 2. Active Section Tracker on Scroll
    var sections = ['about', 'projects', 'experience', 'education', 'skills', 'contact'];
    var navLinks = document.querySelectorAll('.nav-link');
    var tabIndicator = document.getElementById('tab-indicator');

    function onHeaderScroll() {
      var h = document.documentElement;
      var pct = (h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight)) * 100;
      var bar = document.getElementById('scrollProgress');
      if (bar) bar.style.width = pct + '%';

      var header = document.getElementById('site-header');
      if (header) {
        if (window.scrollY > 16) {
          header.classList.add('bg-[var(--bg)]/90', 'backdrop-blur-md', 'border-[var(--border)]');
          header.classList.remove('border-transparent');
        } else {
          header.classList.remove('bg-[var(--bg)]/90', 'backdrop-blur-md', 'border-[var(--border)]');
          header.classList.add('border-transparent');
        }
      }

      var currentSection = '';
      var triggerY = window.innerHeight * 0.35;
      for (var i = 0; i < sections.length; i++) {
        var id = sections[i];
        var sec = document.getElementById(id);
        if (sec) {
          var rect = sec.getBoundingClientRect();
          if (rect.top <= triggerY && rect.bottom >= 120) {
            currentSection = id;
          }
        }
      }
      navLinks.forEach(function (link) {
        var isCurrent = link.dataset.section === currentSection;
        link.classList.toggle('text-[var(--fg)]', isCurrent);
        link.classList.toggle('text-[var(--muted-fg)]', !isCurrent);
      });
    }

    window.addEventListener('scroll', onHeaderScroll, { passive: true });
    window.addEventListener('resize', onHeaderScroll);
    onHeaderScroll();

    // 3. i18n Navigation Links & Admin Label Sync
    var navTranslations = {
      en: {
        about: 'About',
        projects: 'Projects',
        experience: 'Experience',
        education: 'Education',
        skills: 'Skills',
        contact: 'Contact',
        admin: 'Admin',
      },
      vi: {
        about: 'Giới thiệu',
        projects: 'Dự án',
        experience: 'Kinh nghiệm',
        education: 'Học vấn',
        skills: 'Kỹ năng',
        contact: 'Liên hệ',
        admin: 'Quản trị',
      },
    };

    function updateHeaderLocale(locale) {
      var dict = navTranslations[locale] || navTranslations.en;
      document.querySelectorAll('#nav-list .nav-link').forEach(function (link) {
        var sec = link.dataset.section;
        if (sec && dict[sec]) {
          link.textContent = dict[sec];
        }
      });
      var adminLabel = document.getElementById('hdr-admin-label');
      if (adminLabel && dict.admin) {
        adminLabel.textContent = dict.admin;
      }
    }

    var initialLoc = localStorage.getItem('portfolio-locale') === 'vi' ? 'vi' : 'en';
    updateHeaderLocale(initialLoc);

    window.addEventListener('locale:changed', function (e) {
      var loc = (e && e.detail && e.detail.locale) || 'en';
      updateHeaderLocale(loc);
    });
  })();
</script>
