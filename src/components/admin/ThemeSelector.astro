---
import { getAllThemes, DEFAULT_THEME_ID } from '../../themes/core';
import type { ThemeDefinition, ThemeId } from '../../themes/core/types';

interface Props {
  currentTheme?: ThemeId;
}

const { currentTheme = DEFAULT_THEME_ID } = Astro.props;
const themes: ThemeDefinition[] = getAllThemes();
---

<div class="theme-selector-root space-y-4">
  <div class="flex items-center justify-between">
    <div>
      <h3 class="text-sm font-semibold text-[var(--heading)]">Giao diện hiển thị (Themes)</h3>
      <p class="text-xs text-[var(--muted)] mt-0.5">
        Chọn giao diện bạn muốn sử dụng. Bấm <b>Preview</b> để xem thử mà không thay đổi trang thật. Bấm <b>Select</b> và <b>Save changes</b> để xuất bản chính thức.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1" id="theme-cards-grid">
    {themes.map((t) => {
      const isSelected = t.id === currentTheme;
      return (
        <div
          class={`theme-card relative rounded-xl border p-4 transition-all duration-200 flex flex-col justify-between gap-3 ${
            isSelected
              ? 'border-emerald-500 bg-emerald-500/5 shadow-sm'
              : 'border-[var(--border)] bg-[var(--card)] hover:border-[var(--line-strong)]'
          }`}
          data-theme-card-id={t.id}
        >
          <div>
            <div class="flex items-start justify-between gap-2">
              <span class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--fg)]">
                {t.name}
              </span>
              <span
                class={`theme-badge px-2 py-0.5 rounded-full text-[10px] font-mono font-medium ${
                  isSelected ? 'bg-emerald-500/20 text-emerald-500' : 'bg-zinc-500/10 text-zinc-500'
                }`}
              >
                {isSelected ? '● Active' : 'Available'}
              </span>
            </div>
            <p class="text-xs text-[var(--muted)] mt-1.5 leading-relaxed">
              {t.description}
            </p>
          </div>

          <div class="flex items-center gap-2 pt-2 border-t border-[var(--border)] text-xs">
            <button
              type="button"
              class="theme-btn-select flex-1 py-1.5 px-3 rounded-lg border font-medium transition cursor-pointer text-center bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-800 dark:hover:bg-zinc-700"
              data-select-theme={t.id}
            >
              {isSelected ? 'Đang chọn' : 'Chọn theme này'}
            </button>
            <a
              href={`/?preview=${t.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="theme-btn-preview py-1.5 px-3 rounded-lg border border-[var(--border)] hover:bg-[var(--muted-bg)] font-medium transition cursor-pointer text-center"
              title="Mở tab mới xem trước dữ liệu thật"
            >
              Preview ↗
            </a>
          </div>
        </div>
      );
    })}
  </div>
</div>
