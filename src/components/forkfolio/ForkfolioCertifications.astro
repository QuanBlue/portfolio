---
import { portfolioData, type Certification } from '../../data/portfolio';
import { deriveShortHandle, renderForkfolioCertificationsHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';

interface Props {
  certifications?: Certification[];
}

const { certifications = portfolioData.certifications ?? [] } = Astro.props;
const shortHandle = deriveShortHandle(portfolioData);
---

<section
  id="certifications"
  class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]"
  data-terminal-section="certifications"
>
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Command Introduction -->
    <div class="space-y-2">
      <TerminalPrompt
        command="ls ~/certifications"
        user={shortHandle}
        host="portfolio"
        path="~"
        typeSpeed={28}
        typeDelay={100}
        id="cmd-certifications"
      />
      <div class="flex items-center justify-between pt-1">
        <h2 class="ff-cert-heading font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
          CERTIFICATIONS
        </h2>
        <span class="font-mono text-xs text-[var(--muted-fg)]">
          [04] ~/<span class="text-[var(--signal)]">certifications</span>
        </span>
      </div>
    </div>

    <!-- Output: Certifications modules grid -->
    <div
      class="ff-term-output grid grid-cols-1 md:grid-cols-2 gap-6"
      data-ff-certifications-list
      set:html={renderForkfolioCertificationsHtml(certifications, 'en')}
    />
  </div>
</section>
