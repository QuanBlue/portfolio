---
import { portfolioData, getCareerSettings } from '../../data/portfolio';
import { deriveShortHandle, renderForkfolioAboutSummaryHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';
const { identity, projects, skills, experience } = portfolioData;
const career = getCareerSettings(portfolioData);
const currentCompany = experience[0]?.company ?? '';
const shortHandle = deriveShortHandle(portfolioData);
---

<section
  id="about"
  class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]"
  data-terminal-section="about"
>
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Command Introduction -->
    <div class="space-y-2">
      <TerminalPrompt
        command="cat ~/about.md"
        user={shortHandle}
        host="portfolio"
        path="~"
        typeSpeed={28}
        typeDelay={100}
        id="cmd-about"
      />
      <div class="flex items-center justify-between pt-1">
        <h2 class="ff-about-heading font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
          ABOUT
        </h2>
        <span class="font-mono text-xs text-[var(--muted-fg)]">
          [01] ~/<span class="text-[var(--signal)]">about.md</span>
        </span>
      </div>
    </div>

    <!-- Output Content (Reveals after command typing) -->
    <div class="ff-term-output grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Narrative & Summary (lg:col-span-7) -->
      <div class="lg:col-span-7 space-y-5 text-sm sm:text-base text-[var(--muted-fg)] leading-relaxed font-mono">
        <p class="text-base sm:text-lg text-[var(--fg)] font-medium font-mono">
          &gt; <span data-bind="role">{identity.role}</span> <span data-bind-company data-company-prefix="@ " class={`text-[var(--signal)] font-bold ${currentCompany ? '' : 'hidden'}`}>{currentCompany ? `@ ${currentCompany}` : ''}</span>
        </p>

        <p data-bind="bio" class="whitespace-pre-line">
          {identity.bio}
        </p>

        <!-- 4 Data-Driven Terminal Summary Panels -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4" data-ff-about-summary set:html={renderForkfolioAboutSummaryHtml(portfolioData, 'en')} />
      </div>

      <!-- Right Published Specification Sheet Table (lg:col-span-5) -->
      <div class="lg:col-span-5">
        <div class="ff-cross-box rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 space-y-4 shadow-sm">
          <span class="ff-cross-tl">+</span>
          <span class="ff-cross-tr">+</span>
          <span class="ff-cross-bl">+</span>
          <span class="ff-cross-br">+</span>

          <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
            <h3 class="font-mono text-xs font-bold uppercase tracking-wider text-[var(--fg)]">
              // SPECIFICATION_DATA
            </h3>
            <span class="font-mono text-[11px] text-[var(--signal)] font-semibold" data-ff-about="badge">
              {career.openToWork ? '● OPEN TO WORK' : '● PUBLISHED'}
            </span>
          </div>

          <dl class="divide-y divide-[var(--border)] font-mono text-xs">
            <div class="py-2.5 flex justify-between gap-4">
              <dt class="text-[var(--muted-fg)]">Name</dt>
              <dd class="text-[var(--fg)] font-semibold text-right" data-ff-about="name">{identity.name}</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-4">
              <dt class="text-[var(--muted-fg)]">Role</dt>
              <dd class="text-[var(--fg)] font-semibold text-right" data-bind="role">{identity.role}</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-4">
              <dt class="text-[var(--muted-fg)]">Organization</dt>
              <dd class="text-[var(--fg)] font-semibold text-right" data-ff-about="org">{currentCompany || '—'}</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-4">
              <dt class="text-[var(--muted-fg)]">Location</dt>
              <dd class="text-[var(--fg)] font-semibold text-right" data-bind="location">{identity.location}</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-4">
              <dt class="text-[var(--muted-fg)]">Node</dt>
              <dd class="text-[var(--fg)] font-semibold text-right" data-bind="node">{identity.node}</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-4">
              <dt class="text-[var(--muted-fg)]">Projects / Skills</dt>
              <dd class="text-[var(--fg)] font-semibold text-right" data-ff-about="projectsSkills">{`${projects.length} / ${skills.length}`}</dd>
            </div>
            <div class="py-2.5 flex justify-between gap-4">
              <dt class="text-[var(--muted-fg)]">Career Status</dt>
              <dd class="text-[var(--signal)] font-bold text-right" data-ff-about="careerStatus">{career.openToWork ? 'Open to Work' : 'Focused'}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>
