---
import { portfolioData } from '../../data/portfolio';
import { getKnightActivity } from '../../themes/core/data-adapter';
import { deriveShortHandle, renderForkfolioActivityHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';

const shortHandle = deriveShortHandle(portfolioData);
const activity = getKnightActivity(portfolioData);
---

<section
  id="activity"
  class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]"
  data-terminal-section="activity"
>
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Command Introduction -->
    <div class="space-y-2">
      <TerminalPrompt
        command="git log --since=1.year --stat"
        user={shortHandle}
        host="portfolio"
        path="~"
        typeSpeed={28}
        typeDelay={100}
        id="cmd-activity"
      />
      <div class="flex items-center justify-between pt-1">
        <h2 class="ff-act-heading font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
          ACTIVITY &amp; TELEMETRY
        </h2>
        <span class="font-mono text-xs text-[var(--muted-fg)]">
          [06] ~/activity · <span data-ff-activity-meta>{activity ? `${activity.totalContributions} contributions` : 'portfolio index'}</span>
        </span>
      </div>
    </div>

    <!-- Output: Factual Portfolio Cards & Configured Heatmap -->
    <div class="ff-term-output space-y-8" data-ff-activity-body set:html={renderForkfolioActivityHtml(portfolioData, 'en')} />
  </div>
</section>
