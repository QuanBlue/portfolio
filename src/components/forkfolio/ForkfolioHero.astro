---
import { portfolioData, getCareerSettings } from '../../data/portfolio';
import { renderAvatar, safeUrl } from '../../lib/render';
import { deriveShortHandle, renderForkfolioQuickProjectsHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';
import TerminalStatus from './terminal/TerminalStatus.astro';
import './terminal/terminal.css';

const { identity, projects, skills, experience } = portfolioData;
const career = getCareerSettings(portfolioData);
const showCv = career.openToWork && Boolean(career.cvUrl);
const currentCompany = experience[0]?.company ?? '';
const shortHandle = deriveShortHandle(portfolioData);
---

<section id="top" class="relative pt-10 pb-16 sm:pt-16 sm:pb-24 border-b border-[var(--border)] overflow-hidden" data-terminal-section="hero" data-terminal-state="ready">
  <!-- Subtle sunken background grid with soft radial mask -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] bg-[size:3.5rem_3.5rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-20 pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8">
    <!-- Terminal Startup Session Status -->
    <div class="ff-hero-boot pb-6 mb-6 border-b border-[var(--border)]/70">
      <TerminalStatus
        lines={[
          { status: 'OK', text: 'Loaded profile', target: shortHandle, bindTarget: 'handle' },
          { status: 'OK', text: 'Started session', target: `${shortHandle}@portfolio`, bindTarget: 'prompt' },
        ]}
      />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      <!-- Left Hero Terminal Presentation (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-6">
        <!-- 1. Primary Command Prompt: whoami -->
        <TerminalPrompt
          command="whoami"
          user={shortHandle}
          host="portfolio"
          path="~"
          typeSpeed={35}
          typeDelay={150}
          id="hero-cmd-whoami"
        />

        <!-- Command Output (Revealed after typing) -->
        <div class="ff-term-output space-y-5">
          <!-- Big Bold Headline Name & Role -->
          <div class="space-y-1.5">
            <h1 class="font-mono text-4xl sm:text-6xl md:text-7xl font-black uppercase tracking-tight text-[var(--fg)] leading-[1.02]">
              <span class="block" data-bind="name">{identity.name}</span>
            </h1>
            <p class="font-mono text-base sm:text-xl font-bold text-[var(--signal)] tracking-tight">
              <span data-bind="role">{identity.role}</span>
              <span data-bind-company data-company-prefix=" @ " class={`text-[var(--muted-fg)] font-medium ${currentCompany ? '' : 'hidden'}`}>{currentCompany ? ` @ ${currentCompany}` : ''}</span>
            </p>
          </div>

          <!-- Bio text -->
          <p data-bind="bio" class="text-sm sm:text-base text-[var(--muted-fg)] leading-relaxed max-w-2xl font-mono">
            {identity.bio}
          </p>

          <!-- Monospace Action Buttons / Links in Forkfolio Bracket Style -->
          <div class="flex flex-wrap items-center gap-2.5 pt-2">
            <a href="#projects" class="ff-btn ff-btn-primary">
              <span>[ view_projects → ]</span>
            </a>
            <a href="#experience" class="ff-btn">
              <span>[ career_path ↓ ]</span>
            </a>
            <button
              type="button"
              data-open-cv="1"
              data-cv-gate
              class={`ff-btn text-[var(--signal)] border-[var(--signal)]/40 hover:bg-emerald-500/10 cursor-pointer ${showCv ? '' : 'hidden'}`}
            >
              <i class="fa-regular fa-file-lines text-xs"></i>
              <span>[ view_cv.pdf ]</span>
            </button>
            <a
              data-bind="github"
              href={safeUrl(identity.github.url)}
              target="_blank"
              rel="noopener noreferrer"
              class="ff-btn"
            >
              <i class="fa-brands fa-github text-xs"></i>
              <span>[ github: <span data-bind-handle="github">{identity.github.handle}</span> ↗ ]</span>
            </a>
            <a
              data-bind="linkedin"
              href={safeUrl(identity.linkedin.url)}
              target="_blank"
              rel="noopener noreferrer"
              class="ff-btn"
            >
              <i class="fa-brands fa-linkedin text-xs"></i>
              <span>[ linkedin: <span data-bind-handle="linkedin">{identity.linkedin.handle}</span> ↗ ]</span>
            </a>
          </div>

          <!-- Secondary Quick Preview Command: ls -t ~/projects | head -3 -->
          <div class="pt-4 border-t border-[var(--border)] space-y-3">
            <div class="flex items-center gap-2 text-xs font-mono text-[var(--muted-fg)]">
              <span class="text-[var(--signal)] select-none">›</span>
              <span class="text-[var(--fg)] font-semibold">ls -t ~/projects | head -3</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 font-mono text-xs" data-ff-quick-projects set:html={renderForkfolioQuickProjectsHtml(projects)} />
          </div>

          <!-- System Session Ticker (Factual Published Portfolio State Only) -->
          <div class="pt-3 border-t border-[var(--border)] flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[11px] text-[var(--muted-fg)]">
            <span class="inline-flex items-center gap-1.5 text-[var(--signal)] font-semibold">
              <span class="size-1.5 rounded-full bg-[var(--signal)] animate-pulse"></span>
              SESSION: ACTIVE
            </span>
            <span>·</span>
            <span>NODE: <strong class="text-[var(--fg)]" data-bind="node">{identity.node}</strong></span>
            <span>·</span>
            <span>PROJECTS: <strong class="text-[var(--fg)]" data-ff-stat="projects">{projects.length}</strong></span>
            <span>·</span>
            <span>SKILLS: <strong class="text-[var(--signal)]" data-ff-stat="skills">{skills.length}</strong></span>
          </div>
        </div>
      </div>

      <!-- Right Column: Avatar Plate with Forkfolio Corner Crosshairs (lg:col-span-4) -->
      <div class="lg:col-span-4 flex justify-center lg:justify-end">
        <div class="ff-cross-box w-full max-w-xs p-5 rounded-2xl border border-[var(--border)] bg-[var(--card)] shadow-lg shadow-black/5">
          <!-- 4 Corner Crosshairs (+) -->
          <span class="ff-cross-tl">+</span>
          <span class="ff-cross-tr">+</span>
          <span class="ff-cross-bl">+</span>
          <span class="ff-cross-br">+</span>

          <!-- Header info on avatar plate -->
          <div class="flex items-center justify-between pb-3 mb-3 border-b border-[var(--border)] font-mono text-[11px] text-[var(--muted-fg)]">
            <span class="font-bold text-[var(--fg)]">[ PROFILE_NODE ]</span>
            <span class="text-[var(--signal)] font-semibold">● PUBLISHED</span>
          </div>

          <!-- Avatar Image -->
          <div class="aspect-square w-full rounded-xl overflow-hidden border border-[var(--border)] bg-[var(--muted-bg)] relative group">
            <div
              id="bind-avatar-forkfolio"
              set:html={renderAvatar(identity)}
              class="w-full h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover"
            ></div>
          </div>

          <!-- Footer Metadata on plate -->
          <div class="mt-4 pt-3 border-t border-[var(--border)] flex items-center justify-between text-xs font-mono text-[var(--muted-fg)]">
            <div class="flex items-center gap-1.5 truncate">
              <i class="fa-solid fa-location-dot text-[var(--signal)] text-[10px]"></i>
              <span data-bind="location" class="truncate">{identity.location}</span>
            </div>
            <span class="text-[10px] text-[var(--faint)]" data-ff-handle-tag>{`@${shortHandle}`}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
