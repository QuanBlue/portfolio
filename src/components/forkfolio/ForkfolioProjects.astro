---
import { portfolioData } from '../../data/portfolio';
import { safeUrl } from '../../lib/render';
const { projects } = portfolioData;
---

<section id="projects" class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Header with 01 / 02 counter -->
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="space-y-2">
        <div class="font-mono text-xs text-[var(--signal)] tracking-wider">// 02. PROJECTS</div>
        <h2 class="font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
          PROJECTS
        </h2>
      </div>
      <div class="font-mono text-sm text-[var(--muted-fg)]">
        <span>01</span> / <span>{String(projects.length).padStart(2, '0')}</span>
      </div>
    </div>

    <!-- Project List (Forkfolio Project Plates) -->
    <div class="space-y-8">
      {projects.map((p, idx) => {
        const initials = p.title.replace(/[^a-zA-Z]/g, '').slice(0, 2).toUpperCase() || 'PR';
        const num = String(idx + 1).padStart(2, '0');
        const total = String(projects.length).padStart(2, '0');
        return (
          <article class="ff-cross-box rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 sm:p-8 hover:border-[var(--line-strong)] transition shadow-sm">
            <span class="ff-cross-tl">+</span>
            <span class="ff-cross-tr">+</span>
            <span class="ff-cross-bl">+</span>
            <span class="ff-cross-br">+</span>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              <!-- Left Project Details (lg:col-span-8) -->
              <div class="lg:col-span-8 space-y-4">
                <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-[var(--muted-fg)]">
                  <span class="font-bold text-[var(--signal)]">{num} / {total}</span>
                  <span>·</span>
                  <span class="uppercase tracking-wider">{p.status === 'ONLINE' ? '● PRODUCTION ACTIVE' : 'MAINTENANCE'}</span>
                </div>

                <h3 class="font-mono text-2xl sm:text-3xl font-black uppercase tracking-tight text-[var(--fg)]">
                  {p.title}
                </h3>

                <p class="text-sm sm:text-base text-[var(--muted-fg)] leading-relaxed font-sans">
                  {p.description || p.shortDesc}
                </p>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2 pt-2">
                  {p.tags.map((tag) => (
                    <span class="ff-tag">
                      <span class="text-[var(--signal)]">#</span>
                      <span>{tag}</span>
                    </span>
                  ))}
                </div>

                <!-- Action links -->
                <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-[var(--border)]">
                  <a
                    href={safeUrl(p.link)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ff-btn ff-btn-primary"
                  >
                    <span>[ view_repository ↗ ]</span>
                  </a>

                  <button
                    type="button"
                    data-project-trigger={p.id}
                    class="ff-btn"
                  >
                    <span>[ view_details_modal ]</span>
                  </button>
                </div>
              </div>

              <!-- Right Project Monospace Plate / Initials (lg:col-span-4) -->
              <div class="lg:col-span-4 flex justify-center lg:justify-end">
                <div class="w-full sm:w-64 aspect-video sm:aspect-square rounded-xl border border-dashed border-[var(--line-strong)] bg-[var(--muted-bg)]/60 flex flex-col items-center justify-center p-6 text-center group">
                  <span class="font-mono text-4xl sm:text-6xl font-black text-[var(--fg)] tracking-tight group-hover:text-[var(--signal)] transition-colors">
                    {initials}
                  </span>
                  <span class="font-mono text-xs text-[var(--muted-fg)] mt-2">
                    {p.tags[0] || 'DevOps'} · {p.status}
                  </span>
                  <span class="font-mono text-[11px] text-[var(--signal)] mt-1 opacity-80">
                    github.com/QuanBlue/{p.title}
                  </span>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
