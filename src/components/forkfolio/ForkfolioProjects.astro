---
import { portfolioData } from '../../data/portfolio';
import { deriveShortHandle, renderForkfolioProjectsHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';
import type { Project } from '../../data/portfolio';

interface Props {
  projects?: Project[];
}

const { projects = portfolioData.projects ?? [] } = Astro.props;
const featuredProjects = projects.length > 4 ? projects.slice(0, 4) : projects;
const shortHandle = deriveShortHandle(portfolioData);
---

<section
  id="projects"
  class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]"
  data-terminal-section="projects"
>
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Terminal Command Introduction -->
    <div class="space-y-2">
      <TerminalPrompt
        command="ls ~/projects"
        user={shortHandle}
        host="portfolio"
        path="~"
        typeSpeed={30}
        typeDelay={100}
        id="cmd-projects"
      />
      <div class="flex flex-wrap items-end justify-between gap-4 pt-1">
        <h2 class="ff-proj-heading font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
          PROJECTS
        </h2>
        <div class="font-mono text-xs text-[var(--muted-fg)]">
          <span class="text-[var(--signal)] font-bold">[1]</span> <span data-ff-projects-count>{featuredProjects.length} featured repositories</span>
        </div>
      </div>
    </div>

    <!-- Project List with Terminal Output -->
    <div
      class="ff-term-output space-y-10"
      data-ff-projects-list
      set:html={renderForkfolioProjectsHtml(projects, portfolioData.identity.github?.handle || '', 'en', false)}
    />
  </div>
</section>
