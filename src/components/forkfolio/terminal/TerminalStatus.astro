---
interface Props {
  lines: Array<{
    status?: string;
    text: string;
    target?: string;
    bindTarget?: 'handle' | 'prompt';
  }>;
  class?: string;
}

const { lines, class: className = '' } = Astro.props;
---

<div class={`space-y-1 font-mono text-xs ${className}`}>
  {lines.map((line) => (
    <div class="ff-term-status flex items-center gap-2">
      <span class="ff-term-ok">[{line.status || 'OK'}]</span>
      <span class="text-[var(--muted-fg)]">
        {line.text}{line.target && ' '}
        {line.target && (
          <span
            class="text-[var(--signal)] font-semibold"
            data-ff-shell-handle={line.bindTarget === 'handle' ? '' : undefined}
            data-ff-shell-prompt={line.bindTarget === 'prompt' ? '' : undefined}
          >{line.target}</span>
        )}
      </span>
    </div>
  ))}
</div>
