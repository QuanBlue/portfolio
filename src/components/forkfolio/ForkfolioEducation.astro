---
import { portfolioData, type EducationItem } from '../../data/portfolio';
import { deriveShortHandle, renderForkfolioEducationHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';

interface Props {
  education?: EducationItem[];
}

const { education = portfolioData.education ?? [] } = Astro.props;
const shortHandle = deriveShortHandle(portfolioData);
---

<section
  id="education"
  class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]"
  data-terminal-section="education"
>
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Command Introduction -->
    <div class="space-y-2">
      <TerminalPrompt
        command="cat ~/education.md"
        user={shortHandle}
        host="portfolio"
        path="~"
        typeSpeed={28}
        typeDelay={100}
        id="cmd-education"
      />
      <div class="flex items-center justify-between pt-1">
        <h2 class="ff-edu-heading font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
          EDUCATION
        </h2>
        <span class="font-mono text-xs text-[var(--muted-fg)]">
          [03] ~/<span class="text-[var(--signal)]">education.md</span>
        </span>
      </div>
    </div>

    <!-- Output: Education editorial cards grid -->
    <div
      class="ff-term-output grid grid-cols-1 md:grid-cols-2 gap-6"
      data-ff-education-list
      set:html={renderForkfolioEducationHtml(education, 'en')}
    />
  </div>
</section>
