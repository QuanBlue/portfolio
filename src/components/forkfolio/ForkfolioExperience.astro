---
import { portfolioData, type ExperienceItem } from '../../data/portfolio';
import { deriveShortHandle, renderForkfolioExperienceHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';

interface Props {
  experience?: ExperienceItem[];
}

const { experience = portfolioData.experience ?? [] } = Astro.props;
const shortHandle = deriveShortHandle(portfolioData);
---

<section
  id="experience"
  class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]"
  data-terminal-section="experience"
>
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Command Introduction -->
    <div class="space-y-2">
      <TerminalPrompt
        command="cat ~/career.log"
        user={shortHandle}
        host="portfolio"
        path="~"
        typeSpeed={28}
        typeDelay={100}
        id="cmd-experience"
      />
      <div class="flex items-center justify-between pt-1">
        <h2 class="ff-exp-heading font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
          EXPERIENCE
        </h2>
        <span class="font-mono text-xs text-[var(--muted-fg)]">
          [02] ~/<span class="text-[var(--signal)]">career.log</span>
        </span>
      </div>
    </div>

    <!-- Output: Clean Vertical Monospace Timeline -->
    <div
      class="ff-term-output relative pl-6 sm:pl-10 before:absolute before:left-2.5 sm:before:left-4 before:top-3 before:bottom-3 before:w-px before:bg-[var(--border)] space-y-8"
      data-ff-experience-list
      set:html={renderForkfolioExperienceHtml(experience, 'en')}
    />
  </div>
</section>
