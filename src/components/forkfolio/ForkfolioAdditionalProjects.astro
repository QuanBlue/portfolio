---
import { portfolioData, type Project } from '../../data/portfolio';
import { deriveShortHandle, renderForkfolioMoreProjectsHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';

interface Props {
  projects?: Project[];
}

const { projects = portfolioData.projects ?? [] } = Astro.props;
const moreProjects = projects.length > 4 ? projects.slice(4) : [];
const hasAdditional = moreProjects.length > 0;
const shortHandle = deriveShortHandle(portfolioData);
---

<section
  id="more-projects"
  class={`scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)] ${hasAdditional ? '' : 'hidden'}`}
  data-terminal-section="more-projects"
>
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Terminal Command Introduction -->
    <div class="space-y-2">
      <TerminalPrompt
        command="ls -la ~/src"
        user={shortHandle}
        host="portfolio"
        path="~"
        typeSpeed={28}
        typeDelay={100}
        id="cmd-more-projects"
      />
      <div class="flex flex-wrap items-end justify-between gap-4 pt-1">
        <h2 class="ff-more-heading font-mono text-2xl sm:text-4xl font-black uppercase tracking-tight text-[var(--fg)]">
          MORE PROJECTS
        </h2>
        <div class="font-mono text-xs text-[var(--muted-fg)]">
          <span data-ff-more-count>total {moreProjects.length}</span>
        </div>
      </div>
    </div>

    <!-- Output: Desktop Compact Table & Mobile Stacked Rows -->
    <div
      class="ff-term-output space-y-4"
      data-ff-more-projects-body
      set:html={renderForkfolioMoreProjectsHtml(projects, 'en')}
    />
  </div>
</section>
