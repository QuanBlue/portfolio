---
import { portfolioData } from '../../data/portfolio';
import { safeUrl } from '../../lib/render';
const { identity } = portfolioData;
---

<section id="contact" class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Header -->
    <div class="space-y-2">
      <div class="font-mono text-xs text-[var(--signal)] tracking-wider">// 07. CONTACT</div>
      <h2 class="font-mono text-3xl sm:text-6xl font-black uppercase tracking-tight text-[var(--fg)]">
        LET'S TALK.
      </h2>
      <p class="text-sm sm:text-base text-[var(--muted-fg)] max-w-xl font-sans">
        Luôn sẵn sàng trao đổi về kiến trúc Kubernetes HA, hạ tầng mạng Linux vật lý hoặc cơ hội hợp tác mới.
      </p>
    </div>

    <!-- Contact Actions in Forkfolio Monospace Style -->
    <div class="ff-cross-box rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 sm:p-10 space-y-8">
      <span class="ff-cross-tl">+</span>
      <span class="ff-cross-tr">+</span>
      <span class="ff-cross-bl">+</span>
      <span class="ff-cross-br">+</span>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <a
          data-bind="email"
          href={`mailto:${identity.email}`}
          class="p-5 rounded-xl border border-[var(--border)] bg-[var(--muted-bg)]/40 hover:border-[var(--signal)] hover:bg-[var(--muted-bg)] transition group flex items-start justify-between"
        >
          <div>
            <span class="font-mono text-xs text-[var(--signal)] block mb-1">[ DIRECT_EMAIL ]</span>
            <span class="font-mono text-sm sm:text-base font-bold text-[var(--fg)] group-hover:text-[var(--signal)] transition-colors">
              {identity.email}
            </span>
          </div>
          <span class="font-mono text-xs text-[var(--muted-fg)] group-hover:translate-x-1 transition-transform">→</span>
        </a>

        <a
          data-bind="linkedin"
          href={safeUrl(identity.linkedin.url)}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-xl border border-[var(--border)] bg-[var(--muted-bg)]/40 hover:border-[var(--signal)] hover:bg-[var(--muted-bg)] transition group flex items-start justify-between"
        >
          <div>
            <span class="font-mono text-xs text-[var(--signal)] block mb-1">[ PROFESSIONAL_NETWORK ]</span>
            <span class="font-mono text-sm sm:text-base font-bold text-[var(--fg)] group-hover:text-[var(--signal)] transition-colors">
              LinkedIn ({identity.linkedin.handle})
            </span>
          </div>
          <span class="font-mono text-xs text-[var(--muted-fg)] group-hover:translate-x-1 transition-transform">↗</span>
        </a>
      </div>

      <!-- Action tags row -->
      <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-[var(--border)]">
        <button
          type="button"
          data-open-cv="1"
          class="ff-btn text-[var(--signal)] border-[var(--signal)]/40 hover:bg-emerald-500/10"
        >
          <i class="fa-regular fa-file-lines text-xs"></i>
          <span>[ view_cv_document ]</span>
        </button>

        <a
          data-bind="github"
          href={safeUrl(identity.github.url)}
          target="_blank"
          rel="noopener noreferrer"
          class="ff-btn"
        >
          <i class="fa-brands fa-github text-xs"></i>
          <span>[ github: @QuanBlue ↗ ]</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Clean Monospace Footer -->
<footer class="py-12 border-t border-[var(--border)] font-mono text-xs text-[var(--muted-fg)]">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        © {new Date().getFullYear()} <strong class="text-[var(--fg)]"><span data-bind="name">{identity.name}</span></strong> · thanhquan.dev
      </div>

      <div class="flex items-center gap-4">
        <a data-bind="github" href={safeUrl(identity.github.url)} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--fg)] transition">
          [ github ]
        </a>
        <a data-bind="linkedin" href={safeUrl(identity.linkedin.url)} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--fg)] transition">
          [ linkedin ]
        </a>
        <a href="/blog" class="hover:text-[var(--fg)] transition">
          [ blog ]
        </a>
        <a href="/admin" class="hover:text-[var(--fg)] transition">
          [ admin ]
        </a>
      </div>
    </div>

    <div class="flex items-center justify-between pt-3 border-t border-[var(--border)] text-[10px] text-[var(--faint)]">
      <span>THEME: FORKFOLIO_MODERN_MONO</span>
      <span class="tracking-widest select-none">+ + + +</span>
    </div>
  </div>
</footer>
