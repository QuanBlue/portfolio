---
import { portfolioData, type Skill } from '../../data/portfolio';
import { deriveShortHandle, renderForkfolioSkillsHtml } from './forkfolio-renderers';
import TerminalPrompt from './terminal/TerminalPrompt.astro';

interface Props {
  skills?: Skill[];
}

const { skills = portfolioData.skills ?? [] } = Astro.props;
const shortHandle = deriveShortHandle(portfolioData);
---

<section
  id="skills"
  class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)]"
  data-terminal-section="skills"
>
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Command Introduction -->
    <div class="space-y-2">
      <TerminalPrompt
        command="brew bundle"
        user={shortHandle}
        host="portfolio"
        path="~"
        typeSpeed={28}
        typeDelay={100}
        id="cmd-skills"
      />
      <div class="flex items-center justify-between pt-1">
        <h2 class="ff-skills-heading font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
          TECHNICAL SKILLS
        </h2>
        <span class="font-mono text-xs text-[var(--muted-fg)]">
          [05] ~/<span class="text-[var(--signal)]">skills</span> · <span data-ff-skills-count>{skills.length} installed</span>
        </span>
      </div>
    </div>

    <!-- Output: Minimal Grouped Skill Modules Grid -->
    <div class="ff-term-output space-y-6" data-ff-skills-body set:html={renderForkfolioSkillsHtml(skills, 'en')} />
  </div>
</section>
