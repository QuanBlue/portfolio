---
import { portfolioData } from '../../data/portfolio';
import { renderNameWords, safeUrl } from '../../lib/render';
const { identity } = portfolioData;
---

<section id="hero" class="relative isolate overflow-hidden">
  <!-- Nền chìm (Subtle Sunken Ambient Glow + Recessed Orbital Contour) -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div
      class="absolute top-1/2 left-[60%] -translate-x-1/2 -translate-y-1/2 w-[52rem] h-[36rem] rounded-full blur-3xl opacity-45"
      style="background: radial-gradient(circle, color-mix(in srgb, var(--signal) 9%, transparent) 0%, color-mix(in srgb, var(--primary) 5%, transparent) 45%, transparent 75%);"
    ></div>
    <svg
      viewBox="0 0 800 600"
      class="draw absolute top-1/2 left-1/2 lg:left-[62%] -translate-x-1/2 -translate-y-1/2 w-[56rem] max-w-none opacity-35"
      style="-webkit-mask-image: radial-gradient(ellipse at center, black 25%, transparent 70%); mask-image: radial-gradient(ellipse at center, black 25%, transparent 70%);"
      focusable="false"
    >
      <circle cx="400" cy="300" r="140" pathLength="1" style="--k: 0" fill="none" stroke="var(--border)" />
      <circle cx="400" cy="300" r="220" pathLength="1" style="--k: 1" fill="none" stroke="var(--border)" stroke-dasharray="4 6" />
      <circle cx="400" cy="300" r="305" pathLength="1" style="--k: 2" fill="none" stroke="var(--border)" />
      <path d="M80,300 H720 M400,20 V580" pathLength="1" style="--k: 3" fill="none" stroke="var(--border)" opacity="0.55" />
    </svg>
  </div>

  <div class="mx-auto grid min-h-[90svh] max-w-[76rem] items-center gap-12 px-4 pt-12 pb-16 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:px-8">
    <!-- Left Column (lg:col-span-7) -->
    <div class="lg:col-span-7">
      <div class="enter inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--card)] px-3 py-1 text-xs font-mono text-[var(--muted-fg)] mb-5" style="--i: 1">
        <span class="size-2 rounded-full bg-[var(--signal)] animate-pulse"></span>
        <span><span data-bind="location">{identity.location}</span> · Available for Infrastructure Roles</span>
      </div>

      <h1 id="bind-hero-name" class="text-display text-[var(--fg)]" set:html={renderNameWords(identity.name)}></h1>

      <p class="enter text-h3 mt-4 text-[var(--fg)]" style="--i: 4">
        <span data-bind="role">{identity.role}</span> <span class="text-[var(--muted-fg)] font-normal">@ Viettel</span>
      </p>

      <p data-bind="bio" class="enter text-lead mt-4 max-w-[38rem] text-[var(--muted-fg)]" style="--i: 5">
        {identity.bio}
      </p>

      <!-- CTA Buttons + Social Icons -->
      <div class="enter mt-8 flex flex-wrap items-center gap-3" style="--i: 6">
        <a
          href="#experience"
          class="inline-flex h-12 items-center gap-2 rounded-xl bg-[var(--fg)] px-6 text-sm font-semibold text-[var(--bg)] hover:opacity-90 active:scale-[0.98] transition"
        >
          <span>Explore my journey</span>
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14m7-7l-7 7l-7-7"/></svg>
        </a>

        <a
          href="#projects"
          class="inline-flex h-12 items-center gap-2 rounded-xl border border-[var(--line-strong)] bg-[var(--card)] px-6 text-sm font-semibold text-[var(--fg)] hover:bg-[var(--muted-bg)] active:scale-[0.98] transition"
        >
          <span>See the projects</span>
        </a>

        <ul class="flex items-center gap-1 sm:ml-1">
          <li>
            <a data-bind="github" href={safeUrl(identity.github.url)} target="_blank" rel="noopener noreferrer" class="grid size-11 place-items-center rounded-xl text-[var(--muted-fg)] hover:bg-[var(--muted-bg)] hover:text-[var(--fg)] transition" aria-label="GitHub">
              <i class="fa-brands fa-github text-lg"></i>
            </a>
          </li>
          <li>
            <a data-bind="linkedin" href={safeUrl(identity.linkedin.url)} target="_blank" rel="noopener noreferrer" class="grid size-11 place-items-center rounded-xl text-[var(--muted-fg)] hover:bg-[var(--muted-bg)] hover:text-[var(--fg)] transition" aria-label="LinkedIn">
              <i class="fa-brands fa-linkedin text-lg"></i>
            </a>
          </li>
          <li>
            <a data-bind="email" data-bind-keep-text="true" href={`mailto:${identity.email}`} class="grid size-11 place-items-center rounded-xl text-[var(--muted-fg)] hover:bg-[var(--muted-bg)] hover:text-[var(--fg)] transition" aria-label="Email">
              <i class="fa-regular fa-envelope text-lg"></i>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Right Column (lg:col-span-5): Sơ đồ "How I ship" chuẩn ferhatsn.fr (Jenkins + SBOM + Sign & Verify) + Terminal Switcher -->
    <div class="enter lg:col-span-5" style="--i: 3">
      <figure class="map-ship panel relative overflow-hidden p-4 sm:p-5">
        <div class="flex items-center justify-between mb-5">
          <p class="text-sm font-semibold text-[var(--fg)]" id="hero-panel-label">How I ship</p>
          <div class="inline-flex rounded-lg border border-[var(--border)] bg-[var(--muted-bg)] p-0.5 font-mono text-[11px]">
            <button type="button" id="hw-btn-map" class="px-2.5 py-1 rounded-md bg-[var(--card)] text-[var(--fg)] font-semibold cursor-pointer transition">Pipeline</button>
            <button type="button" id="hw-btn-term" class="px-2.5 py-1 rounded-md text-[var(--muted-fg)] cursor-pointer transition">Terminal</button>
          </div>
        </div>

        <div class="grid grid-cols-1">
          <!-- VIEW A: EXACT "HOW I SHIP" DIAGRAM (git push -> Trivy + SBOM -> Sign + Verify -> Jenkins) -->
          <div id="hw-view-map" class="col-start-1 row-start-1 w-full transition-opacity duration-150">
          <div class="relative">
            <span class="flow flow-x" style="--d: 0s; --c: var(--signal)" aria-hidden="true"><i></i></span>
            <ol class="relative grid grid-cols-4 gap-2" aria-label="Delivery pipeline">
              <!-- Step 1: git push -->
              <li class="boot-step grid justify-items-center gap-2 text-center" style="--s: 0">
                <span class="grid size-10 place-items-center rounded-xl border border-[var(--border)] bg-[var(--muted-bg)] text-[var(--fg)] squircle">
                  <svg viewBox="0 0 24 24" class="size-4.5" aria-hidden="true"><path fill="currentColor" d="M13.09 23.549a1.54 1.54 0 0 1-2.18 0L.451 13.089a1.54 1.54 0 0 1 0-2.179l7.191-7.19l2.733 2.733a1.85 1.85 0 0 0 .964 2.326v6.66a1.849 1.849 0 1 0 1.54 0V8.957l2.508 2.508a1.85 1.85 0 1 0 1.09-1.09l-2.634-2.634a1.85 1.85 0 0 0-2.378-2.377L8.73 2.63L10.91.451a1.54 1.54 0 0 1 2.179 0l10.459 10.46a1.54 1.54 0 0 1 0 2.179z"></path></svg>
                </span>
                <span class="text-xs leading-tight text-[var(--muted-fg)]">git push</span>
              </li>

              <!-- Step 2: Trivy + SBOM -->
              <li class="boot-step grid justify-items-center gap-2 text-center" style="--s: 1">
                <span class="grid size-10 place-items-center rounded-xl border border-[var(--border)] bg-[var(--muted-bg)] text-[var(--fg)] squircle">
                  <svg viewBox="0 0 24 24" class="size-4.5" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 7V5a2 2 0 0 1 2-2h2m10 0h2a2 2 0 0 1 2 2v2m0 10v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"></path><circle cx="12" cy="12" r="3"></circle><path d="m16 16l-1.9-1.9"></path></g></svg>
                </span>
                <span class="text-xs leading-tight text-[var(--muted-fg)]">Trivy + SBOM</span>
              </li>

              <!-- Step 3: Sign + Verify -->
              <li class="boot-step grid justify-items-center gap-2 text-center" style="--s: 2">
                <span class="grid size-10 place-items-center rounded-xl border border-[var(--border)] bg-[var(--muted-bg)] text-[var(--fg)] squircle">
                  <svg viewBox="0 0 24 24" class="size-4.5" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M12 22V12m4 5l2 2l4-4"></path><path d="M21 11.127V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.729l7 4a2 2 0 0 0 2 .001l1.32-.753"></path><path d="M3.29 7L12 12l8.71-5M7.5 4.27l8.997 5.148"></path></g></svg>
                </span>
                <span class="text-xs leading-tight text-[var(--muted-fg)]">Sign + Verify</span>
              </li>

              <!-- Step 4: Jenkins -->
              <li class="boot-step grid justify-items-center gap-2 text-center" style="--s: 3">
                <span class="grid size-10 place-items-center rounded-xl border border-[var(--border)] bg-[var(--muted-bg)] text-[var(--fg)] squircle">
                  <i class="devicon-jenkins-line text-[18px]"></i>
                </span>
                <span class="text-xs leading-tight text-[var(--muted-fg)]">Jenkins</span>
              </li>
            </ol>
          </div>

          <span class="flow flow-y my-1" style="--d: 1.5s; --c: var(--mid); --b: 0" aria-hidden="true"><i></i></span>

          <!-- 3-Node High Availability Kubernetes Cluster Box -->
          <div class="boot-cluster rounded-xl bg-[var(--muted-bg)]/70 p-3 squircle">
            <p class="text-xs font-semibold mb-3 flex items-center gap-2 text-[var(--fg)]">
              <svg viewBox="0 0 24 24" class="size-4" aria-hidden="true"><path fill="currentColor" d="m10.204 14.35l.007.01l-.999 2.413a5.17 5.17 0 0 1-2.075-2.597l2.578-.437l.004.005a.44.44 0 0 1 .484.606zm-.833-2.129a.44.44 0 0 0 .173-.756l.002-.011L7.585 9.7a5.14 5.14 0 0 0-.73 3.255l2.514-.725zm1.145-1.98a.44.44 0 0 0 .699-.337l.01-.005l.15-2.62a5.14 5.14 0 0 0-3.01 1.442l2.147 1.523zm.76 2.75l.723.349l.722-.347l.18-.78l-.5-.623h-.804l-.5.623l.179.779zm1.5-3.095a.44.44 0 0 0 .7.336l.008.003l2.134-1.513a5.2 5.2 0 0 0-2.992-1.442l.148 2.615zm10.876 5.97l-5.773 7.181a1.6 1.6 0 0 1-1.248.594l-9.261.003a1.6 1.6 0 0 1-1.247-.596l-5.776-7.18a1.58 1.58 0 0 1-.307-1.34L2.1 5.573c.108-.47.425-.864.863-1.073L11.305.513a1.6 1.6 0 0 1 1.385 0l8.345 3.985c.438.209.755.604.863 1.073l2.062 8.955c.108.47-.005.963-.308 1.34m-3.289-2.057c-.042-.01-.103-.026-.145-.034c-.174-.033-.315-.025-.479-.038c-.35-.037-.638-.067-.895-.148c-.105-.04-.18-.165-.216-.216l-.201-.059a6.5 6.5 0 0 0-.105-2.332a6.5 6.5 0 0 0-.936-2.163c.052-.047.15-.133.177-.159c.008-.09.001-.183.094-.282c.197-.185.444-.338.743-.522c.142-.084.273-.137.415-.242c.032-.024.076-.062.11-.089c.24-.191.295-.52.123-.736s-.506-.236-.745-.045c-.034.027-.08.062-.111.088c-.134.116-.217.23-.33.35c-.246.25-.45.458-.673.609c-.097.056-.239.037-.303.033l-.19.135a6.55 6.55 0 0 0-4.146-2.003l-.012-.223c-.065-.062-.143-.115-.163-.25c-.022-.268.015-.557.057-.905c.023-.163.061-.298.068-.475c.001-.04-.001-.099-.001-.142c0-.306-.224-.555-.5-.555c-.275 0-.499.249-.499.555l.001.014c0 .041-.002.092 0 .128c.006.177.044.312.067.475c.042.348.078.637.056.906a.55.55 0 0 1-.162.258l-.012.211a6.42 6.42 0 0 0-4.166 2.003l-.18-.128c-.09.012-.18.04-.297-.029c-.223-.15-.427-.358-.673-.608c-.113-.12-.195-.234-.329-.349l-.111-.088a.6.6 0 0 0-.348-.132a.48.48 0 0 0-.398.176c-.172.216-.117.546.123.737l.007.005l.104.083c.142.105.272.159.414.242c.299.185.546.338.743.522c.076.082.09.226.1.288l.16.143a6.46 6.46 0 0 0-1.02 4.506l-.208.06c-.055.072-.133.184-.215.217c-.257.081-.546.11-.895.147c-.164.014-.305.006-.48.039c-.037.007-.09.02-.133.03l-.004.002l-.007.002c-.295.071-.484.342-.423.608c.061.267.349.429.645.365l.007-.001l.01-.003l.129-.029c.17-.046.294-.113.448-.172c.33-.118.604-.217.87-.256c.112-.009.23.069.288.101l.217-.037a6.5 6.5 0 0 0 2.88 3.596l-.09.218c.033.084.069.199.044.282c-.097.252-.263.517-.452.813c-.091.136-.185.242-.268.399c-.02.037-.045.095-.064.134c-.128.275-.034.591.213.71c.248.12.556-.007.69-.282v-.002c.02-.039.046-.09.062-.127c.07-.162.094-.301.144-.458c.132-.332.205-.68.387-.897c.05-.06.13-.082.215-.105l.113-.205a6.45 6.45 0 0 0 4.609.012l.106.192c.086.028.18.042.256.155c.136.232.229.507.342.84c.05.156.074.295.145.457c.016.037.043.09.062.129c.133.276.442.402.69.282c.247-.118.341-.435.213-.71c-.02-.039-.045-.096-.065-.134c-.083-.156-.177-.261-.268-.398c-.19-.296-.346-.541-.443-.793c-.04-.13.007-.21.038-.294c-.018-.022-.059-.144-.083-.202a6.5 6.5 0 0 0 2.88-3.622c.064.01.176.03.213.038c.075-.05.144-.114.28-.104c.266.039.54.138.87.256c.154.06.277.128.448.173c.036.01.088.019.13.028l.009.003l.007.001c.297.064.584-.098.645-.365c.06-.266-.128-.537-.423-.608M16.4 9.701l-1.95 1.746v.005a.44.44 0 0 0 .173.757l.003.01l2.526.728a5.2 5.2 0 0 0-.108-1.674A5.2 5.2 0 0 0 16.4 9.7zm-4.013 5.325a.44.44 0 0 0-.404-.232a.44.44 0 0 0-.372.233h-.002l-1.268 2.292a5.16 5.16 0 0 0 3.326.003l-1.27-2.296zm1.888-1.293a.44.44 0 0 0-.27.036a.44.44 0 0 0-.214.572l-.003.004l1.01 2.438a5.15 5.15 0 0 0 2.081-2.615l-2.6-.44z"></path></svg>
              <span>Kubernetes, highly available</span>
            </p>

            <!-- 3 Server Nodes with 8 Live Pods each -->
            <div class="grid grid-cols-3 gap-2" aria-hidden="true">
              <div class="rounded-lg bg-[var(--card)] p-2.5 border border-[var(--border)]/60">
                <svg viewBox="0 0 24 24" class="size-4 text-[var(--muted-fg)]"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><path d="M6 6h.01M6 18h.01"></path></g></svg>
                <div class="mt-2.5 grid w-fit grid-cols-4 gap-1">
                  <span class="pod" style="--n: 0; --p: 0"></span>
                  <span class="pod" style="--n: 0; --p: 1"></span>
                  <span class="pod pod-rollout" style="--n: 0; --p: 2"></span>
                  <span class="pod" style="--n: 0; --p: 3"></span>
                  <span class="pod" style="--n: 0; --p: 4"></span>
                  <span class="pod" style="--n: 0; --p: 5"></span>
                  <span class="pod" style="--n: 0; --p: 6"></span>
                  <span class="pod" style="--n: 0; --p: 7"></span>
                </div>
              </div>

              <div class="rounded-lg bg-[var(--card)] p-2.5 border border-[var(--border)]/60">
                <svg viewBox="0 0 24 24" class="size-4 text-[var(--muted-fg)]"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><path d="M6 6h.01M6 18h.01"></path></g></svg>
                <div class="mt-2.5 grid w-fit grid-cols-4 gap-1">
                  <span class="pod" style="--n: 1; --p: 8"></span>
                  <span class="pod" style="--n: 1; --p: 9"></span>
                  <span class="pod" style="--n: 1; --p: 10"></span>
                  <span class="pod pod-rollout" style="--n: 1; --p: 11"></span>
                  <span class="pod" style="--n: 1; --p: 12"></span>
                  <span class="pod" style="--n: 1; --p: 13"></span>
                  <span class="pod" style="--n: 1; --p: 14"></span>
                  <span class="pod" style="--n: 1; --p: 15"></span>
                </div>
              </div>

              <div class="rounded-lg bg-[var(--card)] p-2.5 border border-[var(--border)]/60">
                <svg viewBox="0 0 24 24" class="size-4 text-[var(--muted-fg)]"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect><rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect><path d="M6 6h.01M6 18h.01"></path></g></svg>
                <div class="mt-2.5 grid w-fit grid-cols-4 gap-1">
                  <span class="pod" style="--n: 2; --p: 16"></span>
                  <span class="pod" style="--n: 2; --p: 17"></span>
                  <span class="pod" style="--n: 2; --p: 18"></span>
                  <span class="pod" style="--n: 2; --p: 19"></span>
                  <span class="pod pod-rollout" style="--n: 2; --p: 20"></span>
                  <span class="pod" style="--n: 2; --p: 21"></span>
                  <span class="pod" style="--n: 2; --p: 22"></span>
                  <span class="pod" style="--n: 2; --p: 23"></span>
                </div>
              </div>
            </div>

            <ul class="mt-3 flex flex-wrap gap-x-0 gap-y-1 text-xs font-medium text-[var(--muted-fg)]" aria-label="Practices">
              <li class="sep">Jenkins CI/CD</li>
              <li class="sep">Signed images</li>
              <li class="sep">SBOM</li>
              <li class="sep">Air-Gapped Ansible</li>
              <li class="sep">Automatic TLS</li>
            </ul>
          </div>

          <span class="flow flow-y my-1" style="--d: 3s; --c: var(--primary); --b: 1" aria-hidden="true"><i></i></span>

          <p class="boot-prod flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-[var(--line-strong)] bg-[var(--card)] px-3 py-2.5 text-sm">
            <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-[var(--primary)]" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20a14.5 14.5 0 0 0 0-20M2 12h20"></path></g></svg>
            <span class="font-semibold text-[var(--fg)]">In production</span>
            <span class="text-xs text-[var(--muted-fg)]">rolling update</span>
          </p>
        </div>

          <!-- VIEW B: INTERACTIVE TERMINAL (Đồng bộ Sáng / Tối + Full Terminal Engine, khớp 100% kích thước với Pipeline) -->
          <div id="hw-view-term" class="col-start-1 row-start-1 relative w-full h-full invisible opacity-0 pointer-events-none transition-opacity duration-150">
            <div
              id="terminal-logs"
              class="absolute inset-0 rounded-xl border border-[var(--border)] bg-[var(--muted-bg)] p-3.5 font-mono text-xs text-[var(--muted-fg)] space-y-1.5 overflow-y-auto cursor-text select-text custom-scrollbar"
              role="region"
              aria-label="Interactive Terminal System Log"
            >
              <div id="terminal-history" class="space-y-1" aria-live="polite">
                <div># Interactive Shell — Type <span class="text-[var(--signal)] font-semibold">help</span>, <span class="text-[var(--signal)] font-semibold">whoami</span>, <span class="text-[var(--signal)] font-semibold">experience</span>, <span class="text-[var(--signal)] font-semibold">projects</span>, <span class="text-[var(--signal)] font-semibold">skills</span>, <span class="text-[var(--signal)] font-semibold">neofetch</span></div>
                <div class="text-[var(--signal)]">✔ Jenkins supply-chain verified (Trivy + SBOM + Signature OK)</div>
              </div>

              <div class="text-[var(--signal)] pt-1 flex items-center flex-wrap" id="active-cli-line">
                <span class="font-semibold select-none">ntquan@devops:~$&nbsp;</span>
                <span id="cli-display-text" class="text-[var(--fg)] font-mono whitespace-pre"></span>
                <span class="blinking-cursor"></span>
              </div>

              <input
                type="text"
                id="cli-input"
                class="opacity-0 absolute -left-[9999px]"
                autocomplete="off"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                aria-label="Terminal command input"
              />
            </div>
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<script>
  import { portfolioData } from '../../data/portfolio';
  import {
    COMMAND_LIST,
    CommandHistoryManager,
    getAutocompleteMatch,
    getClosestCommand,
  } from '../terminal/terminal-engine';

  function initHeroPanel() {
    const btnMap = document.getElementById('hw-btn-map');
    const btnTerm = document.getElementById('hw-btn-term');
    const viewMap = document.getElementById('hw-view-map');
    const viewTerm = document.getElementById('hw-view-term');
    const label = document.getElementById('hero-panel-label');
    const terminal = document.getElementById('terminal-logs');
    const historyEl = document.getElementById('terminal-history');
    const displayEl = document.getElementById('cli-display-text');
    const inputEl = document.getElementById('cli-input') as HTMLInputElement | null;
    const historyManager = new CommandHistoryManager();

    function switchHeroWidget(mode: 'map' | 'term') {
      const isMap = mode === 'map';
      viewMap?.classList.toggle('invisible', !isMap);
      viewMap?.classList.toggle('opacity-0', !isMap);
      viewMap?.classList.toggle('pointer-events-none', !isMap);

      viewTerm?.classList.toggle('invisible', isMap);
      viewTerm?.classList.toggle('opacity-0', isMap);
      viewTerm?.classList.toggle('pointer-events-none', isMap);

      if (label) label.textContent = isMap ? 'How I ship' : 'ntquan@devops-engineer: ~';
      if (btnMap && btnTerm) {
        if (isMap) {
          btnMap.className = 'px-2.5 py-1 rounded-md bg-[var(--card)] text-[var(--fg)] font-semibold cursor-pointer transition';
          btnTerm.className = 'px-2.5 py-1 rounded-md text-[var(--muted-fg)] cursor-pointer transition';
        } else {
          btnTerm.className = 'px-2.5 py-1 rounded-md bg-[var(--card)] text-[var(--fg)] font-semibold cursor-pointer transition';
          btnMap.className = 'px-2.5 py-1 rounded-md text-[var(--muted-fg)] cursor-pointer transition';
          inputEl?.focus();
        }
      }
    }

    btnMap?.addEventListener('click', () => switchHeroWidget('map'));
    btnTerm?.addEventListener('click', () => switchHeroWidget('term'));

    if (!terminal || !historyEl || !displayEl || !inputEl) return;

    terminal.addEventListener('click', () => {
      const selection = window.getSelection();
      if (!selection || selection.toString().length === 0) {
        inputEl.focus();
      }
    });

    const scrollToBottom = () => {
      terminal.scrollTop = terminal.scrollHeight;
    };

    const appendHistoryLine = (text: string, className: string = 'text-[var(--muted-fg)]') => {
      const line = document.createElement('div');
      line.className = className;
      line.textContent = text;
      historyEl.appendChild(line);
      scrollToBottom();
    };

    inputEl.addEventListener('input', () => {
      displayEl.textContent = inputEl.value;
      scrollToBottom();
    });

    const ALIASES: Record<string, string> = {
      exp: 'experience',
      proj: 'projects',
    };

    inputEl.addEventListener('keydown', async (e) => {
      if (e.key === 'Enter') {
        const raw = inputEl.value;
        const trimmed = raw.trim();
        inputEl.value = '';
        displayEl.textContent = '';
        historyManager.resetCursor();

        appendHistoryLine(`ntquan@devops:~$ ${raw}`, 'text-[var(--fg)] font-semibold mt-1');

        if (!trimmed) {
          scrollToBottom();
          return;
        }

        historyManager.push(trimmed);
        const [cmdName, ...args] = trimmed.split(/\s+/);
        const lowerCmd = ALIASES[cmdName.toLowerCase()] ?? cmdName.toLowerCase();

        if (lowerCmd === 'edu' || lowerCmd === 'education') {
          appendHistoryLine('B.Eng in Information Technology — Networks, Linux & Distributed Systems', 'text-[var(--signal)]');
          window.location.hash = '#education';
          scrollToBottom();
          return;
        }

        const cmd = COMMAND_LIST[lowerCmd];
        if (cmd) {
          try {
            const lines = await cmd.execute(args, {
              portfolioData: (window as any).__PORTFOLIO__ ?? portfolioData,
              navigate: (url) => { window.location.href = url; },
              openModal: (id) => { (window as any).openProjectModal?.(id); },
              clearTerminal: () => { historyEl.innerHTML = ''; },
              history: historyManager.getHistory(),
            });

            lines.forEach((l) => {
              let colorClass = 'text-[var(--muted-fg)]';
              if (l.type === 'success') colorClass = 'text-[var(--signal)]';
              else if (l.type === 'info') colorClass = 'text-[var(--primary)]';
              else if (l.type === 'error') colorClass = 'text-red-500';
              else if (l.type === 'dim') colorClass = 'text-[var(--faint)] text-[11px]';
              else if (l.type === 'ascii') colorClass = 'text-[var(--signal)] whitespace-pre font-mono text-[10px] leading-tight';

              appendHistoryLine(l.text, colorClass);
            });
          } catch (err) {
            appendHistoryLine(`[ERROR] ${err}`, 'text-red-500');
          }
        } else {
          appendHistoryLine(`bash: ${cmdName}: command not found`, 'text-red-500');
          const closest = getClosestCommand(cmdName);
          if (closest) {
            appendHistoryLine(`Did you mean: ${closest}? (Type 'help' for commands)`, 'text-[var(--faint)] text-[11px]');
          } else {
            appendHistoryLine("Type 'help' for available commands.", 'text-[var(--faint)] text-[11px]');
          }
        }

        scrollToBottom();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        inputEl.value = historyManager.navigateUp(inputEl.value);
        displayEl.textContent = inputEl.value;
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        inputEl.value = historyManager.navigateDown();
        displayEl.textContent = inputEl.value;
      } else if (e.key === 'Tab') {
        e.preventDefault();
        const current = inputEl.value;
        const { match, suggestions } = getAutocompleteMatch(current);
        if (match) {
          inputEl.value = match;
          displayEl.textContent = match;
        } else if (suggestions.length > 1) {
          appendHistoryLine(`ntquan@devops:~$ ${current}`, 'text-[var(--fg)] font-semibold');
          appendHistoryLine(`Available: ${suggestions.join('   ')}`, 'text-[var(--faint)] text-[11px]');
          scrollToBottom();
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroPanel);
  } else {
    initHeroPanel();
  }
</script>
