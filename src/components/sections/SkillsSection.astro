---
import { portfolioData } from '../../data/portfolio';
import { groupSkillsByCategory, renderSkills } from '../../lib/render';
const { skills } = portfolioData;
const skillGroups = groupSkillsByCategory(skills, 'en');
const activeCount = skills.filter((s) => s.status === 'ACTIVE').length;
---

<section id="skills" class="scroll-mt-20 py-14 sm:py-20 border-t border-[var(--border)]">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-10">
    <!-- Eyebrow & Headline -->
    <div class="space-y-2">
      <p class="reveal font-mono text-xs text-[var(--signal)] tracking-wider uppercase font-semibold">
        // 05. SKILLS &amp; ARCHITECTURE
      </p>
      <h2 class="reveal-wipe font-mono text-3xl sm:text-5xl font-black uppercase tracking-tight text-[var(--fg)]">
        SKILLS
      </h2>
    </div>

    <!-- Dynamic Grouped Skills Grid (Derived from PortfolioData.skills) -->
    <div id="ed-skill-layers" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {skillGroups.length === 0 ? (
        <p class="col-span-full text-xs font-mono text-[var(--muted-fg)]">[ No published skills ]</p>
      ) : (
        skillGroups.map((group, idx) => (
          <div
            class="reveal is-visible ff-cross-box rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 space-y-4 hover:border-[var(--line-strong)] transition"
            style={`--d: ${idx * 0.06}s`}
          >
            <span class="ff-cross-tl">+</span>
            <span class="ff-cross-tr">+</span>
            <span class="ff-cross-bl">+</span>
            <span class="ff-cross-br">+</span>

            <div class="flex items-center justify-between font-mono text-xs border-b border-[var(--border)] pb-2.5">
              <span class="text-[var(--signal)] font-bold">// {String(idx + 1).padStart(2, '0')}</span>
              <span class="text-[var(--muted-fg)] uppercase tracking-wider text-[11px]">MODULE</span>
            </div>

            <div class="space-y-1">
              <h3 class="font-mono text-base font-bold text-[var(--fg)] tracking-tight">
                {group.category}
              </h3>
              <p class="text-xs text-[var(--muted-fg)] leading-relaxed font-mono">
                {group.items.length} published tool{group.items.length === 1 ? '' : 's'}
              </p>
            </div>

            <div class="space-y-2.5 pt-3 border-t border-[var(--border)] font-mono text-xs">
              {group.items.map((item) => (
                <div class="flex items-center justify-between gap-2">
                  <span class={item.status === 'ACTIVE' ? 'font-semibold text-[var(--fg)]' : 'text-[var(--muted-fg)]'}>
                    {item.name}
                  </span>
                  <span class="text-[10px] text-[var(--signal)] font-medium">
                    {item.tag || `[${item.status}]`}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))
      )}
    </div>

    <!-- Active Modules Register Box -->
    <div class="reveal ff-cross-box rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 space-y-4">
      <span class="ff-cross-tl">+</span>
      <span class="ff-cross-tr">+</span>
      <span class="ff-cross-bl">+</span>
      <span class="ff-cross-br">+</span>

      <div class="flex items-center justify-between font-mono text-xs border-b border-[var(--border)] pb-3">
        <span class="font-bold text-[var(--fg)] tracking-wider">[ ACTIVE_MODULES_REGISTER ]</span>
        <span id="ed-skills-status" class="inline-flex items-center gap-1.5 text-[var(--signal)] font-semibold text-[11px]">
          <span class="size-1.5 rounded-full bg-[var(--signal)] animate-pulse"></span>
          {skills.length > 0 ? `${activeCount}/${skills.length} ACTIVE` : 'EMPTY'}
        </span>
      </div>

      <!-- Live Dynamic Skills from Store -->
      <ul id="bind-skills" class="flex flex-wrap gap-2.5" set:html={renderSkills(skills)} />
    </div>
  </div>
</section>

<script>
  import { esc, groupSkillsByCategory } from '../../lib/render';

  window.addEventListener('portfolio:data', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (!detail) return;
    const isVi = detail._locale === 'vi';
    const skills = detail.skills || [];
    const groups = groupSkillsByCategory(skills, isVi ? 'vi' : 'en');
    const layersEl = document.getElementById('ed-skill-layers');
    const statusEl = document.getElementById('ed-skills-status');

    if (statusEl) {
      const activeCount = skills.filter((s: any) => s.status === 'ACTIVE').length;
      const label = skills.length > 0 ? `${activeCount}/${skills.length} ACTIVE` : (isVi ? 'TRỐNG' : 'EMPTY');
      statusEl.innerHTML = `<span class="size-1.5 rounded-full bg-[var(--signal)] animate-pulse"></span>${esc(label)}`;
    }

    if (layersEl) {
      if (groups.length === 0) {
        layersEl.innerHTML = `<p class="col-span-full text-xs font-mono text-[var(--muted-fg)]">${esc(isVi ? '[ Chưa có kỹ năng đăng tải ]' : '[ No published skills ]')}</p>`;
        return;
      }
      layersEl.innerHTML = groups
        .map(
          (group, idx) => `<div class="ff-cross-box rounded-2xl border border-[var(--border)] bg-[var(--card)] p-6 space-y-4 hover:border-[var(--line-strong)] transition">
            <span class="ff-cross-tl">+</span>
            <span class="ff-cross-tr">+</span>
            <span class="ff-cross-bl">+</span>
            <span class="ff-cross-br">+</span>
            <div class="flex items-center justify-between font-mono text-xs border-b border-[var(--border)] pb-2.5">
              <span class="text-[var(--signal)] font-bold">// ${String(idx + 1).padStart(2, '0')}</span>
              <span class="text-[var(--muted-fg)] uppercase tracking-wider text-[11px]">${isVi ? 'NHÓM' : 'MODULE'}</span>
            </div>
            <div class="space-y-1">
              <h3 class="font-mono text-base font-bold text-[var(--fg)] tracking-tight">${esc(group.category)}</h3>
              <p class="text-xs text-[var(--muted-fg)] leading-relaxed font-mono">${group.items.length} ${isVi ? 'công cụ công khai' : `published tool${group.items.length === 1 ? '' : 's'}`}</p>
            </div>
            <div class="space-y-2.5 pt-3 border-t border-[var(--border)] font-mono text-xs">
              ${group.items
                .map(
                  (item) => `<div class="flex items-center justify-between gap-2">
                <span class="${item.status === 'ACTIVE' ? 'font-semibold text-[var(--fg)]' : 'text-[var(--muted-fg)]'}">${esc(item.name)}</span>
                <span class="text-[10px] text-[var(--signal)] font-medium">${esc(item.tag || `[${item.status}]`)}</span>
              </div>`,
                )
                .join('')}
            </div>
          </div>`,
        )
        .join('');
    }
  });
</script>
