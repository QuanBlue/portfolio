---
import { portfolioData, getCareerSettings, resolveAvatarUrl } from '../../data/portfolio';
import { safeUrl } from '../../lib/render';
import { renderAsciiAvatarImgOrFallback } from './ascii-renderers';
import { DEFAULT_SLANT_BANNER, buildAsciiBannerText } from './ascii-live';

const { identity, projects, skills, experience, education } = portfolioData;
const career = getCareerSettings(portfolioData);
const showCv = career.openToWork && Boolean(career.cvUrl);
const currentCompany = experience[0]?.company ?? '';
const handle = String(identity.github?.handle || 'quan').replace(/^@/, '').toLowerCase() || 'quan';
const nodeHost = String(identity.node || 'infra-node');
const bannerText = buildAsciiBannerText(identity.name, 'slant') || DEFAULT_SLANT_BANNER;
const avatarUrl = resolveAvatarUrl(portfolioData);
---

<section id="top" class="relative pt-10 pb-16 sm:pt-16 sm:pb-20 border-b border-[var(--border)] overflow-hidden font-mono">
  <!-- Subtle ASCII Matrix Background Grid -->
  <div class="ascii-matrix-bg absolute inset-0 opacity-15 pointer-events-none select-none overflow-hidden text-[10px] leading-3 text-[var(--signal)] font-mono" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Top Terminal Header Prompt -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[var(--border)] pb-3 text-xs text-[var(--muted-fg)]">
      <div class="flex items-center gap-2">
        <span class="inline-block size-2 rounded-full bg-[var(--signal)] animate-pulse"></span>
        <span data-ascii-prompt class="text-[var(--signal)] font-bold">{`${handle.split(/[^a-z0-9]/)[0] || 'quan'}@${nodeHost}:~$`}</span>
        <span class="text-[var(--fg)]">cat /etc/banner.ascii</span>
      </div>
      <div class="flex items-center gap-3 text-[11px]">
        <div class="flex items-center gap-1.5 border border-[var(--border)] rounded px-2 py-0.5 bg-[var(--muted-bg)]/40">
          <span class="text-[var(--muted-fg)]">FONT:</span>
          <button type="button" id="btn-font-slant" class="font-bold text-[var(--signal)] transition cursor-pointer" title="Switch to Slant ASCII font">SLANT</button>
          <span class="text-[var(--border)]">|</span>
          <button type="button" id="btn-font-ansi" class="font-medium text-[var(--muted-fg)] hover:text-[var(--fg)] transition cursor-pointer" title="Switch to ANSI Cyber Shadow font">ANSI</button>
        </div>
        <span>[ SHELL: INTERACTIVE_SIM ]</span>
        <span>[ PROJECTS: <strong class="text-[var(--signal)]" data-ascii-stat="projects">{projects.length}</strong> ]</span>
        <span>[ SKILLS: <strong class="text-[var(--signal)]" data-ascii-stat="skills">{skills.length}</strong> ]</span>
      </div>
    </div>

    <!-- Giant ASCII Art Title Banner -->
    <div class="overflow-x-auto py-2">
      <pre
        id="ascii-banner-pre"
        data-ascii-font="slant"
        class="font-mono text-[9px] sm:text-[13px] md:text-[15px] lg:text-[17px] leading-[1.1] font-bold text-[var(--fg)] select-all tracking-tight whitespace-pre"
        aria-label={identity.name}
      >{bannerText}</pre>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Hero Details (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-6">
        <!-- Encrypted Hacker Typewriter Name Header (Clean, Auto 10s Loop) -->
        <div class="pb-1 border-b border-[var(--border)]">
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-[var(--fg)] flex items-center select-all font-mono">
            <span id="ascii-typewriter-name" data-target={identity.name} data-bind="name">
              {identity.name}
            </span>
            <span id="ascii-typewriter-cursor" class="inline-block w-2.5 h-6 sm:h-8 bg-[var(--signal)] ml-1 animate-pulse" aria-hidden="true"></span>
          </h1>
        </div>

        <!-- Subtitle & Role -->
        <div class="space-y-1">
          <p class="text-sm sm:text-base font-bold text-[var(--signal)]">
            &gt; <span data-bind="role">{identity.role}</span> <span data-bind-company data-company-prefix="@ " class={`font-normal text-[var(--fg)] ${currentCompany ? '' : 'hidden'}`}>{currentCompany ? `@ ${currentCompany}` : ''}</span>
          </p>
          <p class="text-xs sm:text-sm text-[var(--muted-fg)] leading-relaxed flex flex-wrap items-center gap-2">
            <span data-bind="location">{identity.location}</span>
            <span data-career-badge class={`text-[var(--signal)] font-semibold ${career.openToWork ? '' : 'hidden'}`}>· Open to Work</span>
          </p>
        </div>

        <!-- Bio text -->
        <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--muted-bg)]/40 text-xs sm:text-sm text-[var(--muted-fg)] leading-relaxed">
          <p data-bind="bio">{identity.bio}</p>
        </div>

        <!-- Action Links in Monospace Brackets -->
        <div class="flex flex-wrap items-center gap-2.5 text-xs">
          <a href="#projects" class="ff-btn ff-btn-primary">
            [ view_projects → ]
          </a>
          <a href="#experience" class="ff-btn">
            [ career_path ↓ ]
          </a>
          <button
            type="button"
            data-open-cv="1"
            data-cv-gate
            class={`ff-btn text-[var(--signal)] border-[var(--signal)]/40 hover:bg-emerald-500/10 ${showCv ? '' : 'hidden'}`}
          >
            [ view_cv.pdf ]
          </button>
          <a data-bind="github" href={safeUrl(identity.github.url)} target="_blank" rel="noopener noreferrer" class="ff-btn">
            [ github: <span data-bind-handle="github">{identity.github.handle}</span> ↗ ]
          </a>
          <a data-bind="linkedin" href={safeUrl(identity.linkedin.url)} target="_blank" rel="noopener noreferrer" class="ff-btn">
            [ linkedin: <span data-bind-handle="linkedin">{identity.linkedin.handle}</span> ↗ ]
          </a>
        </div>

        <!-- System Node Info Box (Factual Published Metadata Only) -->
        <div class="p-3.5 rounded-xl border border-dashed border-[var(--border)] bg-[var(--card)] text-[11px] text-[var(--muted-fg)] grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div>
            <span class="text-[var(--faint)] block uppercase text-[10px]">Node</span>
            <span class="text-[var(--fg)] font-bold" data-bind="node">{identity.node}</span>
          </div>
          <div>
            <span class="text-[var(--faint)] block uppercase text-[10px]">Location</span>
            <span class="text-[var(--fg)] font-bold truncate block" data-bind="location">{identity.location}</span>
          </div>
          <div>
            <span class="text-[var(--faint)] block uppercase text-[10px]">Experience</span>
            <span class="text-[var(--fg)] font-bold" data-ascii-stat="experience">{experience.length} roles</span>
          </div>
          <div>
            <span class="text-[var(--faint)] block uppercase text-[10px]">Education</span>
            <span class="text-[var(--signal)] font-bold" data-ascii-stat="education">{education.length} entries</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Avatar Plate with Photo & ASCII Toggle (lg:col-span-4) -->
      <div class="lg:col-span-4 flex flex-col items-center lg:items-end">
        <div class="ff-cross-box w-full max-w-sm rounded-2xl border border-[var(--border)] bg-[var(--card)] p-5 space-y-4 shadow-md">
          <span class="ff-cross-tl">+</span>
          <span class="ff-cross-tr">+</span>
          <span class="ff-cross-bl">+</span>
          <span class="ff-cross-br">+</span>

          <!-- Header with live status and View Toggle -->
          <div class="flex items-center justify-between border-b border-[var(--border)] pb-2.5 text-[11px] text-[var(--muted-fg)]">
            <div class="flex items-center gap-1.5">
              <span class="size-1.5 rounded-full bg-[var(--signal)] animate-pulse"></span>
              <span class="font-bold text-[var(--fg)]">// AVATAR_PORTRAIT</span>
            </div>

            <!-- View toggle: PHOTO vs ASCII -->
            <div class="inline-flex items-center p-0.5 rounded-md border border-[var(--border)] bg-[var(--muted-bg)] text-[10px]">
              <button
                type="button"
                id="btn-avatar-photo"
                class="px-2 py-0.5 rounded text-[var(--fg)] font-bold bg-[var(--card)] shadow-xs transition cursor-pointer"
              >
                PHOTO
              </button>
              <button
                type="button"
                id="btn-avatar-ascii"
                class="px-2 py-0.5 rounded text-[var(--muted-fg)] hover:text-[var(--fg)] transition cursor-pointer"
              >
                ASCII
              </button>
            </div>
          </div>

          <!-- Main Avatar Display Container -->
          <div class="aspect-square w-full rounded-xl overflow-hidden border border-[var(--border)] bg-[var(--muted-bg)] relative flex items-center justify-center group shadow-inner">
            <!-- 1. Real Avatar Photo (Clear & Crisp) -->
            <div id="avatar-photo-view" class="w-full h-full relative">
              <div id="ascii-avatar-media-slot" class="w-full h-full" set:html={renderAsciiAvatarImgOrFallback(portfolioData)} />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-2.5 left-2.5 right-2.5 flex items-center justify-between text-[10px] text-white/90 drop-shadow pointer-events-none">
                <span>[ PROFILE ]</span>
                <span data-bind="node">{identity.node}</span>
              </div>
            </div>

            <!-- 2. Dynamic ASCII Rasterizer View -->
            <div id="avatar-ascii-view" class="hidden w-full h-full p-2 bg-[var(--card)] overflow-hidden flex items-center justify-center">
              <pre
                id="ascii-avatar-art"
                class="font-mono text-[6px] sm:text-[7px] leading-[1.0] text-[var(--signal)] select-none text-center tracking-tighter"
                data-src={avatarUrl}
                data-name={identity.name}
                data-role={identity.role}
              ></pre>
            </div>
          </div>

          <!-- Footer Metadata on plate -->
          <div class="flex items-center justify-between text-[11px] text-[var(--muted-fg)] pt-1 border-t border-[var(--border)]">
            <span class="truncate">
              NODE: <strong class="text-[var(--fg)]" data-bind="node">{identity.node}</strong>
            </span>
            <span class="text-[var(--signal)] font-semibold truncate ml-2" data-bind="location">
              {identity.location}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client-side Avatar Handler, Mode Switcher & Matrix background -->
<script>
  import { buildAsciiBannerText } from './ascii-live';

  const photoView = document.getElementById('avatar-photo-view');
  const asciiView = document.getElementById('avatar-ascii-view');
  const btnPhoto = document.getElementById('btn-avatar-photo');
  const btnAscii = document.getElementById('btn-avatar-ascii');
  const asciiPre = document.getElementById('ascii-avatar-art');
  const nameEl = document.getElementById('ascii-typewriter-name');
  const cursorEl = document.getElementById('ascii-typewriter-cursor');

  // --- 1. Encrypted Hacker Typewriter Decoder with 10s Pause Loop ---
  let typewriterTimer: ReturnType<typeof setInterval> | null = null;
  let pauseTimer: ReturnType<typeof setTimeout> | null = null;

  function stopNameCipherDecoder() {
    if (typewriterTimer) {
      clearInterval(typewriterTimer);
      typewriterTimer = null;
    }
    if (pauseTimer) {
      clearTimeout(pauseTimer);
      pauseTimer = null;
    }
  }

  function runNameCipherDecoder() {
    if (!nameEl) return;
    stopNameCipherDecoder();

    // Guard: only run decoder when ASCII theme is active
    if (document.documentElement.dataset.portfolioTheme !== 'ascii') {
      const targetName = nameEl.dataset.target || nameEl.textContent?.trim() || 'Portfolio';
      nameEl.textContent = targetName;
      return;
    }

    const target = nameEl.dataset.target || nameEl.textContent?.trim() || 'Portfolio';
    const cipherChars = '01#@$%&*+=~_/?\\<>[];:!XABCDEF';
    let currentIndex = 0;
    let scrambleTicks = 0;
    const maxTicksPerChar = 3;

    nameEl.innerHTML = '';
    if (cursorEl) cursorEl.classList.remove('opacity-0');

    typewriterTimer = setInterval(() => {
      if (currentIndex >= target.length) {
        if (typewriterTimer) clearInterval(typewriterTimer);
        nameEl.textContent = target;

        pauseTimer = setTimeout(() => {
          runNameCipherDecoder();
        }, 10000);
        return;
      }

      const lockedPart = target.slice(0, currentIndex);
      if (target[currentIndex] === ' ') {
        currentIndex++;
        nameEl.textContent = lockedPart + ' ';
        return;
      }

      const randomChar = cipherChars[Math.floor(Math.random() * cipherChars.length)];
      scrambleTicks++;

      nameEl.innerHTML = `${lockedPart}<span class="text-[var(--signal)] font-bold animate-pulse">${randomChar}</span>`;

      if (scrambleTicks >= maxTicksPerChar) {
        scrambleTicks = 0;
        currentIndex++;
        nameEl.textContent = target.slice(0, currentIndex);
      }
    }, 38);
  }

  // --- 2. Mode Switcher (Photo / ASCII) ---
  function setAvatarMode(mode: 'photo' | 'ascii') {
    if (mode === 'photo') {
      photoView?.classList.remove('hidden');
      asciiView?.classList.add('hidden');
      btnPhoto?.classList.add('bg-[var(--card)]', 'text-[var(--fg)]', 'font-bold', 'shadow-xs');
      btnPhoto?.classList.remove('text-[var(--muted-fg)]');
      btnAscii?.classList.remove('bg-[var(--card)]', 'text-[var(--fg)]', 'font-bold', 'shadow-xs');
      btnAscii?.classList.add('text-[var(--muted-fg)]');
    } else {
      photoView?.classList.add('hidden');
      asciiView?.classList.remove('hidden');
      btnAscii?.classList.add('bg-[var(--card)]', 'text-[var(--fg)]', 'font-bold', 'shadow-xs');
      btnAscii?.classList.remove('text-[var(--muted-fg)]');
      btnPhoto?.classList.remove('bg-[var(--card)]', 'text-[var(--fg)]', 'font-bold', 'shadow-xs');
      btnPhoto?.classList.add('text-[var(--muted-fg)]');
      generateAsciiPortrait();
    }
  }

  btnPhoto?.addEventListener('click', () => setAvatarMode('photo'));
  btnAscii?.addEventListener('click', () => setAvatarMode('ascii'));

  // High-Contrast Normalized ASCII Rasterizer
  function generateAsciiPortrait() {
    if (!asciiPre) return;
    const liveImg = document.getElementById('ascii-hero-avatar-img') as HTMLImageElement | null;
    const src = asciiPre.dataset.src || liveImg?.src || '';
    if (!src) {
      renderFallbackAscii();
      return;
    }

    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.referrerPolicy = 'no-referrer';

    img.onload = () => {
      const cols = 42;
      const rows = 26;
      const canvas = document.createElement('canvas');
      canvas.width = cols;
      canvas.height = rows;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;

      ctx.drawImage(img, 0, 0, cols, rows);
      let imgData: ImageData;
      try {
        imgData = ctx.getImageData(0, 0, cols, rows);
      } catch {
        renderFallbackAscii();
        return;
      }

      const data = imgData.data;
      const brightnesses: number[] = [];
      let minB = 1;
      let maxB = 0;
      let borderB = 0;
      let borderCount = 0;

      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const idx = (y * cols + x) * 4;
          const r = data[idx];
          const g = data[idx + 1];
          const b = data[idx + 2];
          const br = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
          brightnesses.push(br);
          minB = Math.min(minB, br);
          maxB = Math.max(maxB, br);

          if (x === 0 || x === cols - 1 || y === 0 || y === rows - 1) {
            borderB += br;
            borderCount++;
          }
        }
      }

      const avgBorder = borderCount > 0 ? borderB / borderCount : 0.5;
      const invert = avgBorder > 0.55;

      const ramp = '  .:-=+*#%@';
      const range = maxB - minB || 1;
      let ascii = '';

      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const raw = brightnesses[y * cols + x];
          let norm = (raw - minB) / range;
          if (invert) norm = 1 - norm;

          const charIdx = Math.max(0, Math.min(ramp.length - 1, Math.floor(norm * ramp.length)));
          ascii += ramp[charIdx];
        }
        ascii += '\n';
      }
      asciiPre.textContent = ascii;
    };

    img.onerror = () => {
      renderFallbackAscii();
    };

    img.src = src;
  }

  function renderFallbackAscii() {
    if (!asciiPre) return;
    const labelName = (asciiPre.dataset.name || 'PORTFOLIO').toUpperCase().slice(0, 22).padEnd(22, ' ');
    const labelRole = (asciiPre.dataset.role || 'ENGINEER').toUpperCase().slice(0, 22).padEnd(22, ' ');
    asciiPre.textContent = [
      '    +------------------------------+    ',
      `    |    ${labelName}    |    `,
      '    |                              |    ',
      '    |           .::+*+=:.          |    ',
      '    |         -#@@@@@@@@#-         |    ',
      '    |        +@@@@@@@@@@@@+        |    ',
      '    |        *@@@@@@@@@@@@*        |    ',
      '    |        +@@@@@@@@@@@@+        |    ',
      '    |         =%@@@@@@@@%=         |    ',
      '    |          .:=++++=:.          |    ',
      '    |        .:-=+*##*+=-:.        |    ',
      '    |     .+#@@@@@@@@@@@@@@#+.     |    ',
      '    |    *@@@@@@@@@@@@@@@@@@@@*    |    ',
      '    |   #@@@@@@@@@@@@@@@@@@@@@@#   |    ',
      '    |                              |    ',
      `    |    ${labelRole}    |    `,
      '    +------------------------------+    ',
    ].join('\n');
  }

  function initMatrixBg() {
    if (document.documentElement.dataset.portfolioTheme !== 'ascii') return;
    const bg = document.querySelector('.ascii-matrix-bg');
    if (!bg) return;
    const chars = '01#@$%&*+-=~.:;/\\|';
    const lines = [];
    for (let i = 0; i < 28; i++) {
      let line = '';
      for (let j = 0; j < 90; j++) {
        line += chars[Math.floor(Math.random() * chars.length)];
      }
      lines.push(line);
    }
    bg.textContent = lines.join('\n');
  }

  if (document.documentElement.dataset.portfolioTheme === 'ascii') {
    initMatrixBg();
    runNameCipherDecoder();
  }

  // --- Banner Font Switcher (Slant / ANSI Cyber Shadow) ---
  const bannerPre = document.getElementById('ascii-banner-pre');
  const btnFontSlant = document.getElementById('btn-font-slant');
  const btnFontAnsi = document.getElementById('btn-font-ansi');

  function setBannerFont(font: 'slant' | 'ansi') {
    if (!bannerPre) return;
    bannerPre.dataset.asciiFont = font;
    const activeName = nameEl?.dataset.target || bannerPre.getAttribute('aria-label') || 'PORTFOLIO';
    bannerPre.textContent = buildAsciiBannerText(activeName, font);
    if (font === 'slant') {
      btnFontSlant?.classList.add('text-[var(--signal)]', 'font-bold');
      btnFontSlant?.classList.remove('text-[var(--muted-fg)]');
      btnFontAnsi?.classList.remove('text-[var(--signal)]', 'font-bold');
      btnFontAnsi?.classList.add('text-[var(--muted-fg)]');
    } else {
      btnFontAnsi?.classList.add('text-[var(--signal)]', 'font-bold');
      btnFontAnsi?.classList.remove('text-[var(--muted-fg)]');
      btnFontSlant?.classList.remove('text-[var(--signal)]', 'font-bold');
      btnFontSlant?.classList.add('text-[var(--muted-fg)]');
    }
  }

  btnFontSlant?.addEventListener('click', () => setBannerFont('slant'));
  btnFontAnsi?.addEventListener('click', () => setBannerFont('ansi'));

  window.addEventListener('theme:changed', (e: Event) => {
    const theme = (e as CustomEvent).detail?.theme;
    if (theme === 'ascii') {
      initMatrixBg();
      runNameCipherDecoder();
    } else {
      stopNameCipherDecoder();
    }
  });

  window.addEventListener('ascii:avatar-updated', (e: Event) => {
    const detail = (e as CustomEvent).detail || {};
    if (asciiPre) {
      asciiPre.dataset.src = detail.avatarUrl || '';
      if (detail.name) asciiPre.dataset.name = detail.name;
      if (!asciiView?.classList.contains('hidden')) {
        generateAsciiPortrait();
      }
    }
  });

  window.addEventListener('portfolio:data', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (asciiPre && detail?.identity?.role) {
      asciiPre.dataset.role = detail.identity.role;
    }
    if (detail?.identity?.name && nameEl) {
      nameEl.dataset.target = detail.identity.name;
      if (document.documentElement.dataset.portfolioTheme === 'ascii') {
        runNameCipherDecoder();
      } else {
        nameEl.textContent = detail.identity.name;
      }
    }
  });
</script>
