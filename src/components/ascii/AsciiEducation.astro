---
import { portfolioData } from '../../data/portfolio';
import { renderAsciiCertificationsHtml, renderAsciiEducationHtml } from './ascii-renderers';
const education = portfolioData.education ?? [];
const certifications = portfolioData.certifications ?? [];
---

<section id="education" class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)] font-mono">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- ASCII Title Banner -->
    <div class="space-y-2">
      <span class="text-xs text-[var(--signal)] font-semibold tracking-wider">// 04. SECTION_EDUCATION</span>
      <div class="overflow-x-auto py-1">
        <pre
          data-ascii-banner="EDUCATION"
          class="font-mono text-[9px] sm:text-[13px] md:text-[15px] font-bold text-[var(--fg)] tracking-tight leading-[1.1] select-all cursor-pointer"
          aria-label="EDUCATION"
          title="Click to re-decrypt"
        >
 _____ ____  _   _  ____    _  _____ ___ ___  _   _ 
| ____|  _ \| | | |/ ___|  / \|_   _|_ _/ _ \| \ | |
|  _| | | | | | | | |     / _ \ | |  | | | | |  \| |
| |___| |_| | |_| | |___ / ___ \| |  | | |_| | |\  |
|_____|____/ \___/ \____/_/   \_\_| |___\___/|_| \_|
        </pre>
      </div>
    </div>

    <!-- Education cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" data-ascii-education-list set:html={renderAsciiEducationHtml(education, 'en')} />

    <!-- Certifications sub-block -->
    <div class="space-y-4 pt-4 border-t border-[var(--border)]">
      <span class="text-xs text-[var(--signal)] font-semibold tracking-wider block">// 04B. CERTIFICATIONS</span>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-ascii-certifications-list set:html={renderAsciiCertificationsHtml(certifications, 'en')} />
    </div>
  </div>
</section>
