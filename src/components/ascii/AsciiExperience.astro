---
import { portfolioData } from '../../data/portfolio';
import { renderAsciiExperienceHtml } from './ascii-renderers';
const { experience } = portfolioData;
---

<section id="experience" class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)] font-mono">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- ASCII Title Banner -->
    <div class="space-y-2">
      <span class="text-xs text-[var(--signal)] font-semibold tracking-wider">// 03. SECTION_EXPERIENCE</span>
      <div class="overflow-x-auto py-1">
        <pre
          data-ascii-banner="EXPERIENCE"
          class="font-mono text-[9px] sm:text-[13px] md:text-[15px] font-bold text-[var(--fg)] tracking-tight leading-[1.1] select-all cursor-pointer"
          aria-label="EXPERIENCE"
          title="Click to re-decrypt"
        >
 _______  ______  _____ ____  ___ _____ _   _  ____ _____ 
| ____\ \/ /  _ \| ____|  _ \|_ _| ____| \ | |/ ___| ____|
|  _|  \  /| |_) |  _| | |_) || ||  _| |  \| | |   |  _|  
| |___ /  \|  __/| |___|  _ < | || |___| |\  | |___| |___ 
|_____/_/\_\_|   |_____|_| \_\___|_____|_| \_|\____|_____|
        </pre>
      </div>
    </div>

    <!-- Experience Timeline in ASCII Monospace Style -->
    <div class="space-y-8" data-ascii-experience-list set:html={renderAsciiExperienceHtml(experience, 'en')} />
  </div>
</section>
