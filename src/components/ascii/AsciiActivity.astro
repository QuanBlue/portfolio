---
import { portfolioData } from '../../data/portfolio';
const { telemetry } = portfolioData;

const months = ['Dec', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov'];
const seed = [
  [0, 1, 2, 3, 1, 0, 2], [1, 2, 3, 2, 1, 1, 0], [0, 1, 1, 2, 3, 1, 0], [2, 3, 4, 3, 2, 1, 1],
  [1, 2, 2, 1, 0, 1, 2], [3, 4, 3, 2, 1, 0, 1], [1, 1, 2, 3, 4, 2, 1], [0, 2, 3, 1, 2, 3, 0],
  [2, 3, 4, 3, 2, 1, 2], [1, 1, 2, 3, 2, 1, 0], [3, 4, 4, 3, 2, 1, 1], [0, 1, 2, 3, 2, 1, 0],
  [2, 3, 1, 2, 3, 4, 1], [1, 2, 3, 2, 1, 0, 1], [3, 4, 3, 2, 1, 2, 3], [1, 0, 2, 3, 4, 3, 1],
  [2, 3, 4, 3, 2, 1, 0], [1, 2, 3, 1, 2, 3, 2], [0, 1, 2, 3, 4, 3, 1], [3, 4, 3, 2, 1, 0, 2],
  [1, 2, 1, 3, 4, 2, 1], [2, 3, 4, 3, 2, 1, 0], [1, 1, 2, 3, 2, 1, 2], [3, 4, 3, 2, 1, 0, 1],
  [2, 3, 4, 3, 2, 1, 2], [4, 4, 3, 2, 1, 2, 3],
];

const levelChar = ['·', '░', '▒', '▓', '█'];
---

<section id="activity" class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)] font-mono">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- ASCII Title Banner -->
    <div class="space-y-2">
      <span class="text-xs text-[var(--signal)] font-semibold tracking-wider">// 06. SECTION_TELEMETRY</span>
      <div class="overflow-x-auto py-1">
        <pre class="font-mono text-[9px] sm:text-[13px] md:text-[15px] font-bold text-[var(--fg)] tracking-tight leading-[1.1] select-all" aria-label="TELEMETRY">
 _____ _____ _     _____ __  __ _____ _____ ______   __
|_   _| ____| |   | ____|  \/  | ____|_   _|  _ \ \ / /
  | | |  _| | |   |  _| | |\/| |  _|   | | | |_) \ V / 
  | | | |___| |___| |___| |  | | |___  | | |  _ < | |  
  |_| |_____|_____|_____|_|  |_|_____| |_| |_| \_\|_|  
        </pre>
      </div>
    </div>

    <!-- 4 Stats Banner -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      <div class="ff-cross-box rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
        <span class="ff-cross-tl">+</span>
        <span class="ff-cross-tr">+</span>
        <span class="ff-cross-bl">+</span>
        <span class="ff-cross-br">+</span>
        <span class="text-[11px] text-[var(--muted-fg)] uppercase block">Uptime SLA</span>
        <span class="text-2xl sm:text-3xl font-black text-[var(--signal)] mt-1 block">{telemetry.uptimeSLA}</span>
        <span class="text-[10px] text-[var(--muted-fg)] mt-1 block">Zero SPOF platform</span>
      </div>

      <div class="ff-cross-box rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
        <span class="ff-cross-tl">+</span>
        <span class="ff-cross-tr">+</span>
        <span class="ff-cross-bl">+</span>
        <span class="ff-cross-br">+</span>
        <span class="text-[11px] text-[var(--muted-fg)] uppercase block">Throughput</span>
        <span class="text-2xl sm:text-3xl font-black text-[var(--fg)] mt-1 block">2,489</span>
        <span class="text-[10px] text-[var(--muted-fg)] mt-1 block">reqs/min telemetry</span>
      </div>

      <div class="ff-cross-box rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
        <span class="ff-cross-tl">+</span>
        <span class="ff-cross-tr">+</span>
        <span class="ff-cross-bl">+</span>
        <span class="ff-cross-br">+</span>
        <span class="text-[11px] text-[var(--muted-fg)] uppercase block">Kernel Pods</span>
        <span class="text-2xl sm:text-3xl font-black text-[var(--fg)] mt-1 block">48</span>
        <span class="text-[10px] text-[var(--muted-fg)] mt-1 block">Across 3 control planes</span>
      </div>

      <div class="ff-cross-box rounded-xl border border-[var(--border)] bg-[var(--card)] p-5">
        <span class="ff-cross-tl">+</span>
        <span class="ff-cross-tr">+</span>
        <span class="ff-cross-bl">+</span>
        <span class="ff-cross-br">+</span>
        <span class="text-[11px] text-[var(--muted-fg)] uppercase block">Deploy Health</span>
        <span class="text-2xl sm:text-3xl font-black text-[var(--signal)] mt-1 block">100%</span>
        <span class="text-[10px] text-[var(--muted-fg)] mt-1 block">SBOM + Trivy signed</span>
      </div>
    </div>

    <!-- Heatmap in ASCII style -->
    <div class="ff-panel p-6 sm:p-8 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border)] pb-4 text-xs">
        <div>
          <span class="font-bold text-[var(--fg)]">[ INFRASTRUCTURE_COMMIT_LOG ]</span>
          <span class="text-[var(--muted-fg)] ml-2">26-week telemetry stream</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] text-[var(--muted-fg)]">
          <span>Less</span>
          <span class="text-[var(--faint)]">·</span>
          <span class="text-emerald-700">░</span>
          <span class="text-emerald-500">▒</span>
          <span class="text-emerald-400">▓</span>
          <span class="text-emerald-300">█</span>
          <span>More</span>
        </div>
      </div>

      <!-- Grid matrix -->
      <div class="overflow-x-auto pb-2">
        <div class="inline-block min-w-full">
          <div class="flex items-center justify-between text-[10px] text-[var(--muted-fg)] pb-2 px-1">
            {months.map((m) => (
              <span>{m}</span>
            ))}
          </div>

          <div class="grid grid-flow-col grid-rows-7 gap-1.5 w-max">
            {seed.flat().map((lvl) => {
              const bg =
                lvl === 0
                  ? 'bg-[var(--border)]/40 text-[var(--muted-fg)]/30'
                  : lvl === 1
                  ? 'bg-emerald-950/40 text-emerald-700 border border-emerald-800/40'
                  : lvl === 2
                  ? 'bg-emerald-800/50 text-emerald-500 border border-emerald-600/50'
                  : lvl === 3
                  ? 'bg-emerald-600/60 text-emerald-300 border border-emerald-500'
                  : 'bg-emerald-400 text-black font-bold';
              return (
                <div
                  class={`size-3.5 sm:size-4 rounded-sm flex items-center justify-center text-[10px] transition-transform hover:scale-125 select-none ${bg}`}
                  title={`Level ${lvl} activity`}
                >
                  {levelChar[lvl]}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
