---
import { portfolioData } from '../../data/portfolio';
import { renderAsciiSkillChipsHtml, renderAsciiSkillGroupsHtml } from './ascii-renderers';
const { skills } = portfolioData;
const activeCount = skills.filter((s) => s.status === 'ACTIVE').length;
---

<section id="skills" class="scroll-mt-20 py-16 sm:py-24 border-b border-[var(--border)] font-mono">
  <div class="mx-auto max-w-[76rem] px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- ASCII Title Banner -->
    <div class="space-y-2">
      <span class="text-xs text-[var(--signal)] font-semibold tracking-wider">// 05. SECTION_SKILLS_&_ARCHITECTURE</span>
      <div class="overflow-x-auto py-1">
        <pre
          data-ascii-banner="SKILLS"
          class="font-mono text-[9px] sm:text-[13px] md:text-[15px] font-bold text-[var(--fg)] tracking-tight leading-[1.1] select-all cursor-pointer"
          aria-label="SKILLS"
          title="Click to re-decrypt"
        >
 ____  _  _____ _     _     ____  
/ ___|| |/ /_ _| |   | |   / ___| 
\___ \| ' / | || |   | |   \___ \ 
 ___) | . \ | || |___| |___ ___) |
|____/|_|\_\___|_____|_____|____/ 
        </pre>
      </div>
    </div>

    <!-- Dynamic Grouped Skills Grid (Derived from PortfolioData.skills) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" data-ascii-skill-groups set:html={renderAsciiSkillGroupsHtml(skills, 'en')} />

    <!-- Live Dynamic Skill Tag Cloud from Central Store -->
    <div class="ff-panel p-6 sm:p-7 space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--border)] pb-3 text-xs text-[var(--muted-fg)]">
        <span class="font-bold text-[var(--fg)]">[ ACTIVE_MODULES_REGISTER ]</span>
        <span class="text-[var(--signal)]" data-ascii-skills-status>
          {skills.length > 0 ? `● ${activeCount}/${skills.length} ACTIVE` : '○ EMPTY'}
        </span>
      </div>

      <div class="flex flex-wrap gap-2.5" data-ascii-skill-chips set:html={renderAsciiSkillChipsHtml(skills, 'en')} />
    </div>
  </div>
</section>
