---
import { portfolioData } from '../../data/portfolio';
const { certifications } = portfolioData;
---

<div class="dashboard-panel flex-shrink-0">
  <div class="panel-header text-zinc-800 dark:text-zinc-300">
    <span>Certificates.dat</span>
  </div>
  <div class="p-3 font-mono text-xs space-y-2">
    {certifications.map((cert) => (
      cert.color === 'yellow' ? (
        <div class="flex items-center gap-2 text-yellow-600 dark:text-yellow-400 bg-yellow-400/10 p-2 rounded border border-yellow-400/20 hover:border-yellow-400/50 hover:bg-yellow-400/20 transition cursor-default">
          <span class="animate-pulse text-sm" style={`animation-delay: ${cert.delay || '0s'}`}>★</span>
          {cert.name}
        </div>
      ) : (
        <div class="flex items-center gap-2 text-blue-600 dark:text-blue-400 bg-blue-400/10 p-2 rounded border border-blue-400/20 hover:border-blue-400/50 hover:bg-blue-400/20 transition cursor-default">
          <span class="animate-pulse text-sm" style={`animation-delay: ${cert.delay || '0s'}`}>★</span>
          {cert.name}
        </div>
      )
    ))}
  </div>
</div>
