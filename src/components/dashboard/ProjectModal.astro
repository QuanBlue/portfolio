---
import { portfolioData } from '../../data/portfolio';
---

<div
  id="project-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div
    class="w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-3xl border border-[var(--card-border)] bg-[var(--bg-body)] shadow-2xl transform scale-95 transition-transform duration-300 p-7"
    id="project-modal-content"
  >
    <div class="flex justify-between items-start gap-4 mb-4">
      <h2 id="modal-title" class="font-display text-2xl font-bold text-[var(--heading)]">Project</h2>
      <button
        id="modal-close-btn"
        type="button"
        aria-label="Close"
        class="w-8 h-8 shrink-0 rounded-full flex items-center justify-center text-[var(--muted)] hover:text-[var(--heading)] hover:bg-black/5 dark:hover:bg-white/10 transition cursor-pointer"
      >
        ✕
      </button>
    </div>

    <div id="modal-media" class="hidden mb-6">
      <div class="rounded-2xl overflow-hidden border border-[var(--card-border)] bg-zinc-200 dark:bg-zinc-900">
        <img id="modal-media-main" src="" alt="" class="w-full max-h-[50vh] object-contain bg-black/5" />
      </div>
      <p id="modal-media-caption" class="text-xs text-[var(--muted)] mt-2 min-h-4"></p>
      <div id="modal-media-thumbs" class="flex gap-2 mt-2 overflow-x-auto pb-1"></div>
    </div>

    <p id="modal-desc" class="text-sm leading-relaxed text-[var(--text-body)] mb-6"></p>

    <div id="modal-tags" class="flex flex-wrap gap-1.5 mb-8 font-mono"></div>

    <div class="flex justify-end gap-3">
      <button id="modal-cancel-btn" type="button" class="btn">Close</button>
      <a id="modal-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-primary">View repository ↗</a>
    </div>
  </div>
</div>
<script define:vars={{ projects: portfolioData.projects }}>
  function initProjectModal() {
    const modal = document.getElementById('project-modal');
    const modalContent = document.getElementById('project-modal-content');
    const closeBtn = document.getElementById('modal-close-btn');
    const cancelBtn = document.getElementById('modal-cancel-btn');
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    const modalLink = document.getElementById('modal-link');
    const modalTags = document.getElementById('modal-tags');

    const findProject = (id) =>
      ((window.__PORTFOLIO__ && window.__PORTFOLIO__.projects) || projects).find((p) => p.id === id);

    const mediaBox = document.getElementById('modal-media');
    const mediaMain = document.getElementById('modal-media-main');
    const mediaCaption = document.getElementById('modal-media-caption');
    const mediaThumbs = document.getElementById('modal-media-thumbs');
    const okSrc = (s) => /^(https?:\/\/|\/|data:image\/)/i.test(String(s || ''));

    function showMedia(m) {
      mediaMain.src = m.src;
      mediaMain.alt = m.caption || '';
      mediaCaption.textContent = m.caption || '';
      mediaThumbs.querySelectorAll('button').forEach((b) => {
        b.classList.toggle('ring-2', b.dataset.src === m.src);
      });
    }

    function renderMedia(data) {
      const items = (data.media || []).filter((m) => okSrc(m.src));
      mediaThumbs.innerHTML = '';
      if (!items.length) {
        mediaBox.classList.add('hidden');
        mediaMain.removeAttribute('src');
        return;
      }
      mediaBox.classList.remove('hidden');
      items.forEach((m) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.dataset.src = m.src;
        b.className = 'shrink-0 w-16 h-12 rounded-lg overflow-hidden border border-[var(--card-border)] ring-emerald-500 cursor-pointer' + (items.length < 2 ? ' hidden' : '');
        const im = document.createElement('img');
        im.src = m.src;
        im.alt = '';
        im.className = 'w-full h-full object-cover';
        b.appendChild(im);
        b.addEventListener('click', () => showMedia(m));
        mediaThumbs.appendChild(b);
      });
      showMedia(items[0]);
    }

    function openModal(id) {
      const data = findProject(id);
      if (!data || !modal || !modalContent) return;

      if (modalTitle) modalTitle.textContent = data.title;
      if (modalDesc) modalDesc.textContent = data.description;
      if (modalLink) modalLink.href = /^https?:\/\//i.test(data.link) ? data.link : '#';

      renderMedia(data);

      if (modalTags) {
        modalTags.innerHTML = '';
        data.tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = 'chip';
          span.textContent = tag;
          modalTags.appendChild(span);
        });
      }

      modal.classList.remove('hidden');
      void modal.offsetWidth;
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
    }

    function closeModal() {
      if (!modal || !modalContent) return;
      modal.classList.add('opacity-0');
      modalContent.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    // Attach click listeners to cards
    document.addEventListener('click', (e) => {
      const card = e.target.closest && e.target.closest('.project-card-trigger');
      if (!card) return;
      const id = card.getAttribute('data-project-id');
      if (id) openModal(id);
    });

    document.querySelectorAll('[data-project-trigger]').forEach((el) => {
      el.addEventListener('click', () => {
        const id = el.getAttribute('data-project-trigger');
        if (id) openModal(id);
      });
    });

    if (closeBtn) closeBtn.onclick = closeModal;
    if (cancelBtn) cancelBtn.onclick = closeModal;

    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) closeModal();
      };
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Expose for terminal command execution
    window.openProjectModal = openModal;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectModal);
  } else {
    initProjectModal();
  }
</script>
