---
import { portfolioData } from '../../data/portfolio';
---

<div
  id="project-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div
    class="dashboard-panel w-[90%] max-w-lg shadow-2xl transform scale-95 transition-transform duration-300 border-zinc-300 dark:border-zinc-700"
    id="project-modal-content"
  >
    <div class="panel-header bg-zinc-200 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Service_Inspect.info
      </span>
      <button
        id="modal-close-btn"
        type="button"
        aria-label="Close modal"
        class="text-zinc-500 hover:text-red-500 dark:hover:text-red-400 transition cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    
    <div class="p-6">
      <div class="flex justify-between items-start mb-4">
        <h2 id="modal-title" class="text-xl font-bold text-zinc-900 dark:text-white font-mono">Project Name</h2>
        <span class="px-2 py-1 text-[10px] font-mono rounded bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
          ONLINE
        </span>
      </div>
      
      <p id="modal-desc" class="text-sm text-zinc-700 dark:text-zinc-300 mb-6 leading-relaxed">
        Description goes here.
      </p>

      <div class="mb-6">
        <h3 class="text-xs font-mono text-zinc-500 mb-2 uppercase">Tech Stack</h3>
        <div id="modal-tags" class="flex flex-wrap gap-2 font-mono text-[10px]">
          <!-- Tags injected via JS -->
        </div>
      </div>

      <div class="flex justify-end gap-3 pt-4 border-t border-zinc-200 dark:border-zinc-800">
        <button
          id="modal-cancel-btn"
          type="button"
          class="px-4 py-2 rounded border border-zinc-300 dark:border-zinc-700 text-sm text-zinc-700 dark:text-zinc-300 font-mono hover:bg-zinc-100 dark:hover:bg-zinc-800 transition cursor-pointer"
        >
          Close
        </button>
        <a
          id="modal-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-mono flex items-center gap-2 transition shadow-lg shadow-emerald-500/20"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2A10 10 0 002 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.45-1.15-1.11-1.46-1.11-1.46-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0012 2z"></path>
          </svg>
          Git_Repository
        </a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ projects: portfolioData.projects }}>
  function initProjectModal() {
    const modal = document.getElementById('project-modal');
    const modalContent = document.getElementById('project-modal-content');
    const closeBtn = document.getElementById('modal-close-btn');
    const cancelBtn = document.getElementById('modal-cancel-btn');
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    const modalLink = document.getElementById('modal-link');
    const modalTags = document.getElementById('modal-tags');

    const projectsMap = {};
    projects.forEach((p) => {
      projectsMap[p.id] = p;
    });

    function openModal(id) {
      const data = projectsMap[id];
      if (!data || !modal || !modalContent) return;

      if (modalTitle) modalTitle.textContent = data.title;
      if (modalDesc) modalDesc.textContent = data.description;
      if (modalLink) modalLink.href = data.link;

      if (modalTags) {
        modalTags.innerHTML = '';
        data.tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = 'bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 px-2 py-1 rounded text-zinc-700 dark:text-zinc-300';
          span.textContent = tag;
          modalTags.appendChild(span);
        });
      }

      modal.classList.remove('hidden');
      void modal.offsetWidth;
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
    }

    function closeModal() {
      if (!modal || !modalContent) return;
      modal.classList.add('opacity-0');
      modalContent.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    // Attach click listeners to cards
    document.querySelectorAll('.project-card-trigger').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-project-id');
        if (id) openModal(id);
      });
    });

    document.querySelectorAll('[data-project-trigger]').forEach((el) => {
      el.addEventListener('click', () => {
        const id = el.getAttribute('data-project-trigger');
        if (id) openModal(id);
      });
    });

    if (closeBtn) closeBtn.onclick = closeModal;
    if (cancelBtn) cancelBtn.onclick = closeModal;

    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) closeModal();
      };
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Expose for terminal command execution
    window.openProjectModal = openModal;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectModal);
  } else {
    initProjectModal();
  }
</script>
