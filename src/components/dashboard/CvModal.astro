---
import { portfolioData } from '../../data/portfolio';
import { renderCvSheetHtml } from '../../lib/render';

const { identity } = portfolioData;
const initialCvHtml = renderCvSheetHtml(portfolioData);
---

<div
  id="cv-modal"
  class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-250 p-2 sm:p-5"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cv-modal-title"
>
  <div
    id="cv-modal-content"
    class="w-full max-w-4xl max-h-[92vh] flex flex-col rounded-2xl border border-[var(--line-strong)] bg-[var(--card)] shadow-2xl transform scale-95 transition-transform duration-250 overflow-hidden"
  >
    <!-- Top Sticky Modal Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-3 px-4 sm:px-6 py-3 border-b border-[var(--border)] bg-[var(--muted-bg)]/80 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <span class="grid size-9 place-items-center rounded-lg border border-[var(--signal)]/40 bg-emerald-500/10 text-[var(--signal)] shrink-0">
          <i class="fa-regular fa-file-lines text-sm"></i>
        </span>
        <div class="min-w-0">
          <h2 id="cv-modal-title" class="text-sm sm:text-base font-bold text-[var(--fg)] truncate">
            Curriculum Vitae — <span data-bind="name">{identity.name}</span>
          </h2>
          <p class="font-mono text-[11px] text-[var(--muted-fg)] truncate">
            <span data-bind="role">{identity.role}</span> · <span data-bind="location">{identity.location}</span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <!-- Dual View Switcher (Web CV vs Dynamic PDF) -->
        <div id="cv-mode-switcher" class="inline-flex rounded-lg border border-[var(--border)] bg-[var(--bg)] p-0.5 font-mono text-[11px]">
          <button type="button" id="cv-tab-web" class="px-3 py-1 rounded-md bg-[var(--card)] text-[var(--fg)] font-semibold cursor-pointer transition">Web CV</button>
          <button type="button" id="cv-tab-pdf" class="px-3 py-1 rounded-md text-[var(--muted-fg)] hover:text-[var(--fg)] cursor-pointer transition">PDF File</button>
        </div>

        <!-- Print Action -->
        <button
          id="cv-print-btn"
          type="button"
          class="hidden sm:inline-flex h-8 items-center gap-1.5 rounded-lg border border-[var(--border)] bg-[var(--card)] px-3 text-xs font-mono font-medium text-[var(--fg)] hover:border-[var(--line-strong)] cursor-pointer transition"
          title="In CV ra khổ A4 / Lưu PDF trình duyệt"
        >
          <i class="fa-solid fa-print text-xs"></i>
          <span>Print</span>
        </button>

        <!-- Direct Download PDF Button (Generates from current data) -->
        <button
          id="cv-download-btn"
          type="button"
          class="inline-flex h-8 items-center gap-1.5 rounded-lg bg-[var(--signal)] px-3 text-xs font-mono font-semibold text-zinc-950 hover:opacity-90 active:scale-[0.98] cursor-pointer transition"
          title="Tải file PDF tự động gen từ dữ liệu"
        >
          <i class="fa-solid fa-download text-xs"></i>
          <span id="cv-download-btn-text">Download CV</span>
        </button>

        <!-- Close Modal Button -->
        <button
          id="cv-close-btn"
          type="button"
          aria-label="Close CV modal"
          class="inline-flex size-8 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--card)] text-[var(--muted-fg)] hover:text-[var(--fg)] hover:border-[var(--line-strong)] cursor-pointer transition"
        >
          ✕
        </button>
      </div>
    </div>

    <!-- Scrollable CV Body -->
    <div class="flex-1 overflow-y-auto p-3 sm:p-6 bg-zinc-950/70 custom-scrollbar">
      <!-- View 1: Authentic A4 Paper CV Sheet (Generated dynamically matching attached PDF design) -->
      <article
        id="cv-sheet-view"
        class="mx-auto max-w-[850px] bg-white text-zinc-900 rounded-lg shadow-2xl p-6 sm:p-10 font-sans border border-zinc-200 select-text leading-normal"
      >
        <Fragment set:html={initialCvHtml} />
      </article>

      <!-- View 2: High-Fidelity Dynamically-Generated PDF Preview -->
      <div id="cv-pdf-view" class="hidden flex-col h-[76vh] w-full rounded-xl border border-[var(--border)] overflow-hidden bg-zinc-900 shadow-xl">
        <!-- PDF Viewer Quick Controls Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-2.5 border-b border-zinc-800 bg-zinc-950 text-xs font-mono text-zinc-400 shrink-0">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span id="cv-pdf-filename" class="text-zinc-200 font-semibold">CV-Generated.pdf</span>
            <span class="text-emerald-400 text-[11px] hidden sm:inline">(Tự động gen từ dữ liệu Portfolio)</span>
          </div>
          <div class="flex items-center gap-2">
            <a
              id="cv-pdf-external-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded border border-zinc-700 hover:border-zinc-500 text-zinc-200 hover:text-white transition cursor-pointer"
            >
              <span>Mở tab mới ↗</span>
            </a>
            <button
              id="cv-pdf-direct-download"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30 transition font-semibold cursor-pointer"
            >
              <i class="fa-solid fa-download text-[11px]"></i>
              <span>Tải file PDF</span>
            </button>
          </div>
        </div>

        <!-- Embedded Generated PDF Preview or Loading State -->
        <div class="flex-1 w-full h-full relative bg-zinc-900">
          <!-- Loading State -->
          <div id="cv-pdf-loading" class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center gap-3 bg-zinc-900 z-10">
            <div class="size-8 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
            <p class="font-mono text-xs text-zinc-300">Đang tạo file PDF trực tiếp từ dữ liệu Portfolio...</p>
            <p class="font-mono text-[11px] text-zinc-500">Render đồ họa A4 độ phân giải cao</p>
          </div>

          <!-- PDF Iframe -->
          <iframe
            id="cv-pdf-iframe"
            title="CV PDF Preview"
            class="w-full h-full border-0 hidden"
          >
          </iframe>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  @media print {
    body * {
      visibility: hidden !important;
    }
    #cv-sheet-view, #cv-sheet-view * {
      visibility: visible !important;
    }
    #cv-sheet-view {
      position: absolute !important;
      left: 0 !important;
      top: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
      background: #ffffff !important;
      color: #111827 !important;
    }
    @page {
      size: A4;
      margin: 10mm 15mm;
    }
  }
</style>

<script>
  import { portfolioData, type PortfolioData } from '../../data/portfolio';
  import { renderCvSheetHtml } from '../../lib/render';

  function initCvModal() {
    const modal = document.getElementById('cv-modal');
    const content = document.getElementById('cv-modal-content');
    const closeBtn = document.getElementById('cv-close-btn');
    const downloadBtn = document.getElementById('cv-download-btn');
    const downloadBtnText = document.getElementById('cv-download-btn-text');
    const printBtn = document.getElementById('cv-print-btn');
    const tabWeb = document.getElementById('cv-tab-web');
    const tabPdf = document.getElementById('cv-tab-pdf');
    const sheetView = document.getElementById('cv-sheet-view');
    const pdfView = document.getElementById('cv-pdf-view');
    const pdfIframe = document.getElementById('cv-pdf-iframe') as HTMLIFrameElement | null;
    const pdfLoading = document.getElementById('cv-pdf-loading');
    const pdfFilename = document.getElementById('cv-pdf-filename');
    const externalLink = document.getElementById('cv-pdf-external-link') as HTMLAnchorElement | null;
    const directDownload = document.getElementById('cv-pdf-direct-download');

    if (!modal || !content) return;

    let currentData: PortfolioData = (window as any).__PORTFOLIO__ ?? portfolioData;
    let activeTab: 'web' | 'pdf' = 'web';
    let cachedPdfBlobUrl: string | null = null;
    let isGenerating = false;

    function getCvFileName(): string {
      const safeName = (currentData.identity?.name || 'Nguyen-Thanh-Quan')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\s+/g, '-');
      return `${safeName}-CV.pdf`;
    }

    async function generatePdfBlob(): Promise<string> {
      if (!sheetView) throw new Error('CV sheet element not found');

      const fileName = getCvFileName();
      const html2pdfModule = await import('html2pdf.js');
      const html2pdf = (html2pdfModule as any).default || html2pdfModule;

      const opt = {
        margin: [6, 8, 6, 8] as [number, number, number, number],
        filename: fileName,
        image: { type: 'jpeg' as const, quality: 0.98 },
        enableLinks: true,
        html2canvas: {
          scale: 2,
          useCORS: true,
          logging: false,
          backgroundColor: '#ffffff',
        },
        jsPDF: {
          unit: 'mm',
          format: 'a4',
          orientation: 'portrait' as const,
        },
      };

      const worker = html2pdf().set(opt).from(sheetView);
      const blob: Blob = await worker.outputPdf('blob');

      if (cachedPdfBlobUrl) {
        URL.revokeObjectURL(cachedPdfBlobUrl);
      }
      cachedPdfBlobUrl = URL.createObjectURL(blob);
      return cachedPdfBlobUrl;
    }

    async function loadPdfPreview() {
      if (!pdfView || !pdfIframe) return;

      const fileName = getCvFileName();
      if (pdfFilename) pdfFilename.textContent = fileName;

      if (cachedPdfBlobUrl) {
        pdfIframe.src = `${cachedPdfBlobUrl}#view=FitH`;
        pdfIframe.classList.remove('hidden');
        pdfLoading?.classList.add('hidden');
        if (externalLink) externalLink.href = cachedPdfBlobUrl;
        return;
      }

      pdfIframe.classList.add('hidden');
      pdfLoading?.classList.remove('hidden');

      try {
        isGenerating = true;
        const blobUrl = await generatePdfBlob();
        pdfIframe.src = `${blobUrl}#view=FitH`;
        pdfIframe.classList.remove('hidden');
        pdfLoading?.classList.add('hidden');
        if (externalLink) externalLink.href = blobUrl;
      } catch (err) {
        console.error('Failed to generate PDF:', err);
        if (pdfLoading) {
          pdfLoading.innerHTML = `
            <div class="text-amber-400 font-mono text-xs space-y-2">
              <p>⚠️ Không thể kết xuất PDF trong trình duyệt.</p>
              <button id="cv-pdf-retry" type="button" class="px-3 py-1 rounded bg-zinc-800 text-white hover:bg-zinc-700">Thử lại</button>
            </div>
          `;
          document.getElementById('cv-pdf-retry')?.addEventListener('click', loadPdfPreview);
        }
      } finally {
        isGenerating = false;
      }
    }

    function switchCvTab(mode: 'web' | 'pdf') {
      activeTab = mode;
      const isWeb = mode === 'web';
      sheetView?.classList.toggle('hidden', !isWeb);
      pdfView?.classList.toggle('hidden', isWeb);
      pdfView?.classList.toggle('flex', !isWeb);

      if (tabWeb && tabPdf) {
        tabWeb.className = isWeb
          ? 'px-3 py-1 rounded-md bg-[var(--card)] text-[var(--fg)] font-semibold cursor-pointer transition'
          : 'px-3 py-1 rounded-md text-[var(--muted-fg)] hover:text-[var(--fg)] cursor-pointer transition';
        tabPdf.className = !isWeb
          ? 'px-3 py-1 rounded-md bg-[var(--card)] text-[var(--fg)] font-semibold cursor-pointer transition'
          : 'px-3 py-1 rounded-md text-[var(--muted-fg)] hover:text-[var(--fg)] cursor-pointer transition';
      }

      if (!isWeb) {
        loadPdfPreview();
      }
    }

    function printCvSheet() {
      switchCvTab('web');
      setTimeout(() => {
        window.print();
      }, 100);
    }

    async function downloadCvPdf() {
      if (isGenerating) return;

      const fileName = getCvFileName();

      // If cached blob already exists, download directly
      if (cachedPdfBlobUrl) {
        const a = document.createElement('a');
        a.href = cachedPdfBlobUrl;
        a.download = fileName;
        a.click();
        return;
      }

      // Otherwise generate and save
      if (downloadBtn && downloadBtnText) {
        const prevText = downloadBtnText.textContent;
        downloadBtnText.textContent = 'Generating...';
        downloadBtn.setAttribute('disabled', 'true');

        try {
          isGenerating = true;
          const blobUrl = await generatePdfBlob();
          const a = document.createElement('a');
          a.href = blobUrl;
          a.download = fileName;
          a.click();
        } catch (err) {
          console.error('Error generating PDF for download:', err);
          window.print();
        } finally {
          isGenerating = false;
          downloadBtnText.textContent = prevText;
          downloadBtn.removeAttribute('disabled');
        }
      }
    }

    function syncCvData(d: PortfolioData) {
      currentData = d;
      // Invalidate cached PDF blob whenever data changes
      if (cachedPdfBlobUrl) {
        URL.revokeObjectURL(cachedPdfBlobUrl);
        cachedPdfBlobUrl = null;
      }

      // Re-render sheet HTML dynamically from PortfolioData
      if (sheetView) {
        sheetView.innerHTML = renderCvSheetHtml(d);
      }

      // If currently on PDF tab, regenerate preview
      if (activeTab === 'pdf') {
        loadPdfPreview();
      }
    }

    function openCvModal() {
      syncCvData((window as any).__PORTFOLIO__ ?? portfolioData);
      modal.classList.remove('hidden');
      void modal.offsetWidth;
      modal.classList.remove('opacity-0');
      content.classList.remove('scale-95');
    }

    function closeCvModal() {
      modal.classList.add('opacity-0');
      content.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 250);
    }

    tabWeb?.addEventListener('click', () => switchCvTab('web'));
    tabPdf?.addEventListener('click', () => switchCvTab('pdf'));
    closeBtn?.addEventListener('click', closeCvModal);
    printBtn?.addEventListener('click', printCvSheet);
    downloadBtn?.addEventListener('click', downloadCvPdf);
    directDownload?.addEventListener('click', downloadCvPdf);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeCvModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeCvModal();
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const openTrigger = target.closest?.('[data-open-cv]');
      if (openTrigger) {
        e.preventDefault();
        openCvModal();
        return;
      }
      const dlTrigger = target.closest?.('[data-download-cv]');
      if (dlTrigger) {
        e.preventDefault();
        syncCvData((window as any).__PORTFOLIO__ ?? portfolioData);
        downloadCvPdf();
      }
    });

    window.addEventListener('portfolio:data', (e) => {
      const detail = (e as CustomEvent<PortfolioData>).detail;
      if (detail) syncCvData(detail);
    });

    (window as any).openCvModal = openCvModal;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCvModal);
  } else {
    initCvModal();
  }
</script>
