---
import { portfolioData } from '../../data/portfolio';
const { experience } = portfolioData;
---

<!-- Tabs/Commands matching mockup -->
<div class="flex gap-2 font-mono text-sm overflow-x-auto pb-1">
  <button
    id="btn-exp"
    onclick="if (window.logAction) window.logAction('Cat experience.log')"
    class="whitespace-nowrap px-4 py-2 bg-zinc-100 dark:bg-zinc-800 text-emerald-600 dark:text-emerald-400 border border-zinc-300 dark:border-zinc-700 rounded hover:bg-zinc-200 dark:hover:bg-zinc-700 transition cursor-pointer"
  >
    ./experience.sh
  </button>
  <button
    id="btn-proj"
    onclick="if (window.logAction) window.logAction('List projects/')"
    class="whitespace-nowrap px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-800 rounded hover:bg-zinc-50 dark:hover:bg-zinc-800 transition cursor-pointer"
  >
    ls projects/
  </button>
  <button
    id="btn-edu"
    onclick="if (window.logAction) window.logAction('Show education')"
    class="whitespace-nowrap px-4 py-2 bg-white dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-800 rounded hover:bg-zinc-50 dark:hover:bg-zinc-800 transition cursor-pointer"
  >
    cat edu.txt
  </button>
</div>

<!-- Content Area (Visual Timeline) matching mockup -->
<div class="dashboard-panel flex-grow overflow-y-auto">
  <div class="panel-header text-zinc-800 dark:text-zinc-300">
    <span>Main_Viewport</span>
    <span class="text-emerald-600 dark:text-emerald-400">ACTIVE</span>
  </div>
  <div class="p-6">
    <!-- Timeline Component -->
    <div class="relative border-l border-zinc-300 dark:border-zinc-700 ml-3 space-y-8">
      {experience.map((item) => (
        <div class="relative pl-6">
          <div
            class={`absolute w-3 h-3 rounded-full -left-[1.5px] top-1.5 ${
              item.isCurrent
                ? 'bg-emerald-500 shadow-[0_0_8px_#10b981]'
                : 'bg-zinc-400 dark:bg-zinc-600'
            }`}
          ></div>
          <div class="flex flex-col md:flex-row md:justify-between md:items-baseline mb-2">
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white">{item.role}</h3>
            <span
              class={`text-xs font-mono px-2 py-1 rounded mt-1 md:mt-0 w-max ${
                item.isCurrent
                  ? 'text-emerald-700 dark:text-emerald-400 bg-emerald-400/10'
                  : 'text-zinc-600 dark:text-zinc-400 bg-zinc-200 dark:bg-zinc-800'
              }`}
            >
              {item.period}
            </span>
          </div>
          <p class="text-zinc-700 dark:text-zinc-300 font-semibold mb-2">{item.company}</p>
          <ul class="text-sm space-y-2 text-zinc-600 dark:text-zinc-400">
            {item.bullets.map((b) => (
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 dark:text-emerald-500 mt-1">▹</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-2 mt-4 font-mono text-xs">
            {item.tags.map((tag) => (
              <span class="bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded text-zinc-700 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-700">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
