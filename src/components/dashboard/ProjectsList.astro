---
import { portfolioData } from '../../data/portfolio';
const { projects } = portfolioData;
---

<div class="dashboard-panel flex-shrink-0 flex flex-col max-h-[45%]">
  <div class="panel-header text-zinc-800 dark:text-zinc-300">
    <span>Deployed_Services.list</span>
    <span class="text-[10px] text-zinc-500 font-mono">{projects.length} ONLINE</span>
  </div>
  <div class="p-3 space-y-3 overflow-y-auto flex-grow custom-scrollbar">
    {projects.map((proj) => (
      <div
        class={`border border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/50 rounded-lg p-3 hover:border-emerald-500 dark:hover:border-emerald-500 transition cursor-pointer group relative overflow-hidden project-card-trigger`}
        data-project-id={proj.id}
      >
        <div class="absolute inset-0 bg-gradient-to-r from-emerald-500/0 to-emerald-500/10 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
        <div class="flex justify-between items-start mb-1 relative z-10">
          <h3 class="text-zinc-900 dark:text-white font-semibold text-sm group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition font-mono">
            {proj.title}
          </h3>
          <div
            class={`w-2 h-2 rounded-full ${
              proj.color === 'emerald'
                ? 'bg-emerald-500 shadow-[0_0_8px_#10b981]'
                : 'bg-blue-500 shadow-[0_0_8px_#3b82f6]'
            }`}
          ></div>
        </div>
        <p class="text-[11px] text-zinc-500 dark:text-zinc-400 line-clamp-2 relative z-10">
          {proj.shortDesc}
        </p>
      </div>
    ))}
  </div>
</div>
