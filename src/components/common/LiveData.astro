---
// Applies canonical published edits (Supabase in production, IndexedDB drafts in Local Mode) across all active themes.
---

<script>
  import { loadLiveData } from '../../lib/store';
  import { getSession, isOwnerSession } from '../../lib/supabase';
  import {
    safeUrl,
    renderNameWords,
    renderAvatar,
    renderSkills,
    renderCerts,
    renderExperience,
    renderEducation,
    renderProjects,
  } from '../../lib/render';
  import { getCareerSettings, resolveAvatarUrl, type PortfolioData } from '../../data/portfolio';
  import { getLocale } from '../../i18n/locale-store';
  import { localizePortfolioData } from '../../i18n/translate';

  getSession().then((session) => {
    const isOwner = isOwnerSession(session);
    const lbl = document.getElementById('hdr-admin-label');
    if (lbl && isOwner) {
      lbl.textContent = 'Admin';
    }
    const adminDot = document.getElementById('hdr-admin-dot');
    if (adminDot && isOwner) {
      adminDot.classList.remove('hidden');
    }
    if (isOwner) {
      document.querySelectorAll('.kn-admin-dot').forEach((dot) => {
        dot.classList.add('is-active');
      });
    }
  });

  const html = (id: string, markup: string) => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = markup;
  };
  const text = (sel: string, value: string) => {
    document.querySelectorAll(sel).forEach((el) => {
      el.textContent = value;
    });
  };

  let rawData: PortfolioData | null = null;

  function applyPortfolioData(data: PortfolioData, locale: 'en' | 'vi') {
    const d = localizePortfolioData(data, locale);
    const i = d.identity;
    const career = getCareerSettings(d);
    const showCv = Boolean(career.openToWork) && Boolean(career.cvUrl);
    const avatarUrl = resolveAvatarUrl(d);

    const activeExp = (d.experience || []).find((e) => e.isCurrent) || (d.experience || [])[0];
    const companyText = activeExp?.company?.trim() || '';

    text('[data-bind="name"]', i.name || '');
    html('bind-hero-name', renderNameWords(i.name || ''));
    text('[data-bind="role"]', i.role || '');
    text('[data-bind="location"]', i.location || '');
    text('[data-bind="bio"]', i.bio || '');
    if (i.node) text('[data-bind="node"]', i.node);
    if (i.ip) text('[data-bind="ip"]', i.ip);

    document.querySelectorAll<HTMLElement>('[data-bind-company]').forEach((el) => {
      if (companyText) {
        el.textContent = el.dataset.companyPrefix ? `${el.dataset.companyPrefix}${companyText}` : companyText;
        el.classList.remove('hidden');
      } else {
        el.textContent = '';
        el.classList.add('hidden');
      }
    });

    document.querySelectorAll<HTMLAnchorElement>('[data-bind="email"]').forEach((a) => {
      if (a.dataset.bindKeepText !== 'true') {
        a.textContent = i.email || '';
      }
      a.href = i.email ? `mailto:${i.email}` : '#';
    });

    for (const key of ['linkedin', 'github'] as const) {
      const social = i[key];
      document.querySelectorAll<HTMLAnchorElement>(`[data-bind="${key}"]`).forEach((a) => {
        a.href = safeUrl(social?.url);
      });
      document.querySelectorAll<HTMLElement>(`[data-bind-handle="${key}"]`).forEach((el) => {
        el.textContent = social?.handle || '';
      });
    }

    // Career availability & CV gating across all themes
    document.querySelectorAll<HTMLElement>('[data-career-badge]').forEach((el) => {
      el.classList.toggle('hidden', !career.openToWork);
    });
    document.querySelectorAll<HTMLElement>('[data-cv-gate]').forEach((el) => {
      el.classList.toggle('hidden', !showCv);
    });

    // Render avatars cleanly across standard, ASCII, Editorial, and Modern Mono
    html('bind-avatar', renderAvatar(i));
    html('bind-avatar-forkfolio', renderAvatar(i));
    document.querySelectorAll<HTMLImageElement>('img[data-bind="avatar"]').forEach((img) => {
      if (avatarUrl) {
        img.src = avatarUrl;
        img.classList.remove('hidden');
      } else {
        img.removeAttribute('src');
        img.classList.add('hidden');
      }
    });

    html('bind-skills', renderSkills(d.skills || [], locale === 'vi' ? '[ Chưa có kỹ năng đăng tải ]' : '[ No published skills ]'));
    html('bind-certs', renderCerts(d.certifications || [], locale === 'vi' ? '[ Chưa có chứng chỉ đăng tải ]' : '[ No published certifications ]'));
    html('bind-experience', renderExperience(d.experience || [], locale === 'vi' ? '[ Chưa có kinh nghiệm đăng tải ]' : '[ No published experience ]'));
    html('bind-education', renderEducation(d.education || [], locale === 'vi' ? '[ Chưa có học vấn đăng tải ]' : '[ No published education ]'));
    html('bind-projects', renderProjects(d.projects || [], locale === 'vi' ? '[ Chưa có dự án đăng tải ]' : '[ No published projects ]'));

    text('#count-projects', String((d.projects || []).length));
    text('#count-skills', String((d.skills || []).length));
    text('#count-gallery', String((d.gallery ?? []).filter((g) => Boolean(g.image && g.image.trim())).length));

    (window as any).__PORTFOLIO_LOCALIZED__ = d;
    window.dispatchEvent(
      new CustomEvent('portfolio:data', {
        detail: {
          ...d,
          _raw: data,
          _locale: locale,
          _source: (window as any).__PORTFOLIO_SOURCE__ || 'build-default',
        },
      }),
    );
    window.dispatchEvent(new Event('scroll'));
  }

  loadLiveData()
    .then((d) => {
      rawData = d;
      const override = (window as any).__PORTFOLIO_OVERRIDE__ as Partial<PortfolioData> | null;
      const remotePublishedTheme = override?.appearance?.activeTheme || override?.identity?.themeVariant;
      if (remotePublishedTheme) {
        try {
          localStorage.setItem('portfolio-published-theme', remotePublishedTheme);
          localStorage.setItem('user-theme-variant', remotePublishedTheme);
        } catch (e) {}
      }
      const currentLocale = getLocale();
      applyPortfolioData(rawData, currentLocale);
      (window as any).__resolvePortfolioReady__?.(d);
    })
    .catch(() => {
      (window as any).__resolvePortfolioReady__?.(null);
    });

  window.addEventListener('locale:changed', (e: Event) => {
    const loc = ((e as CustomEvent).detail?.locale as 'en' | 'vi') || 'en';
    if (rawData) {
      applyPortfolioData(rawData, loc);
    }
  });
</script>
