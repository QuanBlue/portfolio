---
interface Props {
  name?: string;
}
const { name = 'Nguyen Thanh Quan' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="kn-foot">
  <span>© {currentYear} <span data-kn-footer-name="true">{name}</span></span>
  <span class="kn-cur" aria-hidden="true"></span>
</footer>
