---
import './styles/knight.css';
import './styles/animations.css';
import KnightNav from './components/KnightNav.astro';
import KnightHero from './sections/KnightHero.astro';
import KnightAbout from './sections/KnightAbout.astro';
import KnightExperience from './sections/KnightExperience.astro';
import KnightEducation from './sections/KnightEducation.astro';
import KnightCertifications from './sections/KnightCertifications.astro';
import KnightSkills from './sections/KnightSkills.astro';
import KnightProjects from './sections/KnightProjects.astro';
import KnightMoreWork from './sections/KnightMoreWork.astro';
import KnightActivity from './sections/KnightActivity.astro';
import KnightContact from './sections/KnightContact.astro';

import { portfolioData } from '../../data/portfolio';
import {
  getKnightProfile,
  getKnightProjects,
  getKnightMoreProjects,
  getKnightActivityResolution,
} from '../core/data-adapter';

const profile = getKnightProfile(portfolioData);
const featuredProjects = getKnightProjects(portfolioData);
const moreProjects = getKnightMoreProjects(portfolioData);
const activity = getKnightActivityResolution(portfolioData, 'en');
---

<div
  class="kn"
  data-kn-root="true"
  data-kn-status="loading"
  data-seed="quanblue"
  data-labels='{"hero":"","about":"about","experience":"experience","education":"education","certifications":"certifications","skills":"skills","projects":"projects","work":"more projects","activity":"activity","contact":"contact"}'
>
  <!-- Minimal Knight Monospace Loading State -->
  <div id="knight-loader" class="kn-loader" aria-live="polite" aria-label="Initializing Knight theme">
    <div class="kn-loader-box">
      <div class="kn-loader-title">INITIALIZING KNIGHT</div>
      <div class="kn-loader-meter" aria-hidden="true">
        <span class="kn-loader-blocks">[ ■■■■□□□□ ]</span>
      </div>
      <div class="kn-loader-sub">Preparing ASCII renderer...</div>
    </div>
  </div>

  <KnightNav name={profile.name} />
  <KnightHero profile={profile} />
  <KnightAbout profile={profile} />
  <KnightExperience experience={portfolioData.experience} />
  <KnightEducation education={portfolioData.education} />
  <KnightCertifications certifications={portfolioData.certifications} />
  <KnightSkills skills={portfolioData.skills} />
  <KnightProjects projects={featuredProjects} />
  <KnightMoreWork moreProjects={moreProjects} />
  <KnightActivity activity={activity} />
  <KnightContact profile={profile} />
</div>

<script>
  import { setupKnightInteractions } from './scripts/interactions';
  import { initKnightStage } from './scripts/knight-stage';
  import { initKnightScroll, type KnightScrollController } from './scripts/knight-scroll';
  import { formatKnightAsciiTitle } from '../core/ascii-title';
  import {
    getKnightProjects,
    getKnightMoreProjects,
    getKnightActivityResolution,
  } from '../core/data-adapter';
  import {
    renderKnightExperience,
    renderKnightEducation,
    renderKnightCertifications,
    renderKnightSkills,
    renderKnightProjects,
    renderKnightMoreWork,
    renderKnightActivity,
  } from '../core/render-knight';
  import { getCareerSettings, portfolioData, resolveAvatarUrl, type PortfolioData } from '../../data/portfolio';
  import { initials, safeUrl } from '../../lib/render';
  import { localizePortfolioData } from '../../i18n/translate';

  // Knight Theme Interactive Runtime Controller
  let teardown: (() => void) | null = null;
  let stopStage: (() => void) | null = null;
  let scrollController: KnightScrollController | null = null;
  let safetyTimer: ReturnType<typeof setTimeout> | null = null;
  let transitionTimer: ReturnType<typeof setTimeout> | null = null;
  let isKnightActive = false;
  let knightInitToken = 0;
  let lastAppliedAvatarKey = '';

  function normalizeAsciiName(rawName: string): string {
    return (rawName || 'NGUYEN THANH QUAN')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[đĐ]/g, (m) => (m === 'đ' ? 'd' : 'D'));
  }

  function revealKnight(root: HTMLElement, _source: string, isFallback = false) {
    if (safetyTimer) {
      clearTimeout(safetyTimer);
      safetyTimer = null;
    }
    if (root.dataset.knStatus === 'running') return;
    root.dataset.knStatus = isFallback ? 'fallback' : 'ready';

    if (transitionTimer) clearTimeout(transitionTimer);
    transitionTimer = setTimeout(() => {
      if (root.dataset.knStatus === 'ready' || root.dataset.knStatus === 'fallback') {
        root.dataset.knStatus = isFallback ? 'fallback' : 'running';
        const loader = root.querySelector<HTMLElement>('#knight-loader');
        if (loader) loader.style.display = 'none';
      }
    }, 220);
  }

  function updateKnightLabels(root: HTMLElement, locale: 'en' | 'vi', personName?: string) {
    const isVi = locale === 'vi';
    const navItems = root.querySelectorAll<HTMLElement>('[data-kn-nk]');
    const navMap: Record<string, string> = isVi
      ? {
          about: 'giới thiệu',
          experience: 'kinh nghiệm',
          education: 'học vấn',
          certifications: 'chứng chỉ',
          skills: 'kỹ năng',
          projects: 'dự án',
          contact: 'liên hệ',
          admin: 'quản trị ⚙',
        }
      : {
          about: 'about',
          experience: 'experience',
          education: 'education',
          certifications: 'certifications',
          skills: 'skills',
          projects: 'projects',
          contact: 'contact',
          admin: 'admin ⚙',
        };

    navItems.forEach((item) => {
      const key = item.dataset.knNk;
      if (key && navMap[key]) {
        if (key === 'admin') {
          if (item.childNodes[0]) item.childNodes[0].nodeValue = isVi ? 'quản trị ⚙' : 'admin ⚙';
        } else {
          item.textContent = navMap[key];
        }
      }
    });

    const stageLabels = isVi
      ? JSON.stringify({
          hero: '',
          about: 'giới thiệu',
          experience: 'kinh nghiệm',
          education: 'học vấn',
          certifications: 'chứng chỉ',
          skills: 'kỹ năng',
          projects: 'dự án',
          work: 'dự án khác',
          activity: 'hoạt động',
          contact: 'liên hệ',
        })
      : JSON.stringify({
          hero: '',
          about: 'about',
          experience: 'experience',
          education: 'education',
          certifications: 'certifications',
          skills: 'skills',
          projects: 'projects',
          work: 'more projects',
          activity: 'activity',
          contact: 'contact',
        });
    root.dataset.labels = stageLabels;

    const certH2 = root.querySelector<HTMLElement>('#kn-h-certifications');
    if (certH2) {
      const certTitle = isVi ? 'CHỨNG CHỈ' : 'CERTIFICATIONS';
      certH2.dataset.ld = certTitle;
      certH2.dataset.lm = certTitle;
      certH2.textContent = isVi ? 'Chứng chỉ' : 'Certifications';
      const kVal = (certTitle.length * 0.66 + 0.06).toFixed(3);
      certH2.style.setProperty('--kd', kVal);
      certH2.style.setProperty('--km', kVal);
    }

    const actH2 = root.querySelector<HTMLElement>('#kn-h-act');
    if (actH2) {
      const actTitle = isVi ? 'HOẠT ĐỘNG' : 'ACTIVITY';
      actH2.dataset.ld = actTitle;
      actH2.dataset.lm = actTitle;
      actH2.textContent = isVi ? 'Hoạt động' : 'Activity';
      const kVal = (actTitle.length * 0.66 + 0.06).toFixed(3);
      actH2.style.setProperty('--kd', kVal);
      actH2.style.setProperty('--km', kVal);
    }

    const shortName = (personName || root.querySelector('.kn-asc.kn-name')?.textContent || 'Quan')
      .trim()
      .split(/\s+/)
      .slice(-1)[0] || 'Quan';

    const contactPrompt = root.querySelector<HTMLElement>('[data-kn-contact-k="true"], .kn-end-box .kn-k');
    if (contactPrompt) {
      contactPrompt.textContent = isVi ? `Gửi tin nhắn cho ${shortName}` : `Write to ${shortName}`;
    }
    const notePrompt = root.querySelector<HTMLElement>('.kn-form-k');
    if (notePrompt) {
      notePrompt.textContent = isVi ? `hoặc để lại lời nhắn cho ${shortName} tại đây` : 'or leave a note here';
    }
    const submitBtn = root.querySelector<HTMLElement>('#knight-contact-form button[type="submit"]');
    if (submitBtn) {
      submitBtn.textContent = isVi ? 'Gửi tin nhắn' : 'Send message';
    }
    const nameInput = root.querySelector<HTMLInputElement>('#knight-contact-form input[name="name"]');
    if (nameInput) {
      nameInput.placeholder = isVi ? 'Nguyễn Văn A' : 'Jane Recruiter';
    }
    const emailInput = root.querySelector<HTMLInputElement>('#knight-contact-form input[name="email"]');
    if (emailInput) {
      emailInput.placeholder = isVi ? 'email@congty.com' : 'jane@company.com';
    }
    const msgInput = root.querySelector<HTMLTextAreaElement>('#knight-contact-form textarea[name="message"]');
    if (msgInput) {
      msgInput.placeholder = isVi ? 'Chia sẻ về vị trí hoặc dự án của bạn…' : 'Tell me about the role / project…';
    }
  }

  /**
   * Synchronizes canonical published PortfolioData into all Knight DOM sections
   * and triggers avatar / ASCII re-sampling if the stage is active.
   */
  function applyLiveKnightData(root: HTMLElement, rawOrLocalized: any, locale: 'en' | 'vi') {
    const rawData: PortfolioData = rawOrLocalized._raw || rawOrLocalized;
    const detail = rawOrLocalized._raw ? rawOrLocalized : localizePortfolioData(rawData, locale);

    updateKnightLabels(root, locale, detail?.identity?.name);

    const i = detail.identity;
    let avatarChanged = false;

    if (i) {
      const nextName = i.name || 'Nguyen Thanh Quan';
      const nameEl = root.querySelector<HTMLElement>('#kn-h-name');
      if (nameEl) {
        nameEl.textContent = nextName;
        const nameInfo = formatKnightAsciiTitle(normalizeAsciiName(nextName));
        nameEl.dataset.ld = nameInfo.desktopLines.join('\n');
        nameEl.dataset.lm = nameInfo.mobileLines.join('\n');
        nameEl.style.setProperty('--kd', nameInfo.kd);
        nameEl.style.setProperty('--ld', String(nameInfo.ld));
        nameEl.style.setProperty('--km', nameInfo.km);
        nameEl.style.setProperty('--lm', String(nameInfo.lm));
      }

      const navBrand = root.querySelector<HTMLElement>('.kn-nav-n');
      if (navBrand) {
        navBrand.textContent = nextName.toLowerCase().trim().replace(/\s+/g, '.');
        navBrand.setAttribute('aria-label', nextName);
      }

      const footerName = root.querySelector<HTMLElement>('[data-kn-footer-name="true"]');
      if (footerName) footerName.textContent = nextName;

      // Sync bio cleanly (render single paragraph once rather than duplicating)
      const paragraphs = String(i.bio || '')
        .split(/\n\n+/)
        .map((p: string) => p.trim())
        .filter(Boolean);
      const leadEl = root.querySelector<HTMLElement>('[data-kn-lead-bio="true"], .kn-lead');
      const extraEl = root.querySelector<HTMLElement>('[data-kn-extra-bio="true"], .kn-more-bio');
      if (leadEl) leadEl.textContent = paragraphs[0] || '';
      if (extraEl) {
        const rest = paragraphs.slice(1).join('\n\n');
        extraEl.textContent = rest;
        extraEl.classList.toggle('hidden', !rest);
      }

      const locEl = root.querySelector<HTMLElement>('.kn-facts [data-bind="location"]');
      if (locEl) locEl.textContent = i.location || '';

      const roleEl = root.querySelector<HTMLElement>('.kn-role');
      if (roleEl) roleEl.textContent = i.role || '';

      // Update About facts links
      const aboutGh = root.querySelector<HTMLAnchorElement>('[data-kn-about-github="true"]');
      if (aboutGh && i.github) {
        aboutGh.href = safeUrl(i.github.url);
        const h = (i.github.handle || '').replace(/^@/, '');
        aboutGh.textContent = h ? `@${h}` : i.github.url;
      }
      const aboutEmail = root.querySelector<HTMLAnchorElement>('[data-kn-about-email="true"]');
      if (aboutEmail) {
        aboutEmail.href = i.email ? `mailto:${i.email}` : '#';
        aboutEmail.textContent = i.email || '';
      }

      // Update Contact links and form action
      const contactGh = root.querySelector<HTMLAnchorElement>('[data-kn-contact-github="true"]');
      if (contactGh && i.github) contactGh.href = safeUrl(i.github.url);
      const contactLi = root.querySelector<HTMLAnchorElement>('[data-kn-contact-linkedin="true"]');
      if (contactLi && i.linkedin) contactLi.href = safeUrl(i.linkedin.url);
      const contactEm = root.querySelector<HTMLAnchorElement>('[data-kn-contact-email="true"]');
      if (contactEm) contactEm.href = i.email ? `mailto:${i.email}` : '#';
      const contactForm = root.querySelector<HTMLFormElement>('#knight-contact-form');
      if (contactForm) contactForm.action = i.email ? `mailto:${i.email}` : '';

      // Live update Canonical Avatar across DOM attribute + fallback image
      const resolvedAvatarUrl = resolveAvatarUrl(rawData);
      const nextIni = initials(nextName);
      const figEl = root.querySelector<HTMLElement>('[data-kn-fig="true"]');
      const figImg = root.querySelector<HTMLImageElement>('.kn-fig-img');
      const figFallback = root.querySelector<HTMLElement>('.kn-fig-fallback');
      const nextAvatarKey = `${resolvedAvatarUrl}::${nextIni}`;

      if (figEl) {
        figEl.dataset.av = resolvedAvatarUrl;
        figEl.dataset.ini = nextIni;
      }
      if (figFallback) {
        figFallback.textContent = nextIni;
      }
      if (figImg) {
        figImg.alt = nextName;
        if (resolvedAvatarUrl) {
          figImg.src = resolvedAvatarUrl;
        } else {
          figImg.removeAttribute('src');
        }
      }
      if (nextAvatarKey !== lastAppliedAvatarKey) {
        lastAppliedAvatarKey = nextAvatarKey;
        avatarChanged = true;
      }

      // Career Settings (Open to Work & CV action)
      const career = getCareerSettings(detail);
      const showCv = Boolean(career.openToWork) && Boolean(career.cvUrl);
      const cvItem = root.querySelector<HTMLElement>('[data-kn-cv-item]');
      const cvMob = root.querySelector<HTMLElement>('[data-kn-cv-mob]');
      if (cvItem) cvItem.classList.toggle('hidden', !showCv);
      if (cvMob) cvMob.classList.toggle('hidden', !showCv);
    }

    if (Array.isArray(detail.experience)) {
      const expListEl = root.querySelector<HTMLElement>('[data-kn-exp-list="true"]');
      if (expListEl) {
        expListEl.innerHTML = renderKnightExperience(detail.experience, locale);
      }
    }

    if (Array.isArray(detail.education)) {
      const eduListEl = root.querySelector<HTMLElement>('[data-kn-edu-list="true"]');
      if (eduListEl) {
        eduListEl.innerHTML = renderKnightEducation(detail.education || [], [], locale);
      }
    }

    if (Array.isArray(detail.certifications)) {
      const certListEl = root.querySelector<HTMLElement>('[data-kn-cert-list="true"]');
      if (certListEl) {
        certListEl.innerHTML = renderKnightCertifications(detail.certifications || [], locale);
      }
    }

    if (Array.isArray(detail.skills)) {
      const skillsFieldEl = root.querySelector<HTMLElement>('[data-kn-skills="true"]');
      if (skillsFieldEl) {
        skillsFieldEl.innerHTML = renderKnightSkills(detail.skills, locale);
      }
    }

    if (Array.isArray(detail.projects)) {
      const projectListEl = root.querySelector<HTMLElement>('[data-kn-pj-list="true"]');
      if (projectListEl) {
        const featured = getKnightProjects(detail);
        projectListEl.innerHTML = renderKnightProjects(featured, locale);
      }
      const moreSecEl = root.querySelector<HTMLElement>('[data-kn-more-sec="true"]');
      const moreListEl = root.querySelector<HTMLElement>('[data-kn-more-list="true"]');
      const more = getKnightMoreProjects(detail);
      if (moreSecEl && moreListEl) {
        moreListEl.innerHTML = renderKnightMoreWork(more);
        moreSecEl.classList.toggle('hidden', more.length === 0);
      }
    }

    const actWrap = root.querySelector<HTMLElement>('[data-kn-activity-wrap="true"]');
    if (actWrap) {
      const resolution = getKnightActivityResolution(detail, locale);
      actWrap.innerHTML = renderKnightActivity(resolution, locale);
    }

    if (stopStage) {
      root.dispatchEvent(new CustomEvent('knight:refresh', { detail: { forceAvatar: avatarChanged } }));
    }
  }

  async function initKnightTheme() {
    const root = document.querySelector<HTMLElement>('[data-kn-root="true"]');
    if (!root) return;

    const currentLoc = (document.documentElement.lang as 'en' | 'vi') || 'en';
    updateKnightLabels(root, currentLoc);

    if (isKnightActive && stopStage) {
      return;
    }
    isKnightActive = true;
    const myInitToken = ++knightInitToken;

    if (root.dataset.knStatus !== 'running' && root.dataset.knStatus !== 'fallback') {
      root.dataset.knStatus = 'loading';
      const loader = root.querySelector<HTMLElement>('#knight-loader');
      if (loader) loader.style.display = '';
    }

    if (safetyTimer) {
      clearTimeout(safetyTimer);
      safetyTimer = null;
    }
    if (transitionTimer) {
      clearTimeout(transitionTimer);
      transitionTimer = null;
    }
    if (teardown) {
      teardown();
      teardown = null;
    }
    if (stopStage) {
      stopStage();
      stopStage = null;
    }
    if (scrollController) {
      scrollController.destroy();
      scrollController = null;
    }

    // Safety timeout (2200ms) across network data readiness + asset decoding so visitor never hangs
    safetyTimer = setTimeout(() => {
      if (root.dataset.knStatus === 'loading' && knightInitToken === myInitToken) {
        console.warn('[Knight Theme] Render-ready safety timeout reached, revealing gracefully');
        revealKnight(root, 'timeout', false);
      }
    }, 2200);

    // Wait for canonical remote/local data resolution BEFORE downloading/rasterizing avatar
    // so Knight never downloads or converts build-time defaults while Supabase is resolving.
    if (!(window as any).__PORTFOLIO__ && (window as any).__PORTFOLIO_READY__) {
      await Promise.race([
        (window as any).__PORTFOLIO_READY__,
        new Promise((resolve) => setTimeout(resolve, 1400)),
      ]);
    }

    if (!isKnightActive || knightInitToken !== myInitToken || document.documentElement.dataset.portfolioTheme !== 'knight') {
      return;
    }

    // Sync any already-resolved canonical portfolio data before sampling the stage
    const livePortfolio = (window as any).__PORTFOLIO_LOCALIZED__ || (window as any).__PORTFOLIO__;
    if (livePortfolio) {
      const loc = (document.documentElement.lang as 'en' | 'vi') || 'en';
      applyLiveKnightData(root, livePortfolio, loc);
    }

    // Initialize inertial smooth scrolling controller (Lenis single-RAF)
    scrollController = initKnightScroll(root);

    // Initialize character scramble, magnetic buttons, crosshair cursor, nav spy, and tooltips
    const rawTeardown = setupKnightInteractions(root);
    teardown = () => {
      rawTeardown();
      if (scrollController) {
        scrollController.destroy();
        scrollController = null;
      }
    };

    try {
      stopStage = initKnightStage(root, {
        onReady() {
          if (knightInitToken === myInitToken) {
            revealKnight(root, 'stage', false);
          }
        },
        onError(err) {
          console.warn('[Knight Theme] ASCII stage reported error, falling back:', err);
          if (knightInitToken === myInitToken) {
            revealKnight(root, 'stage-error', true);
          }
        },
      });
      root.dataset.knStageStatus = 'initialized';
    } catch (err) {
      root.dataset.knStageStatus = 'error';
      console.error('[Knight Theme] Fatal error initializing ASCII stage:', err);
      revealKnight(root, 'fatal-init-error', true);
    }
  }

  // Register global data/locale listeners unconditionally so Knight never misses data
  // fetched before Knight is activated (e.g. from initial 'resolving' state or theme switches).
  window.addEventListener('portfolio:data', (e: Event) => {
    const root = document.querySelector<HTMLElement>('[data-kn-root="true"]');
    const detail = (e as CustomEvent).detail;
    if (!root || !detail) return;
    const locale: 'en' | 'vi' = detail._locale || (document.documentElement.lang as 'en' | 'vi') || 'en';
    applyLiveKnightData(root, detail, locale);
  });

  window.addEventListener('locale:changed', (e: Event) => {
    const root = document.querySelector<HTMLElement>('[data-kn-root="true"]');
    if (!root) return;
    const detail = (e as CustomEvent).detail;
    const loc: 'en' | 'vi' = detail?.locale || 'en';
    updateKnightLabels(root, loc);
    const liveData = (window as any).__PORTFOLIO_LOCALIZED__ || (window as any).__PORTFOLIO__ || portfolioData;
    const actWrap = root.querySelector<HTMLElement>('[data-kn-activity-wrap="true"]');
    if (actWrap && liveData) {
      const resolution = getKnightActivityResolution(liveData, loc);
      actWrap.innerHTML = renderKnightActivity(resolution, loc);
      if (stopStage) {
        root.dispatchEvent(new CustomEvent('knight:refresh', { detail: { forceAvatar: false } }));
      }
    }
  });

  function checkAndInitKnight() {
    if (document.documentElement.dataset.portfolioTheme === 'knight') {
      initKnightTheme();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkAndInitKnight);
  } else {
    checkAndInitKnight();
  }

  window.addEventListener('theme:changed', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    if (detail?.theme === 'knight') {
      if (!isKnightActive || !stopStage) {
        requestAnimationFrame(() => initKnightTheme());
      }
    } else {
      isKnightActive = false;
      knightInitToken++;
      if (safetyTimer) {
        clearTimeout(safetyTimer);
        safetyTimer = null;
      }
      if (transitionTimer) {
        clearTimeout(transitionTimer);
        transitionTimer = null;
      }
      if (teardown) {
        teardown();
        teardown = null;
      }
      if (stopStage) {
        stopStage();
        stopStage = null;
      }
      const root = document.querySelector<HTMLElement>('[data-kn-root="true"]');
      if (root) {
        root.dataset.knStatus = 'loading';
        const loader = root.querySelector<HTMLElement>('#knight-loader');
        if (loader) loader.style.display = '';
      }
    }
  });
</script>
