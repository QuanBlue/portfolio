---
import type { ExperienceItem } from '../../../data/portfolio';
import { renderKnightExperience } from '../../core/render-knight';

interface Props {
  experience?: ExperienceItem[];
}

const { experience = [] } = Astro.props;
---

<section
  class="kn-sec kn-exp"
  id="experience"
  data-kn-s="experience"
  aria-labelledby="kn-h-experience"
>
  <h2
    id="kn-h-experience"
    class="kn-asc"
    data-kn-t="rise"
    data-ld="EXPERIENCE"
    data-lm="EXPERIENCE"
    style="--kd:6.660;--ld:1;--km:6.660;--lm:1"
  >
    Experience
  </h2>

  <div
    class="kn-exp-wrap"
    data-kn-exp-list="true"
    set:html={renderKnightExperience(experience)}
  />
</section>
