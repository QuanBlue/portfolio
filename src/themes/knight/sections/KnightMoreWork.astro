---
import type { KnightMoreProjectItem } from '../../core/data-adapter';
import { renderKnightMoreWork } from '../../core/render-knight';

interface Props {
  moreProjects?: KnightMoreProjectItem[];
}

const { moreProjects = [] } = Astro.props;
---

<section
  class={`kn-sec kn-more ${moreProjects.length > 0 ? '' : 'hidden'}`}
  id="more-work"
  data-kn-s="work"
  data-kn-more-sec="true"
  aria-labelledby="kn-h-more"
>
  <h2
    id="kn-h-more"
    class="kn-asc"
    data-kn-t="ribbon"
    data-ld={"MORE\nPROJECTS"}
    data-lm={"MORE\nPROJECTS"}
    style="--kd:8.640;--ld:1;--km:5.340;--lm:2"
  >
    More projects
  </h2>

  <ol class="kn-list" data-kn-more-list="true" set:html={renderKnightMoreWork(moreProjects)} />
</section>
