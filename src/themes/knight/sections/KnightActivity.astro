---
import type { ActivityResolution } from '../../../lib/github-activity';
import { renderKnightActivity } from '../../core/render-knight';

interface Props {
  activity: ActivityResolution;
}

const { activity } = Astro.props;
---

<section class="kn-sec kn-act" id="activity" data-kn-s="activity" aria-labelledby="kn-h-act">
  <h2
    id="kn-h-act"
    class="kn-asc"
    data-kn-t="columns"
    data-ld="ACTIVITY"
    data-lm="ACTIVITY"
    style="--kd:5.340;--ld:1;--km:5.340;--lm:1"
  >
    Activity
  </h2>

  <div data-kn-activity-wrap="true" set:html={renderKnightActivity(activity, 'en')} />
</section>
