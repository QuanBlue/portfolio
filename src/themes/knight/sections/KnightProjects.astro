---
import type { KnightProjectItem } from '../../core/data-adapter';
import { renderKnightProjects } from '../../core/render-knight';

interface Props {
  projects: KnightProjectItem[];
}

const { projects = [] } = Astro.props;
---

<section class="kn-sec kn-pj" id="projects" data-kn-s="projects" aria-labelledby="kn-h-projects">
  <h2
    id="kn-h-projects"
    class="kn-asc"
    data-kn-t="diag"
    data-ld="PROJECTS"
    data-lm="PROJECTS"
    style="--kd:5.340;--ld:1;--km:5.340;--lm:1"
  >
    Projects
  </h2>

  <div class="kn-pj-list" data-kn-pj-list="true" set:html={renderKnightProjects(projects)} />
</section>
