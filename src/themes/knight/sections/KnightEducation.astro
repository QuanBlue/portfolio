---
import type { EducationItem } from '../../../data/portfolio';
import { renderKnightEducation } from '../../core/render-knight';

interface Props {
  education?: EducationItem[];
}

const { education = [] } = Astro.props;
---

<section
  class="kn-sec kn-edu"
  id="education"
  data-kn-s="education"
  aria-labelledby="kn-h-education"
>
  <h2
    id="kn-h-education"
    class="kn-asc"
    data-kn-t="rise"
    data-ld="EDUCATION"
    data-lm="EDUCATION"
    style="--kd:6.000;--ld:1;--km:6.000;--lm:1"
  >
    Education
  </h2>

  <div
    class="kn-edu-wrap"
    data-kn-edu-list="true"
    set:html={renderKnightEducation(education)}
  />
</section>
